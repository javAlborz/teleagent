[Unit]
Description=Teleagent OpenAI Realtime native-SIP canary controller
Documentation=file:/opt/teleagent/realtime-sip-gateway/README.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=5min
StartLimitBurst=3
ConditionPathExists=/etc/teleagent/realtime-sip-gateway.enabled
ConditionPathExists=/etc/teleagent/realtime-sip-gateway.env
ConditionPathExists=/etc/teleagent/credentials/openai-api-key
ConditionPathExists=/etc/teleagent/credentials/openai-webhook-secret
ConditionPathExists=/etc/teleagent/credentials/sip-pbx-auth-secret
ConditionPathExists=/opt/teleagent/realtime-sip-gateway/src/index.js
ConditionFileIsExecutable=/usr/local/libexec/teleagent-node

[Service]
Type=simple
User=teleagent-sip-gateway
Group=teleagent-sip-gateway
SupplementaryGroups=
WorkingDirectory=/opt/teleagent/realtime-sip-gateway
Environment=NODE_ENV=production
EnvironmentFile=/etc/teleagent/realtime-sip-gateway.env
LoadCredential=OPENAI_API_KEY:/etc/teleagent/credentials/openai-api-key
LoadCredential=OPENAI_WEBHOOK_SECRET:/etc/teleagent/credentials/openai-webhook-secret
LoadCredential=SIP_PBX_AUTH_SECRET:/etc/teleagent/credentials/sip-pbx-auth-secret
ExecStart=/usr/local/libexec/teleagent-node /opt/teleagent/realtime-sip-gateway/src/index.js
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=20s
KillMode=control-group
OOMPolicy=stop

StateDirectory=teleagent-sip-gateway
StateDirectoryMode=0700
UMask=0077
LimitNOFILE=1024
LimitCORE=0
MemoryHigh=384M
MemoryMax=512M
MemorySwapMax=128M
CPUQuota=100%
TasksMax=128
NoNewPrivileges=true
PrivateDevices=true
PrivateMounts=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
ReadWritePaths=/var/lib/teleagent-sip-gateway
RemoveIPC=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
KeyringMode=private
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
