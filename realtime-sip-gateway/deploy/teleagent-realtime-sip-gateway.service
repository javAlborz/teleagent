[Unit]
Description=Teleagent OpenAI Realtime native-SIP dormant canary
Documentation=file:/opt/teleagent/current/realtime-sip-gateway/README.md
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/teleagent-sip-gateway
StartLimitIntervalSec=5min
StartLimitBurst=3
ConditionPathExists=/etc/teleagent/realtime-sip-gateway/ENABLE
ConditionPathExists=/etc/teleagent/realtime-sip-gateway/config.env
ConditionPathExists=/etc/teleagent/realtime-sip-gateway/STATE_INITIALIZED
ConditionPathExists=/etc/teleagent/credentials/openai-api-key
ConditionPathExists=/etc/teleagent/credentials/openai-webhook-secret
ConditionPathExists=/etc/teleagent/credentials/sip-pbx-auth-secret
ConditionPathIsMountPoint=/var/lib/teleagent-sip-gateway

[Service]
Type=simple
User=teleagent-sip-gateway
Group=teleagent-sip-gateway
SupplementaryGroups=
WorkingDirectory=/
Environment=NODE_ENV=production
Environment=HOME=/var/lib/teleagent-sip-gateway
Environment=TELEAGENT_SIP_STATE_BOUNDARY=required
Environment=SIP_STATE_DATABASE=/var/lib/teleagent-sip-gateway/gateway-state.sqlite3
Environment=SIP_STATE_MARKER_FILE=%d/SIP_STATE_INITIALIZED
EnvironmentFile=/etc/teleagent/realtime-sip-gateway/config.env
LoadCredential=OPENAI_API_KEY:/etc/teleagent/credentials/openai-api-key
LoadCredential=OPENAI_WEBHOOK_SECRET:/etc/teleagent/credentials/openai-webhook-secret
LoadCredential=SIP_PBX_AUTH_SECRET:/etc/teleagent/credentials/sip-pbx-auth-secret
LoadCredential=SIP_STATE_INITIALIZED:/etc/teleagent/realtime-sip-gateway/STATE_INITIALIZED
LoadCredential=teleagent-release-gate:/run/teleagent-release-gate/verified.json
UnsetEnvironment=ENV BASH_ENV CDPATH LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT GCONV_PATH NODE_OPTIONS NODE_PATH NODE_EXTRA_CA_CERTS NODE_TLS_REJECT_UNAUTHORIZED NODE_USE_ENV_PROXY PYTHONPATH PERL5LIB RUBYOPT SSLKEYLOGFILE SSL_CERT_FILE SSL_CERT_DIR HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY http_proxy https_proxy all_proxy no_proxy OPENAI_API_KEY OPENAI_WEBHOOK_SECRET SIP_PBX_AUTH_SECRET OPENAI_API_KEY_FILE OPENAI_WEBHOOK_SECRET_FILE SIP_PBX_AUTH_SECRET_FILE
ExecStartPre=+/usr/bin/env -i HOME=/var/empty PATH=/usr/sbin:/usr/bin:/sbin:/bin LANG=C.UTF-8 LC_ALL=C.UTF-8 /usr/local/libexec/verify-teleagent-release-closure --check-start-gate
ExecStartPre=+/usr/bin/python3 -I /usr/local/libexec/verify-teleagent-release-closure --preflight-component realtime-sip-gateway ${CREDENTIALS_DIRECTORY}/teleagent-release-gate
ExecStart=!/usr/bin/python3 -I /usr/local/libexec/verify-teleagent-release-closure --supervise-component realtime-sip-gateway ${CREDENTIALS_DIRECTORY}/teleagent-release-gate
Restart=on-failure
RestartPreventExitStatus=77 78
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=20s
KillMode=control-group
OOMPolicy=stop

UMask=0077
LimitCORE=0
LimitFSIZE=4294967296
LimitNOFILE=1024
MemoryAccounting=true
MemoryHigh=384M
MemoryMax=512M
MemorySwapMax=0
CPUAccounting=true
CPUQuota=100%
IOAccounting=true
IOWeight=50
TasksAccounting=true
TasksMax=128
NoNewPrivileges=true
PrivateDevices=true
PrivateMounts=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=all
ReadOnlyPaths=/opt/teleagent/releases /usr/local/libexec
ReadWritePaths=/var/lib/teleagent-sip-gateway
InaccessiblePaths=/var/lib/teleagent-provider-plane
InaccessiblePaths=/var/lib/teleagent-worker-state
InaccessiblePaths=/var/lib/teleagent-control
InaccessiblePaths=/var/lib/teleagent-privileged-action
InaccessiblePaths=/var/lib/teleagent-claude-supervisor
InaccessiblePaths=/var/lib/teleagent-codex-supervisor
InaccessiblePaths=/var/lib/teleagent-voice
InaccessiblePaths=/var/lib/teleagent-voice-stack
InaccessiblePaths=/srv/teleagent-agent-workspaces
InaccessiblePaths=/run/teleagent-worker-session
InaccessiblePaths=/run/teleagent-provider-launch
InaccessiblePaths=/run/teleagent-provider-egress
InaccessiblePaths=/run/teleagent-provider-egress-control
InaccessiblePaths=/run/teleagent-provider-capabilities
InaccessiblePaths=/run/teleagent-privileged-action
InaccessiblePaths=/run/teleagent-voice-stack
InaccessiblePaths=/run/teleagent-isolated-voice-stack
InaccessiblePaths=/run/teleagent-sip-local-peer-fence
InaccessiblePaths=/etc/teleagent/worker-session
InaccessiblePaths=/etc/teleagent/provider-egress
InaccessiblePaths=/etc/teleagent/provider-egress-secrets
InaccessiblePaths=/etc/teleagent/provider-runtime
InaccessiblePaths=/etc/teleagent/privileged-action
InaccessiblePaths=/etc/teleagent/controller
InaccessiblePaths=/etc/teleagent-voice
RemoveIPC=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
KeyringMode=private
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_SETPCAP CAP_KILL
AmbientCapabilities=
SystemCallArchitectures=native
