#!/bin/bash
set -euo pipefail

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
unset ENV BASH_ENV CDPATH LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT GCONV_PATH \
  NODE_OPTIONS NODE_PATH NODE_EXTRA_CA_CERTS NODE_TLS_REJECT_UNAUTHORIZED \
  NODE_USE_ENV_PROXY PYTHONPATH PERL5LIB RUBYOPT SSLKEYLOGFILE SSL_CERT_FILE \
  SSL_CERT_DIR HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY http_proxy https_proxy \
  all_proxy no_proxy OPENAI_API_KEY OPENAI_WEBHOOK_SECRET SIP_PBX_AUTH_SECRET \
  OPENAI_API_KEY_FILE OPENAI_WEBHOOK_SECRET_FILE SIP_PBX_AUTH_SECRET_FILE
umask 077

name=teleagent-realtime-sip-gateway-install
unit=teleagent-realtime-sip-gateway.service
sentinel=/etc/teleagent/realtime-sip-gateway/ENABLE
systemctl_bin=/usr/bin/systemctl
sysusers_bin=/usr/bin/systemd-sysusers
tmpfiles_bin=/usr/bin/systemd-tmpfiles
identity_bin=/usr/local/libexec/verify-realtime-sip-gateway
node_bin=/usr/local/libexec/teleagent-node
root_prefix=
expected_uid=0
expected_gid=0
test_lane=0
release_node=
release_start_gate='ExecStartPre=+/usr/bin/env -i HOME=/var/empty PATH=/usr/sbin:/usr/bin:/sbin:/bin LANG=C.UTF-8 LC_ALL=C.UTF-8 /usr/local/libexec/verify-teleagent-release-closure --check-start-gate'

fail() {
  local message=$1
  local status=${2:-77}
  printf 'Realtime SIP gateway installation refused: %s\n' "$message" >&2
  exit "$status"
}

validate_test_dependency() {
  local filename=$1
  [ -f "$filename" ] && [ ! -L "$filename" ] ||
    fail 'a test dependency is not a regular file'
  [ "$(/usr/bin/stat -c '%u:%g:%a:%h' "$filename")" = \
    "${expected_uid}:${expected_gid}:700:1" ] ||
    fail 'a test dependency has unsafe metadata'
  case "$(/usr/bin/readlink -f -- "$filename")" in
    "$root_prefix"/*) ;;
    *) fail 'a test dependency escaped the isolated fixture' ;;
  esac
}

configure_environment() {
  if [ "${TELEAGENT_SIP_GATEWAY_INSTALL_TEST_ONLY:-}" = 1 ]; then
    test_lane=1
    [ -n "${TELEAGENT_SIP_GATEWAY_INSTALL_TEST_ROOT:-}" ] ||
      fail 'the isolated test root is required'
    root_prefix=$(/usr/bin/readlink -f -- \
      "$TELEAGENT_SIP_GATEWAY_INSTALL_TEST_ROOT")
    case "$root_prefix" in
      /tmp/teleagent-sip-gateway-install-test-*) ;;
      *) fail 'the isolated test root is outside the allowed namespace' ;;
    esac
    expected_uid=$(/usr/bin/id -u)
    expected_gid=$(/usr/bin/id -g)
    [ -d "$root_prefix" ] && [ ! -L "$root_prefix" ] ||
      fail 'the isolated test root is unsafe'
    [ "$(/usr/bin/stat -c '%u:%g:%a' "$root_prefix")" = \
      "${expected_uid}:${expected_gid}:700" ] ||
      fail 'the isolated test root has unsafe metadata'
    systemctl_bin=${TELEAGENT_SIP_GATEWAY_INSTALL_TEST_SYSTEMCTL:-}
    sysusers_bin=${TELEAGENT_SIP_GATEWAY_INSTALL_TEST_SYSUSERS:-}
    tmpfiles_bin=${TELEAGENT_SIP_GATEWAY_INSTALL_TEST_TMPFILES:-}
    identity_bin=${TELEAGENT_SIP_GATEWAY_INSTALL_TEST_IDENTITY:-}
    node_bin=${TELEAGENT_SIP_GATEWAY_INSTALL_TEST_NODE:-}
    for dependency in \
      "$systemctl_bin" "$sysusers_bin" "$tmpfiles_bin" "$identity_bin" "$node_bin"; do
      validate_test_dependency "$dependency"
    done
    return
  fi

  for forbidden in \
    "${TELEAGENT_SIP_GATEWAY_INSTALL_TEST_ROOT:-}" \
    "${TELEAGENT_SIP_GATEWAY_INSTALL_TEST_SYSTEMCTL:-}" \
    "${TELEAGENT_SIP_GATEWAY_INSTALL_TEST_SYSUSERS:-}" \
    "${TELEAGENT_SIP_GATEWAY_INSTALL_TEST_TMPFILES:-}" \
    "${TELEAGENT_SIP_GATEWAY_INSTALL_TEST_IDENTITY:-}" \
    "${TELEAGENT_SIP_GATEWAY_INSTALL_TEST_NODE:-}"; do
    [ -z "$forbidden" ] || fail 'test dependency overrides require the isolated test lane'
  done
}

host_path() {
  printf '%s%s\n' "$root_prefix" "$1"
}

configure_environment
self=$(/usr/bin/readlink -f -- "$0")
installed_entrypoint=$(host_path /usr/local/libexec/teleagent-realtime-sip-gateway-install)
if [ "$self" = "$installed_entrypoint" ]; then
  source_root=$(/usr/bin/readlink -f -- \
    "$(host_path /opt/teleagent/current/realtime-sip-gateway/deploy)")
else
  [ "$(/usr/bin/basename -- "$self")" = "$name" ] ||
    fail 'the installer entrypoint is unreviewed'
  source_root=$(/usr/bin/dirname -- "$self")
fi
app_root=$(/usr/bin/readlink -f -- "$source_root/..")
[ "$source_root" = "$app_root/deploy" ] ||
  fail 'the SIP gateway source bundle is outside its application root'
if [ "${1:-}" = --source-check ]; then
  release_root=$(/usr/bin/readlink -f -- "$app_root/..")
  [ "$app_root" = "$release_root/realtime-sip-gateway" ] ||
    fail 'the SIP gateway source bundle is outside the authenticated release root'
  release_node="$release_root/runtime/node/bin/node"
  node_bin=$release_node
fi

declare -a sources=(
  deploy/teleagent-realtime-sip-gateway.service
  deploy/teleagent-realtime-sip-gateway.sysusers
  deploy/teleagent-realtime-sip-gateway.tmpfiles
  deploy/verify-realtime-sip-gateway
  deploy/realtime-sip-gateway-install.manifest
  deploy/teleagent-realtime-sip-gateway-install
)
declare -a targets=(
  /etc/systemd/system/teleagent-realtime-sip-gateway.service
  /etc/sysusers.d/teleagent-realtime-sip-gateway.conf
  /etc/tmpfiles.d/teleagent-realtime-sip-gateway.conf
  /usr/local/libexec/verify-realtime-sip-gateway
  /etc/teleagent/realtime-sip-gateway/install.manifest
  /usr/local/libexec/teleagent-realtime-sip-gateway-install
)
declare -a source_modes=(0644 0644 0644 0755 0444 0755)
declare -a target_modes=(0644 0644 0644 0755 0444 0755)

inspect_directory() {
  local directory=$1
  local metadata mode
  [ -d "$directory" ] && [ ! -L "$directory" ] ||
    fail 'a trusted directory is absent or unsafe'
  metadata=$(/usr/bin/stat -c '%u:%g:%a' "$directory")
  case "$metadata" in
    "${expected_uid}:${expected_gid}:"*) ;;
    *) fail 'a trusted directory has the wrong owner' ;;
  esac
  mode=${metadata##*:}
  [ $((8#$mode & 0022)) -eq 0 ] ||
    fail 'a trusted directory is group- or world-writable'
  [ "$(/usr/bin/readlink -f -- "$directory")" = "$directory" ] ||
    fail 'a trusted directory resolves through a link'
}

assert_source_file() {
  local filename=$1
  local mode=$2
  local actual
  [ -f "$filename" ] && [ ! -L "$filename" ] ||
    fail 'a reviewed source asset is absent or unsafe'
  actual=$(/usr/bin/stat -c '%u:%g:%a:%h' "$filename")
  case "$mode:$actual" in
    0755:"${expected_uid}:${expected_gid}:555:1"|\
    0755:"${expected_uid}:${expected_gid}:755:1"|\
    0644:"${expected_uid}:${expected_gid}:444:1"|\
    0644:"${expected_uid}:${expected_gid}:644:1"|\
    0444:"${expected_uid}:${expected_gid}:444:1"|\
    0444:"${expected_uid}:${expected_gid}:644:1") ;;
    *) fail 'a reviewed source asset has unsafe metadata' ;;
  esac
}

assert_unique_assets() {
  local source_list target_list
  source_list=$(printf '%s\n' "${sources[@]}" | LC_ALL=C /usr/bin/sort)
  target_list=$(printf '%s\n' "${targets[@]}" | LC_ALL=C /usr/bin/sort)
  [ "$(printf '%s\n' "$source_list" | /usr/bin/uniq -d)" = '' ] ||
    fail 'the install closure contains a duplicate source'
  [ "$(printf '%s\n' "$target_list" | /usr/bin/uniq -d)" = '' ] ||
    fail 'the install closure contains a duplicate target'
}

validate_manifest() {
  local manifest="$source_root/realtime-sip-gateway-install.manifest"
  local digest relative target mode extra records=
  while IFS=' ' read -r digest relative target mode extra; do
    [ -n "$digest" ] || continue
    [ -z "${extra:-}" ] && [ "${#digest}" -eq 64 ] ||
      fail 'the install manifest has a malformed record'
    case "$digest" in *[!0-9a-f]*) fail 'an install manifest digest is invalid' ;; esac
    case "$relative:$target:$mode" in
      deploy/teleagent-realtime-sip-gateway.service:/etc/systemd/system/teleagent-realtime-sip-gateway.service:0644|\
      deploy/teleagent-realtime-sip-gateway.sysusers:/etc/sysusers.d/teleagent-realtime-sip-gateway.conf:0644|\
      deploy/teleagent-realtime-sip-gateway.tmpfiles:/etc/tmpfiles.d/teleagent-realtime-sip-gateway.conf:0644|\
      deploy/verify-realtime-sip-gateway:/usr/local/libexec/verify-realtime-sip-gateway:0755|\
      deploy/teleagent-realtime-sip-gateway-install:/usr/local/libexec/teleagent-realtime-sip-gateway-install:0755) ;;
      *) fail 'the install manifest contains an unreviewed asset' ;;
    esac
    [ "$(/usr/bin/sha256sum "$app_root/$relative" | /usr/bin/awk '{print $1}')" = "$digest" ] ||
      fail 'an install manifest digest does not match its source'
    records="${records}${relative}:${target}:${mode}\n"
  done < "$manifest"
  local expected
  expected='deploy/teleagent-realtime-sip-gateway.service:/etc/systemd/system/teleagent-realtime-sip-gateway.service:0644
deploy/teleagent-realtime-sip-gateway.sysusers:/etc/sysusers.d/teleagent-realtime-sip-gateway.conf:0644
deploy/teleagent-realtime-sip-gateway.tmpfiles:/etc/tmpfiles.d/teleagent-realtime-sip-gateway.conf:0644
deploy/verify-realtime-sip-gateway:/usr/local/libexec/verify-realtime-sip-gateway:0755
deploy/teleagent-realtime-sip-gateway-install:/usr/local/libexec/teleagent-realtime-sip-gateway-install:0755'
  [ "$(printf '%b' "$records" | /usr/bin/sed '/^$/d' | LC_ALL=C /usr/bin/sort)" = \
    "$(printf '%s\n' "$expected" | LC_ALL=C /usr/bin/sort)" ] ||
    fail 'the install manifest closure is incomplete'
}

source_check() {
  inspect_directory "$app_root"
  inspect_directory "$source_root"
  if [ -n "$release_node" ]; then
    inspect_directory "$release_root"
    inspect_directory "$release_root/runtime"
    inspect_directory "$release_root/runtime/node"
    inspect_directory "$release_root/runtime/node/bin"
    assert_source_file "$release_node" 0755
  fi
  assert_unique_assets
  local index filename
  for ((index = 0; index < ${#sources[@]}; index += 1)); do
    filename="$app_root/${sources[$index]}"
    case "${sources[$index]}:${targets[$index]}" in *..*)
      fail 'the install closure contains path traversal' ;;
    esac
    case "${targets[$index]}" in
      /etc/systemd/system/teleagent-realtime-sip-gateway.service|\
      /etc/sysusers.d/teleagent-realtime-sip-gateway.conf|\
      /etc/tmpfiles.d/teleagent-realtime-sip-gateway.conf|\
      /etc/teleagent/realtime-sip-gateway/install.manifest|\
      /usr/local/libexec/verify-realtime-sip-gateway|\
      /usr/local/libexec/teleagent-realtime-sip-gateway-install) ;;
      *) fail 'the install closure contains an unapproved target' ;;
    esac
    [ "${targets[$index]}" != "$sentinel" ] ||
      fail 'the activation sentinel entered the install closure'
    assert_source_file "$filename" "${source_modes[$index]}"
  done
  validate_manifest
  [ -x "$node_bin" ] && [ -f "$node_bin" ] && [ ! -L "$node_bin" ] ||
    fail 'the fixed Node runtime is unavailable or unsafe'

  local service="$source_root/teleagent-realtime-sip-gateway.service"
  [ "$(/usr/bin/grep -Fxc \
    'ConditionPathExists=/etc/teleagent/realtime-sip-gateway/ENABLE' "$service" || true)" -eq 1 ] ||
    fail 'the unit lost its exact activation sentinel gate'
  [ "$(/usr/bin/grep -Fxc \
    'ConditionPathIsMountPoint=/var/lib/teleagent-sip-gateway' "$service" || true)" -eq 1 ] ||
    fail 'the unit lost its exact mount-point gate'
  [ "$(/usr/bin/grep -Fxc \
    'RequiresMountsFor=/var/lib/teleagent-sip-gateway' "$service" || true)" -eq 1 ] ||
    fail 'the unit lost its durable mount dependency'
  ! /usr/bin/grep -Eq '^\[Install\][[:space:]]*$' "$service" ||
    fail 'the dormant SIP gateway unit became enableable'
  for required in \
    'MemoryMax=512M' 'MemorySwapMax=0' 'CPUQuota=100%' 'TasksMax=128' \
    'LimitFSIZE=4294967296' 'Environment=TELEAGENT_SIP_STATE_BOUNDARY=required' \
    'Environment=SIP_STATE_DATABASE=/var/lib/teleagent-sip-gateway/gateway-state.sqlite3' \
    'Environment=SIP_STATE_MARKER_FILE=%d/SIP_STATE_INITIALIZED' \
    'LoadCredential=SIP_STATE_INITIALIZED:/etc/teleagent/realtime-sip-gateway/STATE_INITIALIZED' \
    "$release_start_gate" \
    'ExecStartPre=+/usr/local/libexec/verify-realtime-sip-gateway --activation-check'; do
    [ "$(/usr/bin/grep -Fxc "$required" "$service" || true)" -eq 1 ] ||
      fail 'the unit resource or storage contract drifted'
  done
  [ "$(/usr/bin/grep -Fc \
    '/usr/local/libexec/verify-teleagent-release-closure' "$service" || true)" -eq 1 ] ||
    fail 'the trusted release start gate was duplicated or weakened'
  ! /usr/bin/grep -Eq '^ExecCondition=|^ExecReload=' "$service" ||
    fail 'the unit added an execution path that bypasses the trusted start gate'
  [ "$(/usr/bin/grep -nE '^ExecStart(Pre)?=' "$service" |
      /usr/bin/sed -n '1s/:.*//p')" = \
    "$(/usr/bin/grep -nFx "$release_start_gate" "$service" |
      /usr/bin/cut -d: -f1)" ] ||
    fail 'the trusted release start gate is not the first start command'
  for inaccessible in \
    /var/lib/teleagent-provider-plane \
    /var/lib/teleagent-worker-state \
    /var/lib/teleagent-control \
    /var/lib/teleagent-privileged-action \
    /var/lib/teleagent-claude-supervisor \
    /var/lib/teleagent-codex-supervisor \
    /var/lib/teleagent-voice \
    /var/lib/teleagent-voice-stack \
    /srv/teleagent-agent-workspaces \
    /run/teleagent-worker-session \
    /run/teleagent-provider-launch \
    /run/teleagent-provider-egress \
    /run/teleagent-provider-egress-control \
    /run/teleagent-provider-capabilities \
    /run/teleagent-privileged-action \
    /run/teleagent-voice-stack \
    /run/teleagent-sip-local-peer-fence \
    /etc/teleagent/worker-session \
    /etc/teleagent/provider-egress \
    /etc/teleagent/provider-egress-secrets \
    /etc/teleagent/provider-runtime \
    /etc/teleagent/privileged-action \
    /etc/teleagent/controller \
    /etc/teleagent-voice; do
    [ "$(/usr/bin/grep -Fxc "InaccessiblePaths=$inaccessible" "$service" || true)" -eq 1 ] ||
      fail 'the public-edge inaccessible-path boundary drifted'
  done
  local sysusers_lines tmpfiles_lines
  sysusers_lines=$(/usr/bin/sed -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' \
    "$source_root/teleagent-realtime-sip-gateway.sysusers")
  [ "$sysusers_lines" = \
    'u teleagent-sip-gateway - "Teleagent native SIP public-edge canary" /var/lib/teleagent-sip-gateway /usr/sbin/nologin' ] ||
    fail 'the sysusers identity contract drifted'
  tmpfiles_lines=$(/usr/bin/sed -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' \
    "$source_root/teleagent-realtime-sip-gateway.tmpfiles")
  [ "$tmpfiles_lines" = 'd /etc/teleagent/realtime-sip-gateway 0700 root root - -
d /var/lib/teleagent-sip-gateway 0700 teleagent-sip-gateway teleagent-sip-gateway - -' ] ||
    fail 'the tmpfiles contract drifted'
  ! /usr/bin/grep -Eq '(ENABLE|config\.env|credentials)' \
    "$source_root/teleagent-realtime-sip-gateway.tmpfiles" ||
    fail 'tmpfiles must never create activation, configuration, or credentials'
  local source_attestation
  source_attestation=$("$node_bin" \
    "$source_root/verify-realtime-sip-gateway" --source-check 2>&1) ||
    fail 'the release Node runtime rejected the SIP gateway policy source'
  [ "$source_attestation" = SIP_GATEWAY_IDENTITY_SOURCE_OK ] ||
    fail 'the release Node runtime returned an invalid SIP gateway attestation'
}

assert_sentinel_absent() {
  local installed_sentinel
  installed_sentinel=$(host_path "$sentinel")
  if [ -e "$installed_sentinel" ] || [ -L "$installed_sentinel" ]; then
    fail 'the activation sentinel must remain absent'
  fi
}

assert_dormant() {
  local phase=${1:-installed}
  local target load_state active_state sub_state unit_file_state status
  target=$(host_path /etc/systemd/system/teleagent-realtime-sip-gateway.service)
  assert_sentinel_absent
  load_state=$("$systemctl_bin" show "$unit" --property=LoadState --value) ||
    fail 'the SIP gateway load state is unavailable' 75
  active_state=$("$systemctl_bin" show "$unit" --property=ActiveState --value) ||
    fail 'the SIP gateway active state is unavailable' 75
  sub_state=$("$systemctl_bin" show "$unit" --property=SubState --value) ||
    fail 'the SIP gateway substate is unavailable' 75
  [ "$active_state" = inactive ] && [ "$sub_state" = dead ] ||
    fail 'the SIP gateway is active, failed, or transitional' 75
  case "$load_state:$phase" in
    loaded:pre|loaded:installed)
      unit_file_state=$("$systemctl_bin" show "$unit" --property=UnitFileState --value) ||
        fail 'the SIP gateway unit-file state is unavailable' 75
      [ "$unit_file_state" = static ] ||
        fail 'the dormant SIP gateway is not exactly static' 75
      ;;
    not-found:pre)
      [ ! -e "$target" ] && [ ! -L "$target" ] ||
        fail 'a missing SIP gateway unit conflicts with an installed unit file' 75
      if "$systemctl_bin" is-enabled "$unit" >/dev/null 2>&1; then
        fail 'the missing SIP gateway unit unexpectedly has enablement state' 75
      else
        status=$?
      fi
      [ "$status" -eq 4 ] ||
        fail 'the missing SIP gateway unit cannot be proved absent' 75
      ;;
    *) fail 'the SIP gateway unit state is unavailable or unsafe' 75 ;;
  esac
  assert_sentinel_absent
}

require_install_authority() {
  [ -n "$root_prefix" ] && return
  [ "$(/usr/bin/id -u)" -eq 0 ] || fail 'root is required'
}

ensure_directory() {
  local absolute=$1
  local mode=$2
  local directory
  directory=$(host_path "$absolute")
  if [ ! -e "$directory" ] && [ ! -L "$directory" ]; then
    /usr/bin/install -d -o "$expected_uid" -g "$expected_gid" -m "$mode" -- "$directory"
  fi
  inspect_directory "$directory"
  [ "$(/usr/bin/stat -c '%u:%g:%a' "$directory")" = \
    "${expected_uid}:${expected_gid}:${mode#0}" ] ||
    fail 'a trusted install directory has unexpected metadata'
}

prepare_target_directories() {
  ensure_directory /etc 0755
  ensure_directory /etc/systemd 0755
  ensure_directory /etc/systemd/system 0755
  ensure_directory /etc/sysusers.d 0755
  ensure_directory /etc/tmpfiles.d 0755
  ensure_directory /etc/teleagent 0755
  ensure_directory /etc/teleagent/realtime-sip-gateway 0700
  ensure_directory /usr 0755
  ensure_directory /usr/local 0755
  ensure_directory /usr/local/libexec 0755
  ensure_directory /run 0755
}

assert_target_file() {
  local filename=$1
  local mode=$2
  [ -f "$filename" ] && [ ! -L "$filename" ] ||
    fail 'an installed SIP gateway asset is absent or unsafe'
  [ "$(/usr/bin/stat -c '%u:%g:%a:%h' "$filename")" = \
    "${expected_uid}:${expected_gid}:${mode#0}:1" ] ||
    fail 'an installed SIP gateway asset has unsafe metadata'
}

check_installed_assets() {
  local index source target
  for ((index = 0; index < ${#sources[@]}; index += 1)); do
    source="$app_root/${sources[$index]}"
    target=$(host_path "${targets[$index]}")
    assert_target_file "$target" "${target_modes[$index]}"
    /usr/bin/cmp -s -- "$source" "$target" ||
      fail 'an installed SIP gateway asset differs from reviewed source'
  done
}

install_disabled() {
  require_install_authority
  source_check
  assert_dormant pre
  prepare_target_directories

  local staging
  staging=$(/usr/bin/mktemp -d "$(host_path /run)/teleagent-sip-gateway-install.XXXXXX")
  /usr/bin/chmod 0700 "$staging"
  local committed=0 complete=0 index target temporary
  rollback() {
    local status=$?
    trap - EXIT INT TERM
    for ((index = 0; index < ${#targets[@]}; index += 1)); do
      target=$(host_path "${targets[$index]}")
      /usr/bin/rm -f -- "${target}.new-$$"
    done
    if [ "$complete" -ne 1 ] && [ "$committed" -eq 1 ]; then
      for ((index = ${#targets[@]} - 1; index >= 0; index -= 1)); do
        target=$(host_path "${targets[$index]}")
        if [ -f "$staging/backup-$index" ]; then
          /usr/bin/install -o "$expected_uid" -g "$expected_gid" \
            -m "${target_modes[$index]}" -- "$staging/backup-$index" "$target"
        else
          /usr/bin/rm -f -- "$target"
        fi
      done
      "$systemctl_bin" daemon-reload >/dev/null 2>&1 || true
    fi
    /usr/bin/rm -rf -- "$staging"
    exit "$status"
  }
  trap rollback EXIT INT TERM

  for ((index = 0; index < ${#sources[@]}; index += 1)); do
    target=$(host_path "${targets[$index]}")
    temporary="${target}.new-$$"
    [ ! -e "$temporary" ] && [ ! -L "$temporary" ] ||
      fail 'an installation staging path already exists'
    if [ -e "$target" ] || [ -L "$target" ]; then
      assert_target_file "$target" "${target_modes[$index]}"
      /usr/bin/cp --preserve=mode,ownership,timestamps -- "$target" "$staging/backup-$index"
    fi
    /usr/bin/install -o "$expected_uid" -g "$expected_gid" \
      -m "${target_modes[$index]}" -- "$app_root/${sources[$index]}" "$temporary"
    /usr/bin/sync -- "$temporary"
  done

  committed=1
  for ((index = 0; index < ${#targets[@]}; index += 1)); do
    target=$(host_path "${targets[$index]}")
    /usr/bin/mv -f -- "${target}.new-$$" "$target"
    /usr/bin/sync -- "$(/usr/bin/dirname -- "$target")"
  done

  "$sysusers_bin" "$(host_path /etc/sysusers.d/teleagent-realtime-sip-gateway.conf)" >/dev/null
  "$tmpfiles_bin" --create \
    "$(host_path /etc/tmpfiles.d/teleagent-realtime-sip-gateway.conf)" >/dev/null
  "$systemctl_bin" daemon-reload >/dev/null
  "$identity_bin" --initialize-empty-state |
    /usr/bin/grep -qx SIP_GATEWAY_STATE_INITIALIZED_OK ||
    fail 'the empty durable-state mount could not be initialized or preserved'
  "$identity_bin" --installed-check | /usr/bin/grep -qx SIP_GATEWAY_IDENTITY_OK ||
    fail 'the installed public-edge identity or storage boundary failed verification'
  assert_dormant installed
  check_installed_assets
  complete=1
  /usr/bin/rm -rf -- "$staging"
  trap - EXIT INT TERM
}

check_installed() {
  require_install_authority
  source_check
  assert_dormant installed
  check_installed_assets
  "$identity_bin" --installed-check | /usr/bin/grep -qx SIP_GATEWAY_IDENTITY_OK ||
    fail 'the installed public-edge identity or storage boundary failed verification'
}

case "${1:-}" in
  --source-check)
    [ "$#" -eq 1 ] || fail 'unexpected arguments'
    source_check
    printf 'SIP_GATEWAY_SOURCE_OK\n'
    ;;
  --install-disabled)
    [ "$#" -eq 1 ] || fail 'unexpected arguments'
    install_disabled
    printf 'SIP_GATEWAY_INSTALLED_DISABLED\n'
    ;;
  --check)
    [ "$#" -eq 1 ] || fail 'unexpected arguments'
    check_installed
    printf 'SIP_GATEWAY_INSTALLED_DISABLED_OK\n'
    ;;
  *)
