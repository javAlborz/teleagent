# The server binds to loopback. Terminate public HTTPS in a reviewed reverse
# proxy or tunnel; do not expose this Node listener directly.
SIP_GATEWAY_HOST=127.0.0.1
SIP_GATEWAY_PORT=3107
SIP_ALLOW_NON_LOOPBACK_BIND=false

# Safe default. Change to accept only for the extension-70 canary after the SIP
# route, webhook, firewall, and exact caller allowlist have been reviewed.
SIP_GATEWAY_MODE=reject

# Accept mode additionally requires 32+ random bytes encoded as 43-128
# base64url characters (64 hex characters is suitable). Asterisk injects it as
# X-Teleagent-PBX-Auth on the outbound SIP leg.
# Production MUST use systemd LoadCredential. API, webhook, PBX, *_FILE,
# CREDENTIALS_DIRECTORY, loader, and Node hook variables are forbidden here.
# The principal is a non-secret identifier bound to the durable call record.
SIP_PBX_PRINCIPAL=hermes-private-pbx

OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_INSTRUCTIONS=You are the Teleagent native SIP canary. Be concise. Never claim that you started, approved, cancelled, or completed work unless the sideband controller explicitly confirms it.

# From/To are routing filters, never authentication. In accept mode, at least
# one exact From value is required unless the explicit routing escape hatch is
# enabled. The PBX credential remains mandatory in either case.
# Add nonempty SIP_ALLOWED_FROM and SIP_ALLOWED_TO assignments only after the
# exact canary values have been observed and reviewed.
SIP_ALLOW_ALL_CALLERS=false

SIP_REJECT_STATUS=486
SIP_MAX_ACTIVE_CALLS=1
SIP_MAX_HTTP_CONNECTIONS=32
SIP_GREETING_ENABLED=true
SIP_SIDEBAND_CONNECT_TIMEOUT_MS=10000
SIP_MAX_WEBHOOK_BYTES=1048576
SIP_MAX_REALTIME_EVENT_BYTES=1048576

# The unit, not this file, fixes the state boundary/database, marker credential,
# and official OpenAI endpoints. They cannot be overridden here.
