# ====================================
# Teleagent Configuration
# ====================================
# Copy this to .env and fill in your values

# ====================================
# Network Configuration
# ====================================

# Your server's LAN IP (CRITICAL for RTP audio)
# This IP goes into SDP packets so 3CX knows where to send audio
EXTERNAL_IP=10.0.0.100

# Mandatory dedicated runtime identity. Resolve these exact values with
# `id -u teleagent-voice` and `id -g teleagent-voice` after provisioning the
# non-login system account. Blank values deliberately make Compose fail; there
# is no invoking-owner or UID/GID 1000 fallback.
VOICE_APP_UID=
VOICE_APP_GID=
# Dedicated peer identities must be distinct from voice, each other, root, and
# the legacy owner ID 1000. The infrastructure-owned Asterisk identity is
# resolved by the host fence and is deliberately not a Compose setting.
DRACHTIO_UID=
DRACHTIO_GID=
FREESWITCH_UID=
FREESWITCH_GID=
# Root-owned configuration and private durable state boundaries.
DEVICE_CONFIG_DIR=/etc/teleagent-voice/config
VOICE_STATE_DIR=/var/lib/teleagent-voice

# SIP address drachtio advertises in dialog Contact headers.
# For the Hermes+Asterisk local-trunk topology, keep this on 127.0.0.1.
# For direct/public deployments, this should normally match EXTERNAL_IP.
DRACHTIO_EXTERNAL_IP=10.0.0.100

# ====================================
# Drachtio Configuration
# ====================================

DRACHTIO_HOST=127.0.0.1
DRACHTIO_PORT=9022
# The Drachtio credential is read from the protected root-owned source
# /etc/teleagent-voice/credentials/drachtio-secret and never from this file.

# SIP port for Contact header (5070 for 3CX SBC mode, 5060 for direct registration)
# This MUST match the port in docker-compose.yml drachtio command
DRACHTIO_SIP_PORT=5060
# Asterisk's local Teleagent trunk is UDP-only by default. Keep Contact teardown on UDP.
DRACHTIO_SIP_TRANSPORT=udp

# ====================================
# FreeSWITCH Configuration
# ====================================

FREESWITCH_HOST=127.0.0.1
FREESWITCH_PORT=8021
# The FreeSWITCH credential is read from the protected root-owned source
# /etc/teleagent-voice/credentials/freeswitch-secret and never from this file.

# ====================================
# 3CX / SIP Configuration
# ====================================

# Your 3CX server hostname or IP
SIP_DOMAIN=your-3cx-server.3cx.us
SIP_REGISTRAR=10.0.0.50

# Default extension for outbound calls. Registration auth IDs/passwords live
# only in the protected devices.json file; the voice process ignores SIP_AUTH_*.
SIP_EXTENSION=9000
# Optional registrar overrides; voice-app defaults to 5060 and 3600 seconds.
SIP_REGISTRAR_PORT=5060
SIP_EXPIRY=3600

# Default caller ID for outbound PSTN calls
DEFAULT_CALLER_ID=+15551234567

# Exact server-owned SIP trunk route for all outbound calls. Client requests and
# inbound Contact headers cannot override this host, port, or transport.
SIP_TRUNK_HOST=127.0.0.1
SIP_TRUNK_PORT=5060
# Required explicit transport. Hermes+Asterisk local trunking uses UDP.
SIP_TRUNK_TRANSPORT=udp
# Root-owned, untracked files containing two distinct random credentials of at
# least 32 printable bytes. The voice runtime group may read them; provider
# worker UIDs must not. Every file must be root:teleagent-voice mode 0440,
# single-link, and an ordinary file; missing values make Compose fail closed.
SIP_TRUNK_INGRESS_PASSWORD_HOST_FILE=/etc/teleagent-voice/credentials/sip-ingress-password
SIP_TRUNK_CALLBACK_PASSWORD_HOST_FILE=/etc/teleagent-voice/credentials/sip-callback-password

# ====================================
# Agent API Server
# ====================================

# URL to the Claude/Codex bridge. CLAUDE_API_URL remains a compatibility alias.
AGENT_API_URL=http://127.0.0.1:3333

# The hardened single-Hermes default is loopback. A split-host deployment may
# bind a reviewed private interface only with the explicit opt-in below.
AGENT_API_BIND_HOST=127.0.0.1
AGENT_API_NON_LOOPBACK_ENABLED=false

# Mandatory controller-only general bridge token for /ask, /ask-structured,
# and legacy non-phone session lifecycle routes. Docker Compose never inherits
# this token or CLAUDE_API_TOKEN into voice-app; both are fixed empty there. It
# must be a clean
# 32-4096 byte token with no legacy fallback. Do not reuse scoped tokens below.
AGENT_API_TOKEN=replace-with-distinct-random-token-at-least-32-bytes

# Mandatory dedicated bearer for durable phone submission, lookup, cancellation,
# and panic routes under /executor. The operator-only compatibility unlock route
# still requires VOICE_CONTROL_TOKEN. This value must be 32-4096 bytes, contain
# no control characters or surrounding whitespace, and has no general fallback.
# Provision through /etc/teleagent-voice/credentials/executor-api-token.

# Phone privileged actions are retired pending an independent PBX attester and
# controller-owned approval authority. Do not configure a privileged bearer,
# proxy, voice-side enable flag, or approval trust anchor. The production
# controller service unsets those names after reading runtime.env and cannot
# access /run/teleagent-privileged-action.

# Phone managed-agent queries require the bridge's durable executor. The voice
# client fails closed if this is disabled; it never falls back to general /ask.
# Independent non-phone API clients retain the synchronous /ask path.
AGENT_DURABLE_EXECUTOR_ENABLED=true
AGENT_DURABLE_EXECUTOR_POLL_MS=500
AGENT_DURABLE_EXECUTOR_SUBMIT_TIMEOUT_MS=10000

# Comma-separated host roots exposed through the authenticated, bounded,
# read-only Realtime filesystem inspector. Credential paths remain denied.
# Controller-local inspection is intentionally narrow. Workspace/Git/tmux
# inspection is served by the separate teleagent-session-broker identity.
VOICE_INSPECTION_ROOTS=/var/lib/teleagent-control

# Enable Claude, Codex, or both. This example enables both providers.
AGENT_PROVIDERS=claude,codex

# Provider work is confined to the shared sanitized workspace; provider homes,
# controller source/secrets, owner homes, and homelab control sockets are not
# mounted into a launch boundary.
CLAUDE_WORKING_DIR=/srv/teleagent-agent-workspaces/phone
CLAUDE_COMMAND=/opt/teleagent/agent-tools/claude
# Raw prompts and provider output are never loggable. A truthy value makes the
# controller and voice process fail closed at startup.
AGENT_LOG_SENSITIVE=false
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_PERMISSION_MODE=bypassPermissions

# Safer defaults for live phone calls
PHONE_CLAUDE_MODEL=claude-haiku-4-5-20251001
PHONE_HAIKU_CLAUDE_MODEL=claude-haiku-4-5-20251001
PHONE_SONNET_CLAUDE_MODEL=claude-sonnet-5
PHONE_OPUS_CLAUDE_MODEL=claude-opus-5
PHONE_CLAUDE_PERMISSION_MODE=dontAsk
PHONE_HAIKU_CLAUDE_PERMISSION_MODE=dontAsk
PHONE_SONNET_CLAUDE_PERMISSION_MODE=dontAsk
PHONE_OPUS_CLAUDE_PERMISSION_MODE=dontAsk
PHONE_DEPLOY_TIMEOUT_SECONDS=900
# Provider launches have no public/private network path. WebFetch/WebSearch and
# unreviewed Skill sources are unavailable pending a scoped redacting proxy.
PHONE_CLAUDE_TOOLS=Read,Glob,Grep
PHONE_HAIKU_CLAUDE_TOOLS=Read,Glob,Grep
PHONE_SONNET_CLAUDE_TOOLS=Read,Glob,Grep
PHONE_OPUS_CLAUDE_TOOLS=Read,Glob,Grep
# Every production phone profile is read-only. Model tier selection changes
# reasoning strength only; no pound approval restores mutation tools.

# Codex CLI working directory and phone profiles. Authentication uses a
# root-owned project API key through the bounded credential-egress service;
# no subscription login or bearer is stored in the model worker HOME.
CODEX_WORKING_DIR=/srv/teleagent-agent-workspaces/phone
CODEX_COMMAND=/opt/teleagent/agent-tools/codex
PHONE_CODEX_LUNA_WORKING_DIR=/srv/teleagent-agent-workspaces/phone
PHONE_CODEX_TERRA_WORKING_DIR=/srv/teleagent-agent-workspaces/phone
PHONE_CODEX_SOL_WORKING_DIR=/srv/teleagent-agent-workspaces/phone
PHONE_CODEX_LUNA_MODEL=gpt-5.6-luna
PHONE_CODEX_TERRA_MODEL=gpt-5.6-terra
PHONE_CODEX_SOL_MODEL=gpt-5.6-sol
PHONE_CODEX_LUNA_REASONING_EFFORT=low
PHONE_CODEX_TERRA_REASONING_EFFORT=medium
PHONE_CODEX_SOL_REASONING_EFFORT=high
PHONE_CODEX_LUNA_SANDBOX=read-only
PHONE_CODEX_TERRA_SANDBOX=read-only
PHONE_CODEX_SOL_SANDBOX=read-only
# Production forces every Codex phone tier to this read-only sandbox. A future
# authority design must add an independently attested execution path rather
# than widening these profile settings.
# Phone calls cannot satisfy an interactive approval prompt.
PHONE_CODEX_APPROVAL_POLICY=never
# Every deploy/publish request is rejected until an audited tool broker exists.
# Recent provider-log output is the bounded signal used to distinguish active
# generation from quiet work or a process that is merely waiting for input.
VOICE_AGENT_RECENT_OUTPUT_MS=5000

# ====================================
# OpenAI Realtime Voice Conductor
# ====================================

# Required only for extensions 7/77. Keep this server-side; never expose it to SIP clients.
# A malformed, whitespace-padded, obvious example, or shorter-than-32-byte
# value is treated as unconfigured rather than making Realtime health ready.
# Provision through /etc/teleagent-voice/credentials/openai-realtime-api-key.
# Current native speech-to-speech model and recommended high-quality voice.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=marin
# Live input transcripts are retained as text in the durable voice-thread state.
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-live-transcribe
# Telephony/domain guidance for live transcription. Keep stable keywords here;
# caller-specific context is supplied separately in the Realtime instructions.
OPENAI_REALTIME_TRANSCRIPTION_PROMPT=A private operator call about Teleagent on the phone through Linphone, Hermes, a homelab, repositories, the main tmux session, windows, panes, Claude Code, Codex, Kubernetes, and infrastructure.
OPENAI_REALTIME_TRANSCRIPTION_KEYWORDS=Hermes,Teleagent,homelab,tmux,Claude Code,Codex,Haiku,Sonnet,Opus,Luna,Terra,Sol,Kubernetes,phone,Linphone,main,window,pane,phone-infra,FreeSWITCH,drachtio,freestio,pound,star,approve,cancel
OPENAI_REALTIME_TRANSCRIPTION_LANGUAGES=en
OPENAI_REALTIME_TRANSCRIPTION_DELAY=medium
# Filters close-talking Linphone audio before VAD and model input. Use far_field
# for speakerphone/conference-room microphones, or off for troubleshooting.
OPENAI_REALTIME_NOISE_REDUCTION=near_field
# The first value is an advisory speech target. The second is a high absolute
# runaway guard; normal answers are allowed to finish naturally below it.
OPENAI_REALTIME_MAX_SPOKEN_WORDS=35
OPENAI_REALTIME_HARD_MAX_SPOKEN_WORDS=240
# Coalesce adjacent transcript completions before asking Realtime to respond.
OPENAI_REALTIME_RESPONSE_DEBOUNCE_MS=500
# Retention-ratio truncation bounds long-call context while preserving the stable prompt prefix.
OPENAI_REALTIME_CONTEXT_TOKEN_LIMIT=16000
OPENAI_REALTIME_CONTEXT_RETENTION_RATIO=0.8
# Optional OpenAI account routing headers.
# OPENAI_ORGANIZATION=
# OPENAI_PROJECT=
# Optional override for compatible test gateways. Production should use the default OpenAI URL.
# OPENAI_REALTIME_BASE_URL=wss://api.openai.com/v1/realtime
# Optional salt for the hash sent as OpenAI-Safety-Identifier. When omitted,
# the dedicated Realtime API key is used as the local HMAC-like salt.
# Provision through /etc/teleagent-voice/credentials/openai-safety-salt.

# Durable SQLite state for extension 7 (fresh thread) and 77 (resume thread)
# is fixed inside voice-app at /app/state/voice-state.sqlite. Do not set
# VOICE_STATE_DB_PATH in a host environment file.
# Production voice has no signing key, issuer, or privileged bridge. The
# capability and replay modules remain unit-test substrate for a future design;
# none of their legacy VOICE_APPROVAL_* settings belongs in a production env.
EXECUTOR_TASK_DB_PATH=/var/lib/teleagent-control/executor-tasks.sqlite
EXECUTOR_TASK_LEASE_MS=15000
EXECUTOR_TASK_HEARTBEAT_MS=5000
EXECUTOR_TASK_POLL_MS=250
EXECUTOR_TASK_CONCURRENCY=1

# Mandatory provider-specific host boundaries for every Claude/Codex launch.
# The obsolete AGENT_WORKER_USER must remain unset; either missing provider
# identity leaves the controller diagnostic-only and no controller-UID child
# launch exists. The legacy flag is a non-ready diagnostic only.
AGENT_WORKER_USER=
AGENT_WORKER_LEGACY_SAME_UID_ENABLED=false
AGENT_CLAUDE_WORKER_USER=teleagent-claude-worker
AGENT_CODEX_WORKER_USER=teleagent-codex-worker
AGENT_CLAUDE_WORKER_HOME=/var/lib/teleagent-claude-worker
AGENT_CODEX_WORKER_HOME=/var/lib/teleagent-codex-worker
AGENT_WORKER_WORKSPACE_ROOT=/srv/teleagent-agent-workspaces
AGENT_WORKER_DEFAULT_WORKSPACE=/srv/teleagent-agent-workspaces/phone
AGENT_WORKER_CODEX_BIN=/opt/teleagent/agent-tools/codex
AGENT_WORKER_CLAUDE_BIN=/opt/teleagent/agent-tools/claude
AGENT_WORKER_PATH=/opt/teleagent/agent-tools:/usr/local/bin:/usr/bin
AGENT_PROVIDER_SUPERVISOR_CLIENT_PATH=/usr/local/libexec/teleagent-provider-supervisor-client
# Workspace/Git/tmux/provider-log access crosses only the session-broker UID.
# Provider workers cannot connect to this socket or its broker-owned tmux/DB.
WORKER_SESSION_BROKER_ENABLED=true
WORKER_SESSION_BROKER_SOCKET_PATH=/run/teleagent-worker-session/broker.sock
WORKER_SESSION_BROKER_TIMEOUT_MS=10000
WORKER_SESSION_BROKER_HEALTH_POLL_MS=2000
# The voice-app emergency-stop lock is fixed inside the mounted state directory
# at /app/state/voice-execution.lock.json. Do not set
# VOICE_APP_EXECUTION_LOCK_FILE in a host environment file. The separate host
# bridge lock remains host-configurable; do not point it at an in-container path.
# VOICE_EXECUTION_LOCK_FILE=/absolute/host/path/voice-execution.lock.json
# Status, unlock, and privileged operator requests use this mandatory dedicated
# bearer with no general-token fallback. Dial-9 stop remains loopback-only and
# sends no bearer.
# Provision through /etc/teleagent-voice/credentials/voice-control-token.

# ====================================
# TTS - Kokoro or Any OpenAI-Compatible Speech API
# ====================================

TTS_BASE_URL=http://127.0.0.1:18000/v1
# Optional protected source: /etc/teleagent-voice/credentials/tts-api-key.
TTS_MODEL=kokoro
TTS_VOICE=alb
TTS_ALLOWED_VOICES=alb,cao
TTS_RESPONSE_FORMAT=mp3
# Optional request tuning; voice-app defaults to 30 seconds and speed 1.0.
TTS_TIMEOUT_MS=30000
TTS_SPEED=1.0

# ====================================
# STT - Whisper or Any OpenAI-Compatible Transcription API
# ====================================

STT_BASE_URL=http://127.0.0.1:18001/v1
# Optional protected source: /etc/teleagent-voice/credentials/stt-api-key.
STT_MODEL=whisper-1

# ====================================
# Application Settings
# ====================================

# HTTP server port for API and audio file serving. The voice-app HTTP host is
# fixed to 127.0.0.1 and must be absent from the host environment file.
HTTP_PORT=3000

# AudioFork is a private same-host FreeSWITCH callback. Each call gets a
# short-lived one-use 32-byte attach credential embedded in its callback URL;
# the credential is never configured, persisted, or logged by voice-app.
# Both AudioFork endpoints are fixed to 127.0.0.1 and the allowed-peer set is
# fixed empty (which resolves to loopback peers). Do not set WS_HOST,
# WS_CONNECT_HOST, WS_ALLOWED_PEERS, or WS_NON_LOOPBACK_ENABLED here.
WS_PORT=3001

# Audio files directory
# Generated call audio is fixed to the private in-container /tmp/voice-audio
# tmpfs and is never a host-writable bind mount.

# ====================================
# Outbound Call Settings
# ====================================

# Maximum conversation turns for outbound calls
MAX_CONVERSATION_TURNS=10

# Ring timeout in seconds
OUTBOUND_RING_TIMEOUT=30

# Required: distinct random bearer token (32+ bytes) for outbound control routes.
# Placeholder, missing, or malformed values fail route initialization closed.
# Provision through /etc/teleagent-voice/credentials/outbound-api-token.
# Outbound HTTP is fixed to the same loopback listener. Do not set
# OUTBOUND_API_NON_LOOPBACK_ENABLED in a host environment file.

# ====================================
# Optional: Debug
# ====================================

# AUDIO_DEBUG=false
# Never enable any `drachtio:*` namespace. Dependency traces can include the
# Drachtio control secret, callback Digest password/Authorization, or the
# credential-bearing uuid_audio_fork command. Voice-app refuses startup unless
# wildcard DEBUG is paired with the complete exclusion `-drachtio:*`.
# DEBUG=voice-app:*
