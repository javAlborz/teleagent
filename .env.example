# ====================================
# Teleagent Configuration
# ====================================
# Copy this to .env and fill in your values

# ====================================
# Network Configuration
# ====================================

# Your server's LAN IP (CRITICAL for RTP audio)
# This IP goes into SDP packets so 3CX knows where to send audio
EXTERNAL_IP=10.0.0.100

# Optional: source-of-truth directory mounted at /app/config in the voice-app container.
# For generic/local use, keep the repo default. For Hermes, this can point at a tracked
# homelab-infrastructure directory instead of the ignored local voice-app/config path.
DEVICE_CONFIG_DIR=./voice-app/config

# SIP address drachtio advertises in dialog Contact headers.
# For the Hermes+Asterisk local-trunk topology, keep this on 127.0.0.1.
# For direct/public deployments, this should normally match EXTERNAL_IP.
DRACHTIO_EXTERNAL_IP=10.0.0.100

# ====================================
# Drachtio Configuration
# ====================================

DRACHTIO_HOST=127.0.0.1
DRACHTIO_PORT=9022
DRACHTIO_SECRET=replace-with-random-secret

# SIP port for Contact header (5070 for 3CX SBC mode, 5060 for direct registration)
# This MUST match the port in docker-compose.yml drachtio command
DRACHTIO_SIP_PORT=5060

# ====================================
# FreeSWITCH Configuration
# ====================================

FREESWITCH_HOST=127.0.0.1
FREESWITCH_PORT=8021
FREESWITCH_SECRET=replace-with-random-secret

# ====================================
# 3CX / SIP Configuration
# ====================================

# Your 3CX server hostname or IP
SIP_DOMAIN=your-3cx-server.3cx.us
SIP_REGISTRAR=10.0.0.50

# Default extension for outbound calls
SIP_EXTENSION=9000
SIP_AUTH_ID=your-auth-id
SIP_AUTH_PASSWORD=your-password

# Default caller ID for outbound PSTN calls
DEFAULT_CALLER_ID=+15551234567

# SIP trunk or PBX host for outbound calls initiated by claude-phone
SIP_TRUNK_HOST=127.0.0.1
# Optional explicit transport for SIP_TRUNK_HOST. Hermes+Asterisk local trunking uses UDP.
SIP_TRUNK_TRANSPORT=udp

# ====================================
# Agent API Server
# ====================================

# URL to the Claude/Codex bridge. CLAUDE_API_URL remains a compatibility alias.
AGENT_API_URL=http://10.0.0.200:3333

# Optional: bind claude-api-server to localhost or a specific interface
AGENT_API_BIND_HOST=127.0.0.1

# Optional: shared token between voice-app and claude-api-server
AGENT_API_TOKEN=replace-with-random-token

# Enable Claude, Codex, or both. This example enables both providers.
AGENT_PROVIDERS=claude,codex

# Claude CLI working directory and profile behavior
# Setting this to /home/alborz intentionally gives phone-admin sessions access
# to the wider homelab workspace. Narrow it if you want repo-only containment.
CLAUDE_WORKING_DIR=/home/alborz
CLAUDE_COMMAND=claude
# Set true only when you intentionally need prompt/session details in logs.
AGENT_LOG_SENSITIVE=false
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_PERMISSION_MODE=bypassPermissions

# Safer defaults for live phone calls
PHONE_CLAUDE_MODEL=haiku
PHONE_HAIKU_CLAUDE_MODEL=haiku
PHONE_SONNET_CLAUDE_MODEL=sonnet
PHONE_OPUS_CLAUDE_MODEL=opus
PHONE_CLAUDE_PERMISSION_MODE=dontAsk
PHONE_HAIKU_CLAUDE_PERMISSION_MODE=dontAsk
PHONE_SONNET_CLAUDE_PERMISSION_MODE=dontAsk
PHONE_OPUS_CLAUDE_PERMISSION_MODE=dontAsk
PHONE_DEPLOY_CLAUDE_MODEL=sonnet
PHONE_DEPLOY_CLAUDE_PERMISSION_MODE=dontAsk
PHONE_DEPLOY_TIMEOUT_SECONDS=900
# Baseline read-only toolset for phone agents.
PHONE_CLAUDE_TOOLS=Read,Glob,Grep,WebFetch,WebSearch,Skill
# Haiku gets a small trusted troubleshooting shell.
PHONE_HAIKU_CLAUDE_TOOLS=Read,Glob,Grep,WebFetch,WebSearch,Bash,Skill
# Sonnet gets file-edit tools plus the same trusted troubleshooting shell.
PHONE_SONNET_CLAUDE_TOOLS=Read,Write,Edit,Glob,Grep,Task,WebFetch,WebSearch,Bash,Skill
# Opus can optionally match real interactive sessions more closely by adding Bash.
PHONE_OPUS_CLAUDE_TOOLS=Read,Write,Edit,Glob,Grep,Task,WebFetch,WebSearch,Bash,Skill
# Deploy-capable profile used only for explicit phone deploy/ship/publish requests.
PHONE_DEPLOY_CLAUDE_TOOLS=Read,Write,Edit,Glob,Grep,Bash,Skill

# Codex CLI working directory and phone profiles. The CLI uses the existing
# Codex/ChatGPT login for the account that runs claude-api-server.
CODEX_WORKING_DIR=/home/alborz
CODEX_COMMAND=codex
PHONE_CODEX_LUNA_WORKING_DIR=/home/alborz
PHONE_CODEX_TERRA_WORKING_DIR=/home/alborz/phone
PHONE_CODEX_SOL_WORKING_DIR=/home/alborz
PHONE_CODEX_DEPLOY_WORKING_DIR=/home/alborz
PHONE_CODEX_LUNA_MODEL=gpt-5.6-luna
PHONE_CODEX_TERRA_MODEL=gpt-5.6-terra
PHONE_CODEX_SOL_MODEL=gpt-5.6-sol
PHONE_CODEX_DEPLOY_MODEL=gpt-5.6-sol
PHONE_CODEX_LUNA_REASONING_EFFORT=low
PHONE_CODEX_TERRA_REASONING_EFFORT=medium
PHONE_CODEX_SOL_REASONING_EFFORT=high
PHONE_CODEX_DEPLOY_REASONING_EFFORT=high
PHONE_CODEX_LUNA_SANDBOX=read-only
PHONE_CODEX_TERRA_SANDBOX=workspace-write
PHONE_CODEX_SOL_SANDBOX=danger-full-access
PHONE_CODEX_DEPLOY_SANDBOX=danger-full-access
# Phone calls cannot satisfy an interactive approval prompt.
PHONE_CODEX_APPROVAL_POLICY=never
# Luna and Terra deploy requests are rejected; only Sol may enter the deploy profile.

# ====================================
# OpenAI Realtime Voice Conductor
# ====================================

# Required only for extensions 7/77. Keep this server-side; never expose it to SIP clients.
OPENAI_REALTIME_API_KEY=
# Current native speech-to-speech model and recommended high-quality voice.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
# Live input transcripts are retained as text in the durable voice-thread state.
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-live-transcribe
# Optional OpenAI account routing headers.
# OPENAI_ORGANIZATION=
# OPENAI_PROJECT=
# Optional override for compatible test gateways. Production should use the default OpenAI URL.
# OPENAI_REALTIME_BASE_URL=wss://api.openai.com/v1/realtime
# Optional salt for the hash sent as OpenAI-Safety-Identifier. When omitted,
# the dedicated Realtime API key is used as the local HMAC-like salt.
OPENAI_SAFETY_IDENTIFIER_SALT=replace-with-random-secret

# Durable SQLite state for extension 7 (fresh thread) and 77 (resume thread).
VOICE_STATE_DIR=./voice-app/state
VOICE_STATE_DB_PATH=/app/state/voice-state.sqlite
# The emergency-stop lock defaults to the same mounted state directory in
# voice-app and to voice-app/state on the host bridge. Split deployments may
# override these separately; do not point the host bridge at an in-container path.
# VOICE_APP_EXECUTION_LOCK_FILE=/app/state/voice-execution.lock.json
# VOICE_EXECUTION_LOCK_FILE=/absolute/host/path/voice-execution.lock.json
# Unlock requests use VOICE_CONTROL_TOKEN when set, then OUTBOUND_API_TOKEN or
# AGENT_API_TOKEN. The dial-9 stop itself is loopback-only and needs no token.
# VOICE_CONTROL_TOKEN=replace-with-random-token

# ====================================
# TTS - Kokoro or Any OpenAI-Compatible Speech API
# ====================================

TTS_BASE_URL=http://127.0.0.1:18000/v1
TTS_API_KEY=not-needed
TTS_MODEL=kokoro
TTS_VOICE=alb
TTS_ALLOWED_VOICES=alb,cao
TTS_RESPONSE_FORMAT=mp3

# ====================================
# STT - Whisper or Any OpenAI-Compatible Transcription API
# ====================================

STT_BASE_URL=http://127.0.0.1:18001/v1
STT_API_KEY=not-needed
STT_MODEL=whisper-1

# ====================================
# Application Settings
# ====================================

# HTTP server port for API and audio file serving
HTTP_HOST=127.0.0.1
HTTP_PORT=3000

# WebSocket port for audio streaming from FreeSWITCH
WS_HOST=127.0.0.1
WS_PORT=3001

# Audio files directory
AUDIO_DIR=/app/audio

# ====================================
# Outbound Call Settings
# ====================================

# Maximum conversation turns for outbound calls
MAX_CONVERSATION_TURNS=10

# Ring timeout in seconds
OUTBOUND_RING_TIMEOUT=30

# Optional: bearer token for outbound control routes.
# When set, callers must send Authorization: Bearer <token>
# (or X-API-Key) to use /api/outbound-call and related call-control endpoints.
OUTBOUND_API_TOKEN=replace-with-random-token

# ====================================
# Optional: Debug
# ====================================

# AUDIO_DEBUG=false
# DEBUG=voice-app:*
