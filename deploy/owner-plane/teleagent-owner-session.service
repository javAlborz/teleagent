[Unit]
Description=Teleagent exact enrolled personal agent session broker
Requires=teleagent-owner-session.socket
After=local-fs.target teleagent-owner-session.socket
ConditionPathExists=/etc/teleagent/owner-session/ENABLE
ConditionPathIsMountPoint=/var/lib/teleagent-owner-session

[Service]
Type=simple
Slice=teleagent.slice
Sockets=teleagent-owner-session.socket
User=alborz
Group=alborz
MemoryHigh=100663296
MemoryMax=134217728
Environment=HOME=/var/lib/teleagent-owner-session
ReadWritePaths=/var/lib/teleagent-owner-session
CPUAccounting=yes
CPUQuota=50%
MemoryAccounting=yes
MemorySwapMax=0
TasksAccounting=yes
TasksMax=64
Restart=no
KillMode=control-group
TimeoutStopSec=15s
OOMPolicy=kill
UMask=0077
WorkingDirectory=/
Environment=PATH=/usr/bin:/bin
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
NoNewPrivileges=yes
AmbientCapabilities=
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_SETPCAP CAP_KILL
PrivateDevices=yes
PrivateIPC=yes
KeyringMode=private
ProtectSystem=strict
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
LimitNOFILE=1024
LimitFSIZE=33554432
LimitCORE=0
LoadCredential=teleagent-release-gate:/run/teleagent-release-gate/verified.json
ExecStartPre=+/usr/bin/python3 -I /usr/local/libexec/verify-teleagent-release-closure --check-start-gate
PrivateTmp=no
ProtectHome=tmpfs
BindReadOnlyPaths=/home/alborz/dev /home/alborz/dev2 /home/alborz/.claude/sessions /home/alborz/.claude/projects
ReadOnlyPaths=/tmp
InaccessiblePaths=-/home/alborz/ufst
ExecStart=!/usr/bin/python3 -I /usr/local/libexec/verify-teleagent-release-closure --supervise-component owner-session ${CREDENTIALS_DIRECTORY}/teleagent-release-gate

# Root-installed disabled; no automatic boot activation or provider launch.
