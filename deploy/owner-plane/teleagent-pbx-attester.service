[Unit]
Description=Teleagent independent handset approval attester
Requires=teleagent-pbx-attester.socket
After=local-fs.target teleagent-pbx-attester.socket
Requires=teleagent-pbx-ari.socket teleagent-pbx-ari.service
After=teleagent-pbx-ari.service
ConditionPathExists=/etc/teleagent/pbx-attester/ENABLE
ConditionPathIsMountPoint=/var/lib/teleagent-pbx-attester

[Service]
Type=simple
Slice=teleagent-voice.slice
Sockets=teleagent-pbx-attester.socket
User=teleagent-pbx-attester
Group=teleagent-pbx-attester
MemoryHigh=201326592
MemoryMax=268435456
Environment=HOME=/var/lib/teleagent-pbx-attester
ReadWritePaths=/var/lib/teleagent-pbx-attester
CPUAccounting=yes
CPUQuota=50%
MemoryAccounting=yes
MemorySwapMax=0
TasksAccounting=yes
TasksMax=64
Restart=no
KillMode=control-group
TimeoutStopSec=15s
OOMPolicy=kill
UMask=0077
WorkingDirectory=/
Environment=PATH=/usr/bin:/bin
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
NoNewPrivileges=yes
AmbientCapabilities=
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_SETPCAP CAP_KILL
PrivateDevices=yes
PrivateIPC=yes
KeyringMode=private
ProtectSystem=strict
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
LimitNOFILE=1024
LimitFSIZE=33554432
LimitCORE=0
LoadCredential=teleagent-release-gate:/run/teleagent-release-gate/verified.json
ExecStartPre=+/usr/bin/python3 -I /usr/local/libexec/verify-teleagent-release-closure --check-start-gate
PrivateTmp=yes
ProtectHome=yes
ReadWritePaths=/var/lib/teleagent-pbx-prompts
InaccessiblePaths=/etc/teleagent/controller /etc/teleagent/owner-authority/controller /var/lib/teleagent-control /run/teleagent-controller /run/teleagent-owner-session
ExecStartPre=+/usr/bin/python3 -I /usr/local/libexec/verify-teleagent-owner-plane --attest-pbx
ExecStart=!/usr/bin/python3 -I /usr/local/libexec/verify-teleagent-release-closure --supervise-component pbx-attester ${CREDENTIALS_DIRECTORY}/teleagent-release-gate

# Root-installed disabled; no automatic boot activation or provider launch.
