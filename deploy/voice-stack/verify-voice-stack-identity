#!/usr/local/libexec/teleagent-node
'use strict';

const fs = require('node:fs');
const path = require('node:path');
const { spawnSync } = require('node:child_process');

const SOURCE_ROOT = '/opt/teleagent/current/deploy/voice-stack';
const RELEASE_PARENT = '/opt/teleagent/releases';
const INSTALLED_VERIFIER = '/usr/local/libexec/verify-voice-stack-identity';
const RELEASE_START_GATE = 'ExecStartPre=+/usr/bin/env -i HOME=/var/empty ' +
  'PATH=/usr/sbin:/usr/bin:/sbin:/bin LANG=C.UTF-8 LC_ALL=C.UTF-8 ' +
  '/usr/local/libexec/verify-teleagent-release-closure --check-start-gate';
const RELEASE_START_COMMAND = 'ExecStart=/usr/bin/python3 -I ' +
  '/usr/local/libexec/verify-teleagent-release-closure --start-component voice-stack-start ' +
  '${CREDENTIALS_DIRECTORY}/teleagent-release-gate';
const RELEASE_STOP_COMMAND = 'ExecStop=/usr/bin/python3 -I ' +
  '/usr/local/libexec/verify-teleagent-release-closure --stop-voice-stack';
const RELEASE_CLEANUP_COMMAND = 'ExecStopPost=/usr/bin/python3 -I ' +
  '/usr/local/libexec/verify-teleagent-release-closure --cleanup-voice-stack';
const RELEASE_GATE_CREDENTIAL = 'LoadCredential=teleagent-release-gate:' +
  '/run/teleagent-release-gate/verified.json';
const EXECUTION_DIRECTIVE = /^Exec(?:Condition|StartPre|Start|StartPost|Reload|Stop|StopPost)=/u;
const CREDENTIAL_DIRECTIVE = /^(?:LoadCredential|LoadCredentialEncrypted|SetCredential|SetCredentialEncrypted|ImportCredential|ImportCredentialEx)=/u;
const IDENTITY_SPECS = Object.freeze([
  Object.freeze({ key: 'voice', name: 'teleagent-voice', home: '/var/lib/teleagent-voice' }),
  Object.freeze({ key: 'drachtio', name: 'teleagent-drachtio', home: '/nonexistent' }),
  Object.freeze({ key: 'freeswitch', name: 'teleagent-freeswitch', home: '/nonexistent' }),
  // Asterisk is infrastructure-owned. This bundle verifies but never creates it.
  Object.freeze({ key: 'asterisk', name: 'teleagent-asterisk', home: '/nonexistent' }),
]);
const COLLISION_IDENTITIES = Object.freeze([
  'teleagent-control',
  'teleagent-session-broker',
  'teleagent-claude-supervisor',
  'teleagent-codex-supervisor',
  'teleagent-claude-worker',
  'teleagent-codex-worker',
  'teleagent-claude-shim',
  'teleagent-codex-shim',
  'teleagent-claude-egress',
  'teleagent-codex-egress',
]);
const REVIEWED_ASSETS = Object.freeze([
  ['teleagent-voice-stack.service', '/etc/systemd/system/teleagent-voice-stack.service', 0o644],
  ['teleagent-voice-containers.slice', '/etc/systemd/system/teleagent-voice-containers.slice', 0o644],
  ['teleagent-voice-stack.sysusers', '/etc/sysusers.d/teleagent-voice-stack.conf', 0o644],
  ['teleagent-voice-stack.tmpfiles', '/etc/tmpfiles.d/teleagent-voice-stack.conf', 0o644],
  ['teleagent-voice-stack-launch.js', '/usr/local/libexec/teleagent-voice-stack-launch', 0o755],
  ['verify-voice-stack-identity', INSTALLED_VERIFIER, 0o755],
  ['teleagent-voice-stack-install', '/usr/local/libexec/teleagent-voice-stack-install', 0o755],
]);

function refuse(message) {
  throw new Error(`Voice identity verification refused: ${message}`);
}

function meaningfulLines(source) {
  return String(source).split('\n').map((line) => line.trim())
    .filter((line) => line && !line.startsWith('#'));
}

function exactlyOnce(source, expression, label) {
  const matches = String(source).match(expression) || [];
  if (matches.length !== 1) refuse(`${label} must occur exactly once`);
}

function serviceDirectiveLines(source, expression, label) {
  const result = [];
  let section = null;
  for (const line of String(source).split('\n')) {
    const header = /^[^\S\r\n]*(\[[^\][\r\n]+\])[^\S\r\n]*$/u.exec(line);
    if (header) {
      section = header[1];
      continue;
    }
    if (!expression.test(line)) continue;
    if (section !== '[Service]') refuse(`${label} escaped the Service section`);
    result.push(line);
  }
  return result;
}

function sameLineMultiset(actual, expected) {
  return JSON.stringify([...actual].sort()) === JSON.stringify([...expected].sort());
}

function inspectSourceAsset(filename, { uid = 0, gid = 0, mode }, {
  lstat = fs.lstatSync,
} = {}) {
  const metadata = lstat(filename);
  if (![0o644, 0o755].includes(mode)) {
    refuse(`reviewed source asset ${path.basename(filename)} has an unsupported target mode`);
  }
  const actualMode = metadata.mode & 0o7777;
  const immutableMode = mode & 0o555;
  if (!metadata.isFile() || metadata.isSymbolicLink() || metadata.nlink !== 1 ||
      metadata.uid !== uid || metadata.gid !== gid ||
      ![mode, immutableMode].includes(actualMode)) {
    refuse(`reviewed source asset ${path.basename(filename)} has unsafe metadata`);
  }
  return metadata;
}

function sameSourceIdentity(left, right) {
  return ['dev', 'ino', 'mode', 'uid', 'gid', 'nlink', 'size']
    .every((field) => left?.[field] === right?.[field]);
}

function inspectResolvedSourceBundle(resolvedRoot, {
  releaseParent = RELEASE_PARENT,
  sourceUid = 0,
  sourceGid = 0,
  lstat = fs.lstatSync,
  realpath = fs.realpathSync,
} = {}) {
  const releaseRoot = path.resolve(resolvedRoot, '..', '..');
  const relative = path.relative(releaseParent, resolvedRoot).split(path.sep);
  const rootMetadata = lstat(resolvedRoot);
  if (!path.isAbsolute(resolvedRoot) || realpath(resolvedRoot) !== resolvedRoot ||
      realpath(releaseParent) !== releaseParent ||
      !rootMetadata.isDirectory() || rootMetadata.isSymbolicLink() ||
      rootMetadata.uid !== sourceUid || rootMetadata.gid !== sourceGid ||
      (rootMetadata.mode & 0o7777) !== 0o555 ||
      relative.length !== 3 || !/^sha256-[a-f0-9]{64}$/.test(relative[0]) ||
      relative[1] !== 'deploy' || relative[2] !== 'voice-stack' ||
      releaseRoot !== path.join(releaseParent, relative[0])) {
    refuse('the reviewed voice source bundle is outside one immutable release');
  }
  const releaseMetadata = lstat(releaseRoot);
  if (!releaseMetadata.isDirectory() || releaseMetadata.isSymbolicLink() ||
      releaseMetadata.uid !== sourceUid || releaseMetadata.gid !== sourceGid ||
      (releaseMetadata.mode & 0o7777) !== 0o555 || realpath(releaseRoot) !== releaseRoot) {
    refuse('the reviewed voice release root has unsafe metadata');
  }

  const verifierPath = path.join(resolvedRoot, 'verify-voice-stack-identity');
  const verifierBefore = inspectSourceAsset(verifierPath, {
    uid: sourceUid,
    gid: sourceGid,
    mode: 0o755,
  }, { lstat });
  const resolvedVerifier = realpath(verifierPath);
  const verifierResolved = inspectSourceAsset(resolvedVerifier, {
    uid: sourceUid,
    gid: sourceGid,
    mode: 0o755,
  }, { lstat });
  const verifierAfter = inspectSourceAsset(verifierPath, {
    uid: sourceUid,
    gid: sourceGid,
    mode: 0o755,
  }, { lstat });
  if (resolvedVerifier !== verifierPath ||
      !sameSourceIdentity(verifierBefore, verifierResolved) ||
      !sameSourceIdentity(verifierBefore, verifierAfter)) {
    refuse('the reviewed voice source verifier changed while it was resolved');
  }
  return Object.freeze({ sourceRoot: resolvedRoot, verifierPath: resolvedVerifier, releaseRoot });
}

function resolvePinnedSourceBundle(sourceRoot, options = {}) {
  const { lstat = fs.lstatSync, realpath = fs.realpathSync } = options;
  if (!path.isAbsolute(sourceRoot) || realpath(sourceRoot) !== sourceRoot) {
    refuse('the pinned voice source root is not canonical');
  }
  const before = lstat(sourceRoot);
  const result = inspectResolvedSourceBundle(sourceRoot, options);
  const after = lstat(sourceRoot);
  if (!sameSourceIdentity(before, after)) {
    refuse('the pinned voice source root changed while it was resolved');
  }
  return result;
}

function resolveSourceBundle(sourceRoot = SOURCE_ROOT, {
  releaseParent = RELEASE_PARENT,
  sourceUid = 0,
  sourceGid = 0,
  lstat = fs.lstatSync,
  realpath = fs.realpathSync,
  readlink = fs.readlinkSync,
} = {}) {
  const selector = path.resolve(sourceRoot, '..', '..');
  const selectorBefore = lstat(selector);
  const literalTarget = readlink(selector);
  const rootBefore = lstat(sourceRoot);
  const resolvedRoot = realpath(sourceRoot);
  const rootResolved = lstat(resolvedRoot);
  const rootAfter = lstat(sourceRoot);
  const selectorAfter = lstat(selector);
  if (sourceRoot !== path.join(selector, 'deploy', 'voice-stack') ||
      !selectorBefore.isSymbolicLink() || selectorBefore.uid !== sourceUid ||
      selectorBefore.gid !== sourceGid || selectorBefore.nlink !== 1 ||
      !sameSourceIdentity(selectorBefore, selectorAfter) ||
      !rootBefore.isDirectory() || rootBefore.isSymbolicLink() ||
      rootBefore.uid !== sourceUid || rootBefore.gid !== sourceGid ||
      (rootBefore.mode & 0o7777) !== 0o555 ||
      !sameSourceIdentity(rootBefore, rootResolved) ||
      !sameSourceIdentity(rootBefore, rootAfter) ||
      realpath(resolvedRoot) !== resolvedRoot ||
      literalTarget !== path.resolve(resolvedRoot, '..', '..')) {
    refuse('the reviewed voice source bundle changed or resolved outside the immutable release');
  }
  return inspectResolvedSourceBundle(resolvedRoot, {
    releaseParent, sourceUid, sourceGid, lstat, realpath,
  });
}

function sourceCheck(sourceRoot = SOURCE_ROOT, { sourceUid = 0, sourceGid = 0 } = {}) {
  for (const [sourceName, _target, mode] of REVIEWED_ASSETS) {
    inspectSourceAsset(path.join(sourceRoot, sourceName), {
      uid: sourceUid,
      gid: sourceGid,
      mode,
    });
  }
  const sysusers = fs.readFileSync(path.join(sourceRoot, 'teleagent-voice-stack.sysusers'), 'utf8');
  const tmpfiles = fs.readFileSync(path.join(sourceRoot, 'teleagent-voice-stack.tmpfiles'), 'utf8');
  const service = fs.readFileSync(path.join(sourceRoot, 'teleagent-voice-stack.service'), 'utf8');
  const slice = fs.readFileSync(path.join(sourceRoot, 'teleagent-voice-containers.slice'), 'utf8');
  const compose = fs.readFileSync(path.resolve(sourceRoot, '..', '..', 'docker-compose.yml'), 'utf8');
  if (JSON.stringify(meaningfulLines(sysusers)) !== JSON.stringify([
    'g teleagent-voice -',
    'u teleagent-voice - "Teleagent private voice orchestrator" /var/lib/teleagent-voice /usr/sbin/nologin',
    'g teleagent-drachtio -',
    'u teleagent-drachtio - "Teleagent private Drachtio peer" /nonexistent /usr/sbin/nologin',
    'g teleagent-freeswitch -',
    'u teleagent-freeswitch - "Teleagent private FreeSWITCH peer" /nonexistent /usr/sbin/nologin',
  ])) refuse('the sysusers identity contract drifted');
  if (JSON.stringify(meaningfulLines(tmpfiles)) !== JSON.stringify([
    'd /etc/teleagent-isolated-voice 0700 root root -',
    'd /etc/teleagent-isolated-voice/config 0750 root teleagent-voice -',
    'd /etc/teleagent-isolated-voice/credentials 0750 root teleagent-voice -',
    'd /var/lib/teleagent-isolated-voice 0700 teleagent-voice teleagent-voice -',
    'd /var/lib/teleagent-isolated-voice-stack 0700 root root -',
    'd /run/teleagent-isolated-voice-stack 0700 root root -',
  ])) refuse('the tmpfiles directory contract drifted');
  if (JSON.stringify(meaningfulLines(slice)) !== JSON.stringify([
    '[Unit]',
    'Description=Aggregate resource boundary for Teleagent voice containers',
    'Documentation=file:/opt/teleagent/current/docs/PHONE-AGENT-ARCHITECTURE.md',
    'StopWhenUnneeded=yes',
    '[Slice]',
    'CPUAccounting=yes',
    'CPUQuota=300%',
    'CPUQuotaPeriodSec=100ms',
    'MemoryAccounting=yes',
    'MemoryHigh=2684354560',
    'MemoryMax=3221225472',
    'MemorySwapMax=0',
    'TasksAccounting=yes',
    'TasksMax=1024',
    'CPUWeight=50',
    'IOAccounting=yes',
    'IOWeight=50',
  ])) refuse('the aggregate voice-container slice contract drifted');
  if (/^\[Install\]$/mu.test(service) || /^\[Install\]$/mu.test(slice) ||
      /^Environment=.*(?:TOKEN|PASSWORD|SECRET|API_KEY|PRIVATE_KEY)=/imu.test(service)) {
    refuse('the voice unit became enableable or embeds a credential');
  }
  if (/[\u0000\r]/u.test(service)) {
    refuse('the voice unit contains a forbidden control byte');
  }
  if (/\\[^\S\r\n]*$/mu.test(service)) {
    refuse('the voice unit contains an unsupported line continuation');
  }
  if (/^(?:[^\S\r\n]+(?:Exec(?:Condition|StartPre|Start|StartPost|Reload|Stop|StopPost)|(?:LoadCredential|LoadCredentialEncrypted|SetCredential|SetCredentialEncrypted|ImportCredential|ImportCredentialEx))[^\S\r\n]*=|(?:Exec(?:Condition|StartPre|Start|StartPost|Reload|Stop|StopPost)|(?:LoadCredential|LoadCredentialEncrypted|SetCredential|SetCredentialEncrypted|ImportCredential|ImportCredentialEx))[^\S\r\n]+=)/mu
    .test(service)) {
    refuse('the voice unit contains noncanonical lifecycle or credential assignment whitespace');
  }
  const startCommands = service.split('\n').filter((line) => /^ExecStart(?:Pre)?=/u.test(line));
  const executionCommands = serviceDirectiveLines(
    service, EXECUTION_DIRECTIVE, 'an execution command',
  );
  const credentialDirectives = serviceDirectiveLines(
    service, CREDENTIAL_DIRECTIVE, 'a credential directive',
  );
  const expectedExecutionCommands = [
    RELEASE_START_GATE,
    RELEASE_START_COMMAND,
    RELEASE_STOP_COMMAND,
    RELEASE_CLEANUP_COMMAND,
  ];
  const releaseGateReferences = service.match(
    /\/usr\/local\/libexec\/verify-teleagent-release-closure/gu,
  ) ?? [];
  if (!sameLineMultiset(executionCommands, expectedExecutionCommands) ||
      !sameLineMultiset(credentialDirectives, [RELEASE_GATE_CREDENTIAL]) ||
      /^ExecCondition=/mu.test(service) || /^ExecReload=/mu.test(service) ||
      startCommands[0] !== RELEASE_START_GATE ||
      startCommands.filter((line) => line === RELEASE_START_GATE).length !== 1 ||
      releaseGateReferences.length !== 4 ||
      /^ExecStartPost=/mu.test(service) ||
      executionCommands.filter((line) => line.startsWith('ExecStop=')).length !== 1 ||
      executionCommands.filter((line) => line.startsWith('ExecStopPost=')).length !== 1 ||
      executionCommands.some((line) => line.includes('/opt/teleagent/current'))) {
    refuse('the trusted release start gate is absent, weakened, duplicated, or out of order');
  }
  if (/^ExecStartPre=\/usr\/local\/libexec\/verify-voice-stack-identity/mu.test(service)) {
    refuse('the voice start still resolves identity through mutable current');
  }
  exactlyOnce(service,
    /^ExecStart=\/usr\/bin\/python3 -I \/usr\/local\/libexec\/verify-teleagent-release-closure --start-component voice-stack-start \$\{CREDENTIALS_DIRECTORY\}\/teleagent-release-gate$/gmu,
    'the immutable start command');
  exactlyOnce(service,
    /^ExecStop=\/usr\/bin\/python3 -I \/usr\/local\/libexec\/verify-teleagent-release-closure --stop-voice-stack$/gmu,
    'the immutable stop command');
  exactlyOnce(service,
    /^ExecStopPost=\/usr\/bin\/python3 -I \/usr\/local\/libexec\/verify-teleagent-release-closure --cleanup-voice-stack$/gmu,
    'the serialized host-owned emergency cleanup command');
  exactlyOnce(service,
    /^LoadCredential=teleagent-release-gate:\/run\/teleagent-release-gate\/verified\.json$/gmu,
    'the release-gate credential');
  exactlyOnce(service, /^User=root$/gmu, 'the root orchestrator user');
  exactlyOnce(service, /^Group=root$/gmu, 'the root orchestrator group');
  exactlyOnce(service, /^Requires=teleagent-voice-containers\.slice$/gmu,
    'the aggregate voice-container slice dependency');
  if ((compose.match(/^    cgroup_parent: teleagent-voice-containers\.slice$/gmu) || []).length !== 4 ||
      (compose.match(/^      com\.teleagent\.voice\.activation-generation: /gmu) || []).length !== 4 ||
      (compose.match(/^\s+cgroup_parent:/gmu) || []).length !== 4 ||
      (compose.match(/^\s+com\.teleagent\.voice\.activation-generation:/gmu) || []).length !== 4) {
    refuse('the Compose aggregate cgroup/generation contract drifted');
  }
  const composeUsers = [
    '    user: "${VOICE_APP_UID:?VOICE_APP_UID must resolve teleagent-voice}:${VOICE_APP_GID:?VOICE_APP_GID must resolve teleagent-voice}"',
    '    user: "${DRACHTIO_UID:?DRACHTIO_UID must resolve teleagent-drachtio}:${DRACHTIO_GID:?DRACHTIO_GID must resolve teleagent-drachtio}"',
    '    user: "${FREESWITCH_UID:?FREESWITCH_UID must resolve teleagent-freeswitch}:${FREESWITCH_GID:?FREESWITCH_GID must resolve teleagent-freeswitch}"',
  ];
  const composeLines = compose.split('\n');
  if ((compose.match(/^    user: /gmu) || []).length !== 4 ||
      composeLines.filter((line) => line === composeUsers[0]).length !== 2 ||
      composeUsers.slice(1).some((line) =>
        composeLines.filter((candidate) => candidate === line).length !== 1) ||
      /^\s+group_add\s*:/mu.test(compose)) {
    refuse('the Compose split non-root identity contract drifted');
  }
  for (const dependency of [
    'teleagent-sip-local-peer-fence.service',
    'teleagent-agent-controller.service',
    'teleagent-worker-session.service',
    'teleagent-provider-model-apparmor.service',
  ]) {
    if (!service.includes(dependency)) refuse(`required unit dependency ${dependency} is absent`);
  }
  return true;
}

function parseDatabase(source, expectedFields, label) {
  const rows = [];
  for (const line of String(source).split('\n')) {
    if (!line || line.startsWith('#')) continue;
    const fields = line.split(':');
    if (fields.length !== expectedFields) refuse(`${label} contains a malformed record`);
    rows.push(fields);
  }
  return rows;
}

function uniqueNamed(rows, name, label) {
  const matches = rows.filter((fields) => fields[0] === name);
  if (matches.length !== 1) refuse(`${label} must contain exactly one ${name} record`);
  return matches[0];
}

function numericId(value, label) {
  if (!/^[0-9]+$/u.test(String(value))) refuse(`${label} is not numeric`);
  const result = Number(value);
  if (!Number.isSafeInteger(result)) refuse(`${label} is outside the safe integer range`);
  return result;
}

function validateIdentityRecords(passwdSource, groupSource) {
  const passwd = parseDatabase(passwdSource, 7, 'passwd');
  const groups = parseDatabase(groupSource, 4, 'group');
  const identities = {};
  const protectedUsers = new Set();
  const protectedGroups = new Set();
  for (const spec of IDENTITY_SPECS) {
    const user = uniqueNamed(passwd, spec.name, 'passwd');
    const group = uniqueNamed(groups, spec.name, 'group');
    const uid = numericId(user[2], `${spec.name} uid`);
    const gid = numericId(user[3], `${spec.name} primary gid`);
    const groupGid = numericId(group[2], `${spec.name} group gid`);
    if (uid <= 0 || gid <= 0 || uid > 2147483647 || gid > 2147483647 ||
        uid === 1000 || gid === 1000 || gid !== groupGid || user[5] !== spec.home ||
        !['/usr/sbin/nologin', '/sbin/nologin'].includes(user[6]) || group[3] !== '') {
      refuse(`the ${spec.name} account contract is unsafe`);
    }
    protectedUsers.add(user);
    protectedGroups.add(group);
    identities[spec.key] = Object.freeze({ name: spec.name, uid, gid });
  }

  const entries = Object.values(identities);
  for (let left = 0; left < entries.length; left += 1) {
    for (let right = left + 1; right < entries.length; right += 1) {
      if ([entries[right].uid, entries[right].gid].includes(entries[left].uid) ||
          [entries[right].uid, entries[right].gid].includes(entries[left].gid)) {
        refuse('the voice and media numeric identities are reused');
      }
    }
  }
  const protectedUids = new Set(entries.map(({ uid }) => uid));
  const protectedGids = new Set(entries.map(({ gid }) => gid));
  if (passwd.some((candidate) => !protectedUsers.has(candidate) && (
    protectedUids.has(numericId(candidate[2], 'passwd uid')) ||
    protectedGids.has(numericId(candidate[3], 'passwd gid'))
  )) || groups.some((candidate) => !protectedGroups.has(candidate) &&
    protectedGids.has(numericId(candidate[2], 'group gid')))) {
    refuse('a voice or media numeric identity is reused');
  }
  for (const spec of IDENTITY_SPECS) {
    if (groups.some((candidate) =>
      candidate[3].split(',').filter(Boolean).includes(spec.name))) {
      refuse(`${spec.name} has a stale supplementary group`);
    }
  }
  return Object.freeze(identities);
}

function runIdentityLookup(filename, args, label, { runCommand = spawnSync } = {}) {
  const result = runCommand(filename, args, {
    encoding: 'utf8',
    env: { PATH: '/usr/sbin:/usr/bin:/sbin:/bin', LANG: 'C', LC_ALL: 'C' },
    input: '',
    timeout: 5000,
    maxBuffer: 4096,
  });
  const output = String(result?.stdout || '');
  if (result?.error || result?.status !== 0 || Buffer.byteLength(output) > 4096 ||
      /\r|\0/u.test(output) || !output.endsWith('\n') || output.slice(0, -1).includes('\n')) {
    refuse(`the resolved ${label} is unavailable or ambiguous`);
  }
  return output.slice(0, -1);
}

function validateResolvedIdentityRecords(passwdSource, groupSource, options = {}) {
  const identities = validateIdentityRecords(passwdSource, groupSource);
  const passwd = parseDatabase(passwdSource, 7, 'passwd');
  const groups = parseDatabase(groupSource, 4, 'group');
  for (const spec of IDENTITY_SPECS) {
    const localPasswd = uniqueNamed(passwd, spec.name, 'passwd').join(':');
    const localGroup = uniqueNamed(groups, spec.name, 'group').join(':');
    const resolvedPasswd = runIdentityLookup(
      '/usr/bin/getent', ['passwd', spec.name], `${spec.name} passwd record`, options
    );
    const resolvedGroup = runIdentityLookup(
      '/usr/bin/getent', ['group', spec.name], `${spec.name} group record`, options
    );
    const resolvedGroups = runIdentityLookup(
      '/usr/bin/id', ['-G', spec.name], `${spec.name} supplementary groups`, options
    );
    if (resolvedPasswd !== localPasswd || resolvedGroup !== localGroup ||
        resolvedGroups !== String(identities[spec.key].gid)) {
      refuse(`the resolved ${spec.name} identity differs from the exact local database contract`);
    }
  }
  return identities;
}

function formatInstalledIdentities(identities) {
  return `${IDENTITY_SPECS.map((spec) => {
    const identity = identities?.[spec.key];
    if (!identity || identity.name !== spec.name || !Number.isSafeInteger(identity.uid) ||
        !Number.isSafeInteger(identity.gid)) {
      refuse('the installed identity authority result is incomplete');
    }
    return [spec.key, spec.name, identity.uid, identity.gid].join('\t');
  }).join('\n')}\n`;
}

function inspectPath(filename, { type, uid, gid, mode, nlink = null }) {
  const metadata = fs.lstatSync(filename);
  const correctType = type === 'directory' ? metadata.isDirectory() : metadata.isFile();
  if (metadata.isSymbolicLink() || !correctType || metadata.uid !== uid || metadata.gid !== gid ||
      (metadata.mode & 0o7777) !== mode || (nlink !== null && metadata.nlink !== nlink)) {
    refuse(`unsafe metadata for ${filename}`);
  }
  return metadata;
}

function inspectRootDatabase(filename) {
  const metadata = fs.lstatSync(filename);
  if (!metadata.isFile() || metadata.isSymbolicLink() || metadata.uid !== 0 ||
      (metadata.mode & 0o022) !== 0 || metadata.nlink !== 1 || metadata.size > 4 * 1024 * 1024) {
    refuse('the system identity database is unsafe');
  }
  return fs.readFileSync(filename, 'utf8');
}

function compareInstalledAssets(sourceRoot = SOURCE_ROOT) {
  for (const [sourceName, target, mode] of REVIEWED_ASSETS) {
    const source = path.join(sourceRoot, sourceName);
    inspectSourceAsset(source, { uid: 0, gid: 0, mode });
    inspectPath(target, { type: 'file', uid: 0, gid: 0, mode, nlink: 1 });
    if (!fs.readFileSync(source).equals(fs.readFileSync(target))) {
      refuse(`installed asset ${path.basename(target)} differs from reviewed source`);
    }
  }
}

function installedCheck({
  sourceRoot = SOURCE_ROOT,
  passwdPath = '/etc/passwd',
  groupPath = '/etc/group',
} = {}) {
  if (process.getuid() !== 0) refuse('the installed check requires root');
  sourceCheck(sourceRoot);
  const identities = validateIdentityRecords(
    inspectRootDatabase(passwdPath), inspectRootDatabase(groupPath)
  );
  const identity = identities.voice;
  compareInstalledAssets(sourceRoot);
  for (const [filename, uid, gid, mode] of [
    ['/etc/teleagent-isolated-voice', 0, 0, 0o700],
    ['/etc/teleagent-isolated-voice/config', 0, identity.gid, 0o750],
    ['/etc/teleagent-isolated-voice/credentials', 0, identity.gid, 0o750],
    ['/var/lib/teleagent-isolated-voice', identity.uid, identity.gid, 0o700],
    ['/var/lib/teleagent-isolated-voice-stack', 0, 0, 0o700],
    ['/run/teleagent-isolated-voice-stack', 0, 0, 0o700],
  ]) inspectPath(filename, { type: 'directory', uid, gid, mode });
  return identities;
}

function installedIdentityAuthority({
  sourceRoot = SOURCE_ROOT,
  passwdPath = '/etc/passwd',
  groupPath = '/etc/group',
  runCommand = spawnSync,
} = {}) {
  const checked = installedCheck({ sourceRoot, passwdPath, groupPath });
  const resolved = validateResolvedIdentityRecords(
    inspectRootDatabase(passwdPath), inspectRootDatabase(groupPath), { runCommand }
  );
  for (const spec of IDENTITY_SPECS) {
    if (checked[spec.key].uid !== resolved[spec.key].uid ||
        checked[spec.key].gid !== resolved[spec.key].gid) {
      refuse('the local identity database changed during installed identity resolution');
    }
  }
  return resolved;
}

function main() {
  const mode = process.argv[2];
  const hasPinnedRoot = process.argv.length === 5 && process.argv[3] === '--source-root';
  if ((!hasPinnedRoot && process.argv.length !== 3) ||
      !['--source-check', '--installed-check', '--installed-identities'].includes(mode)) {
    refuse('usage: verify-voice-stack-identity ' +
      '--source-check|--installed-check|--installed-identities ' +
      '[--source-root ABSOLUTE_COMPONENT_ROOT]');
  }
  const invoked = fs.realpathSync(process.argv[1]);
  const sourceBundle = hasPinnedRoot
    ? resolvePinnedSourceBundle(process.argv[4])
    : (mode === '--source-check' && invoked !== INSTALLED_VERIFIER
      ? resolvePinnedSourceBundle(path.dirname(invoked))
      : resolveSourceBundle());
  if (mode === '--installed-check' || mode === '--installed-identities') {
    if (invoked !== INSTALLED_VERIFIER) refuse('use the fixed installed verifier entrypoint');
    if (mode === '--installed-identities') {
      process.stdout.write(formatInstalledIdentities(installedIdentityAuthority({
        sourceRoot: sourceBundle.sourceRoot,
      })));
    } else {
      installedCheck({ sourceRoot: sourceBundle.sourceRoot });
      process.stdout.write('VOICE_STACK_IDENTITY_OK\n');
    }
  } else {
    if (invoked !== sourceBundle.verifierPath &&
        invoked !== INSTALLED_VERIFIER) {
      refuse('source check must use a reviewed fixed entrypoint');
    }
    sourceCheck(sourceBundle.sourceRoot);
    process.stdout.write('VOICE_STACK_SOURCE_OK\n');
  }
}

if (require.main === module) {
  try { main(); } catch (error) {
    process.stderr.write(`${error.message}\n`);
    process.exit(77);
  }
}

module.exports = {
  COLLISION_IDENTITIES,
  IDENTITY_SPECS,
  REVIEWED_ASSETS,
  inspectPath,
  inspectSourceAsset,
  formatInstalledIdentities,
  installedIdentityAuthority,
  resolveSourceBundle,
  resolvePinnedSourceBundle,
  sourceCheck,
  validateIdentityRecords,
  validateResolvedIdentityRecords,
};
