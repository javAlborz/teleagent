[Unit]
Description=Aggregate resource boundary for Teleagent voice containers
Documentation=file:/opt/teleagent/current/docs/PHONE-AGENT-ARCHITECTURE.md
StopWhenUnneeded=yes

[Slice]
CPUAccounting=yes
CPUQuota=300%
CPUQuotaPeriodSec=100ms
MemoryAccounting=yes
MemoryHigh=2684354560
MemoryMax=3221225472
MemorySwapMax=0
TasksAccounting=yes
TasksMax=1024
CPUWeight=50
IOAccounting=yes
IOWeight=50

# Deliberately dormant and non-enableable. The guarded voice unit activates
# this parent only while Docker creates the four reviewed Compose containers.
