[Unit]
StopWhenUnneeded=no
Description=Aggregate resource boundary for the Teleagent provider plane
ConditionPathExists=/etc/teleagent/worker-session/ENABLE

[Slice]
CPUAccounting=yes
CPUQuota=250%
CPUQuotaPeriodSec=100ms
MemoryAccounting=yes
MemoryHigh=4831838208
MemoryMax=5368709120
MemorySwapMax=0
TasksAccounting=yes
TasksMax=1024
CPUWeight=25
IOAccounting=yes
IOWeight=25

# Deliberately dormant and non-enableable. Provider supervisors, credential
# egress services, and the tighter child model slice are assigned here.
