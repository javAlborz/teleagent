      record.version !== 1 || !LAUNCH_ID.test(record.launchId || '') ||
      !Number.isSafeInteger(record.pid) || record.pid <= 0 ||
      !/^[1-9][0-9]*$/u.test(record.startTime || '') ||
      source !== `${JSON.stringify(record)}\n`) {
