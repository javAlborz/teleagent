  const startTime = readStartTime(pid);
  if (startTime === null) fail('global provider launch lock owner is unavailable');
  const record = Object.freeze({ version: 1, launchId, pid, startTime });
  const serialized = Buffer.from(`${JSON.stringify(record)}\n`, 'utf8');
  const filename = globalLaunchLockPath(directory);
  const temporary = path.join(
    directory,
    `${GLOBAL_LAUNCH_LOCK}.tmp.${pid}.${crypto.randomBytes(16).toString('hex')}`
  );
