const LAUNCH_ID = /^launch_[a-f0-9]{32}$/;
const TASK_ID = /^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$/;
const SAFE_MODEL = /^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$/;
const PROVIDER_ROUTE_KINDS = Object.freeze({
