const PROVIDER_PLANE_PARENT = path.dirname(PROVIDER_PLANE_ROOT);
const ACTIVATION_MODE_FILE = '/etc/teleagent/provider-runtime/enabled-providers';
const PROVIDER_PLANE_HOMES = Object.freeze({
