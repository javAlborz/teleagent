function readEnabledProviders({ filesystem = fs } = {}) {
  let descriptor;
  try {
    const noFollow = filesystem.constants?.O_NOFOLLOW ?? fs.constants.O_NOFOLLOW;
    if (!Number.isInteger(noFollow)) fail('provider activation mode no-follow access is unavailable');
    descriptor = filesystem.openSync(ACTIVATION_MODE_FILE, fs.constants.O_RDONLY | noFollow);
    const before = filesystem.fstatSync(descriptor);
    const value = filesystem.readFileSync(descriptor);
    const after = filesystem.fstatSync(descriptor);
    const fields = ['dev', 'ino', 'mode', 'uid', 'gid', 'nlink', 'size', 'mtimeMs', 'ctimeMs'];
    if (!before.isFile() || before.isSymbolicLink?.() ||
        before.uid !== 0 || before.gid !== 0 || before.nlink !== 1 ||
        (before.mode & 0o7777) !== 0o444 || before.size > 32 ||
        fields.some((field) => before[field] !== after[field])) {
      fail('provider activation mode metadata is unsafe');
    }
    if (value.equals(Buffer.from('codex\n'))) return ['codex'];
    if (value.equals(Buffer.from('claude,codex\n'))) return ['claude', 'codex'];
    fail('provider activation mode is invalid');
  } catch (error) {
    if (error?.exitCode === 77) throw error;
    fail('provider activation mode is unavailable');
  } finally {
    if (descriptor !== undefined) filesystem.closeSync(descriptor);
  }
}

function assertProviderEnabled(provider, { readProviders = readEnabledProviders } = {}) {
  if (!PROVIDERS[provider] || !readProviders().includes(provider)) {
    fail('provider is disabled by the root activation mode', 75);
  }
  return true;
}
const FORBIDDEN_WORKSPACE_FILE = /^(?:\.env(?!\.example$)|auth\.json|\.credentials\.json|kubeconfig|id_(?:rsa|ed25519)|credentials?|secrets?|tokens?|passwords?)(?:\..*)?$/i;
const MAX_WORKSPACE_ENTRIES = 50_000;
const MIN_WORKSPACE_FREE_BYTES = 2n * 1024n * 1024n * 1024n;
const MAX_WORKSPACE_FILESYSTEM_BYTES = 64n * 1024n * 1024n * 1024n;
const MIN_PROVIDER_PLANE_CAPACITY_BYTES = 1n * 1024n * 1024n * 1024n;
const MAX_PROVIDER_PLANE_CAPACITY_BYTES = 4n * 1024n * 1024n * 1024n;
const MIN_PROVIDER_PLANE_FREE_BYTES = 512n * 1024n * 1024n;
const DURABLE_LOCAL_FILESYSTEMS = new Set([
  0xef53n, // ext2/3/4
  0x58465342n, // XFS
  0x9123683en, // Btrfs
  0xf2f52010n, // F2FS
  0x2fc12fc1n, // ZFS
]);
const WORKSPACE_STORAGE_ATTESTATION = 'PROVIDER_WORKSPACE_STORAGE_OK';
const PROVIDER_PLANE_STORAGE_ATTESTATION = 'PROVIDER_PLANE_STORAGE_OK';
const WORKER_STORAGE_ATTESTATION = 'PROVIDER_WORKER_STORAGE_OK';
const IMMUTABLE_RELEASE_ROOT = /^\/opt\/teleagent\/releases\/sha256-[a-f0-9]{64}$/;
const IMMUTABLE_PREFLIGHT_RELATIVE = 'deploy/worker-session/teleagent-provider-boundary';
const HANDOFF_LOCK = '/run/teleagent-staging-handoff.lock';
const LIFECYCLE_LOCK_ENV = 'TELEAGENT_HANDOFF_LIFECYCLE_LOCK_FD';
const ROOT_STOP_ENVIRONMENT = Object.freeze({
  HOME: '/var/empty',
  PATH: '/usr/sbin:/usr/bin:/sbin:/bin',
  LANG: 'C.UTF-8',
  LC_ALL: 'C.UTF-8',
});

function fail(message, code = 77) {
  const error = Object.assign(new Error(message), { exitCode: code });
  throw error;
}

function requireImmutablePreflight({
  environment = process.env,
  filesystem = fs,
  executable = process.execPath,
  invokedScript = process.argv[1],
  execArguments = process.execArgv,
  uid = process.geteuid(),
} = {}) {
  const releaseRoot = environment.TELEAGENT_RELEASE_ROOT;
  const descriptorValue = environment[LIFECYCLE_LOCK_ENV];
  if (uid !== 0 || !IMMUTABLE_RELEASE_ROOT.test(releaseRoot || '') ||
      !/^(?:[3-9]|[1-9][0-9]+)$/.test(descriptorValue || '') ||
      !Array.isArray(execArguments) || execArguments.length !== 0) {
    fail('the provider preflight requires one gated immutable release and retained lock');
  }
  const descriptor = Number.parseInt(descriptorValue, 10);
  if (!Number.isSafeInteger(descriptor) || descriptor > 1_000_000) {
    fail('the provider preflight lock descriptor is invalid');
  }
  const expectedNode = `${releaseRoot}/runtime/node/bin/node`;
  const expectedScript = `${releaseRoot}/${IMMUTABLE_PREFLIGHT_RELATIVE}`;
  let descriptorMetadata;
  let pathMetadata;
  try {
    if (filesystem.realpathSync(executable) !== expectedNode ||
        filesystem.realpathSync(invokedScript || '') !== expectedScript) {
      fail('the provider preflight executable escaped the immutable release');
    }
    descriptorMetadata = filesystem.fstatSync(descriptor);
    pathMetadata = filesystem.lstatSync(HANDOFF_LOCK);
  } catch (error) {
    if (error?.exitCode === 77) throw error;
    fail('the provider preflight executable or retained lock is unavailable');
  }
  if (!descriptorMetadata.isDirectory() || !pathMetadata.isDirectory() ||
      descriptorMetadata.dev !== pathMetadata.dev || descriptorMetadata.ino !== pathMetadata.ino ||
      pathMetadata.uid !== 0 || pathMetadata.gid !== 0 ||
      (pathMetadata.mode & 0o7777) !== 0o700) {
    fail('the provider preflight lock identity is unsafe');
  }
  delete environment[LIFECYCLE_LOCK_ENV];
  return descriptor;
}

function take(options, name, required = true) {
  const matches = options.flatMap((value, index) => value === name ? [index] : []);
  if (matches.length === 0 && !required) return null;
  if (matches.length !== 1 || matches[0] + 1 >= options.length) fail(`${name} is invalid`);
  const index = matches[0];
  const value = options[index + 1];
  options.splice(index, 2);
  return value;
}

function syncDirectory(directory) {
  const descriptor = fs.openSync(directory, fs.constants.O_RDONLY | fs.constants.O_DIRECTORY);
  try { fs.fsyncSync(descriptor); }
  finally { fs.closeSync(descriptor); }
}

function requirePinnedProviderCli(provider, { spawnCheck = spawnSync } = {}) {
  const result = spawnCheck(CLI_CHECK, ['--provider', provider], {
    cwd: '/',
    encoding: 'utf8',
    timeout: 15000,
    maxBuffer: 4096,
    env: { PATH: '/usr/sbin:/usr/bin:/sbin:/bin', LANG: 'C.UTF-8', LC_ALL: 'C.UTF-8' },
    stdio: ['ignore', 'pipe', 'pipe'],
  });
  if (result.error || result.status !== 0 || result.signal ||
      result.stdout.trim() !== `PROVIDER_CLI_OK ${provider}`) {
    fail('the pinned provider CLI failed its launch-time gate', 75);
  }
}

function persistGlobalProviderPanic() {
  validateProviderPlaneStorageBoundary({ requireReserve: false, requireHomes: false });
  secureRootDirectory(GLOBAL_PANIC_DIRECTORY, 0o022, 0);
  try {
    const metadata = fs.lstatSync(GLOBAL_PANIC_FILE);
    if (!metadata.isFile() || metadata.isSymbolicLink() || metadata.uid !== 0 ||
        (metadata.mode & 0o077) !== 0) fail('global provider panic state is unsafe');
    return { persisted: true, alreadyLocked: true };
  } catch (error) {
    if (error?.code !== 'ENOENT') throw error;
  }
  const descriptor = fs.openSync(
    GLOBAL_PANIC_FILE,
    fs.constants.O_WRONLY | fs.constants.O_CREAT | fs.constants.O_EXCL |
      fs.constants.O_NOFOLLOW,
    0o600
  );
  try {
    fs.writeFileSync(descriptor, `${JSON.stringify({
      version: 1,
      locked: true,
      reason: 'provider_plane_root_panic',
      lockedAt: new Date().toISOString(),
    })}\n`);
    fs.fsyncSync(descriptor);
  } finally {
    fs.closeSync(descriptor);
  }
  syncDirectory(GLOBAL_PANIC_DIRECTORY);
  return { persisted: true, alreadyLocked: false };
}

function rootStateFileExists(filename, label) {
  try {
    const metadata = fs.lstatSync(filename);
    if (!metadata.isFile() || metadata.isSymbolicLink() || metadata.uid !== 0 ||
        (metadata.mode & 0o077) !== 0) fail(`global provider ${label} state is unsafe`);
    return true;
  } catch (error) {
    if (error?.code === 'ENOENT') return false;
    throw error;
  }
}

function globalProviderRecoveryPending() {
  return rootStateFileExists(GLOBAL_RECOVERY_FILE, 'recovery');
}

function globalProviderPanicLocked() {
  // A stranded recovery transaction is itself a lock. This makes every crash
  // between supervisor restart and the final panic-file unlink fail closed.
  return rootStateFileExists(GLOBAL_PANIC_FILE, 'panic') || globalProviderRecoveryPending();
}

function persistGlobalProviderRecovery() {
  validateProviderPlaneStorageBoundary({ requireReserve: false, requireHomes: false });
  secureRootDirectory(GLOBAL_PANIC_DIRECTORY, 0o022, 0);
  if (globalProviderRecoveryPending()) return { persisted: true, alreadyPending: true };
  const descriptor = fs.openSync(
    GLOBAL_RECOVERY_FILE,
    fs.constants.O_WRONLY | fs.constants.O_CREAT | fs.constants.O_EXCL |
      fs.constants.O_NOFOLLOW,
    0o600
  );
  try {
    fs.writeFileSync(descriptor, `${JSON.stringify({
      version: 1,
      pending: true,
      reason: 'provider_plane_root_recovery',
      startedAt: new Date().toISOString(),
    })}\n`);
    fs.fsyncSync(descriptor);
  } finally {
    fs.closeSync(descriptor);
  }
  syncDirectory(GLOBAL_PANIC_DIRECTORY);
  return { persisted: true, alreadyPending: false };
}

function clearGlobalProviderRecovery() {
  if (!globalProviderRecoveryPending()) return { persisted: true, wasPending: false };
  fs.unlinkSync(GLOBAL_RECOVERY_FILE);
  syncDirectory(GLOBAL_PANIC_DIRECTORY);
  return { persisted: true, wasPending: true };
}

function clearGlobalProviderPanic() {
  if (!rootStateFileExists(GLOBAL_PANIC_FILE, 'panic')) {
    return { persisted: true, wasLocked: false };
  }
  fs.unlinkSync(GLOBAL_PANIC_FILE);
  syncDirectory(GLOBAL_PANIC_DIRECTORY);
  return { persisted: true, wasLocked: true };
}

function deriveProviderLaunchPolicy(provider, providerArgs) {
  const modelIndexes = providerArgs.flatMap((value, index) => value === '--model' ? [index] : []);
  if (modelIndexes.length !== 1 || modelIndexes[0] + 1 >= providerArgs.length) {
    fail('provider launch requires one exact model');
  }
  const model = providerArgs[modelIndexes[0] + 1];
  if (!SAFE_MODEL.test(model || '')) fail('provider launch model is invalid');
  if (!PROVIDER_MODELS[provider]?.includes(model)) {
    fail('provider launch model is not an approved canonical ID');
  }
  let reasoningEffort = REASONING_EFFORT_BY_MODEL[model];
  if (provider === 'claude') {
    if (providerArgs.includes('--effort')) {
      fail('Claude launch effort is fixed by the captured model contract');
    }
  } else {
    const effortValues = providerArgs.flatMap((value, index) => {
      if (!['-c', '--config'].includes(value)) return [];
      const match = String(providerArgs[index + 1] || '').match(
        /^model_reasoning_effort="(none|low|medium|high|xhigh|max|ultra)"$/
      );
      return match ? [match[1]] : [];
    });
    if (effortValues.length !== 1 || effortValues[0] !== reasoningEffort) {
      fail('Codex launch reasoning effort does not match the canonical model tier');
    }
  }
  return {
    model,
    reasoningEffort,
    routeKinds: PROVIDER_ROUTE_KINDS[provider],
  };
}

function readStableBoundedFile(filename, maxBytes = 1024 * 1024) {
  let descriptor;
  try {
    descriptor = fs.openSync(
      filename,
      fs.constants.O_RDONLY | (fs.constants.O_NOFOLLOW || 0)
    );
    const before = fs.fstatSync(descriptor, { bigint: true });
    if (!before.isFile() || (before.mode & 0o6000n) !== 0n ||
        before.size < 0n || before.size > BigInt(maxBytes)) {
      fail('provider workspace configuration exceeds the bounded regular-file contract');
    }
    const chunks = [];
    const buffer = Buffer.allocUnsafe(64 * 1024);
    let total = 0;
    for (;;) {
      const count = fs.readSync(descriptor, buffer, 0, buffer.length, null);
      if (count === 0) break;
      total += count;
      if (total > maxBytes) fail('provider workspace configuration changed while reading');
      chunks.push(Buffer.from(buffer.subarray(0, count)));
    }
    const after = fs.fstatSync(descriptor, { bigint: true });
    if (before.dev !== after.dev || before.ino !== after.ino || before.size !== after.size ||
        before.mode !== after.mode || before.uid !== after.uid || before.gid !== after.gid ||
        before.nlink !== after.nlink || before.mtimeNs !== after.mtimeNs ||
        before.ctimeNs !== after.ctimeNs || BigInt(total) !== before.size) {
      fail('provider workspace configuration changed while reading');
    }
    return Buffer.concat(chunks, total).toString('utf8');
  } finally {
    if (descriptor !== undefined) fs.closeSync(descriptor);
  }
}

function validateProviderWorkspace(workspace) {
  let visited = 0;
  const pending = [workspace];
  while (pending.length) {
    const directory = pending.pop();
    let entries;
    try { entries = fs.readdirSync(directory, { withFileTypes: true }); }
    catch { fail('provider workspace cannot be safely enumerated'); }
    for (const entry of entries) {
      if ((visited += 1) > MAX_WORKSPACE_ENTRIES) {
        fail('provider workspace exceeds the reviewed file bound');
      }
      const filename = path.join(directory, entry.name);
      let metadata;
      try { metadata = fs.lstatSync(filename); }
      catch { fail('provider workspace changed during validation'); }
      if (metadata.isSymbolicLink() || metadata.isSocket() || metadata.isFIFO() ||
          metadata.isBlockDevice() || metadata.isCharacterDevice() ||
          (!metadata.isFile() && !metadata.isDirectory()) || (metadata.mode & 0o6000) !== 0) {
        fail('provider workspace contains a forbidden file type');
      }
      if (metadata.isDirectory()) {
        pending.push(filename);
        continue;
      }
      if (FORBIDDEN_WORKSPACE_FILE.test(entry.name)) {
        fail('provider workspace contains credential material');
      }
      if (path.relative(workspace, filename) === path.join('.git', 'config')) {
        const gitConfig = readStableBoundedFile(filename);
        if (/extraheader|credential\s*=|credential[.]helper|https?:\/\/[^\s/@:]+:[^\s/@]+@|(?:token|password|secret)\s*=/i.test(gitConfig)) {
          fail('provider workspace git configuration contains credentials');
        }
      }
    }
  }
  return { safe: true, entries: visited };
}

function resolveWorkspaceGroupGid({ lookup = spawnSync } = {}) {
  const result = lookup(GETENT, ['group', WORKSPACE_GROUP], {
    cwd: '/',
    encoding: 'utf8',
    timeout: 5000,
    maxBuffer: 4096,
    env: { PATH: '/usr/sbin:/usr/bin:/sbin:/bin', LANG: 'C.UTF-8', LC_ALL: 'C.UTF-8' },
    stdio: ['ignore', 'pipe', 'pipe'],
  });
  const lines = String(result?.stdout || '').trim().split('\n');
  const fields = lines.length === 1 ? lines[0].split(':') : [];
  const gid = fields.length === 4 && fields[0] === WORKSPACE_GROUP && /^[0-9]+$/.test(fields[2])
    ? Number(fields[2])
    : NaN;
  if (result?.error || result?.status !== 0 || result?.signal ||
      !Number.isSafeInteger(gid) || gid <= 0 || gid >= 0xffffffff) {
    fail('the provider workspace group identity is unavailable or unsafe');
  }
  return gid;
}

function validateWorkspaceAnchor(workspace, {
  lstat = fs.lstatSync,
  realpath = fs.realpathSync,
  expectedUid = 0,
  expectedGid = null,
} = {}) {
  if (workspace !== FIXED_WORKSPACE) {
    fail('provider launches require the exact root-provisioned workspace anchor');
  }
  const ancestor = lstat(WORKSPACE_PARENT);
  const parent = lstat(WORKSPACE_ROOT);
  const selected = lstat(FIXED_WORKSPACE);
  const requiredGid = expectedGid === null ? resolveWorkspaceGroupGid() : expectedGid;
  if (!ancestor.isDirectory() || ancestor.isSymbolicLink() ||
      ancestor.uid !== expectedUid || (ancestor.mode & 0o022) !== 0 ||
      realpath(WORKSPACE_PARENT) !== WORKSPACE_PARENT ||
      !parent.isDirectory() || parent.isSymbolicLink() || parent.uid !== expectedUid ||
      parent.gid !== requiredGid || (parent.mode & 0o7777) !== 0o751 ||
      realpath(WORKSPACE_ROOT) !== WORKSPACE_ROOT || !selected.isDirectory() ||
      selected.isSymbolicLink() || selected.uid !== expectedUid ||
      selected.gid !== requiredGid || requiredGid <= 0 ||
      (selected.mode & 0o7777) !== 0o2770 || realpath(FIXED_WORKSPACE) !== FIXED_WORKSPACE) {
    fail('the root-provisioned provider workspace anchor is replaceable or unsafe');
  }
  return { workspace: FIXED_WORKSPACE, gid: requiredGid };
}

function validateWorkspaceStorageBoundary(directory = WORKSPACE_ROOT, {
  stat = (filename) => fs.statSync(filename, { bigint: true }),
  statfs = (filename) => fs.statfsSync(filename, { bigint: true }),
} = {}) {
  if (directory !== WORKSPACE_ROOT) {
    fail('provider workspaces require the exact dedicated mountpoint');
  }
  let parentMetadata;
  let workspaceMetadata;
  let storage;
  try {
    parentMetadata = stat(WORKSPACE_PARENT);
    workspaceMetadata = stat(directory);
    storage = statfs(directory);
  } catch {
    fail('provider workspace storage boundary cannot be inspected');
  }
  if (parentMetadata.dev === workspaceMetadata.dev) {
    fail('provider workspaces require an exact dedicated filesystem mountpoint');
  }
  const blockSize = BigInt(storage.bsize);
  const totalBytes = blockSize * BigInt(storage.blocks);
  const freeBytes = blockSize * BigInt(storage.bavail);
  if (totalBytes <= MIN_WORKSPACE_FREE_BYTES ||
      totalBytes > MAX_WORKSPACE_FILESYSTEM_BYTES ||
      freeBytes < MIN_WORKSPACE_FREE_BYTES) {
    fail('provider workspace filesystem size or free-space boundary is unsafe');
  }
  return { totalBytes, freeBytes, device: workspaceMetadata.dev };
}

function attestWorkspaceStorageBoundary({
  validateStorage = validateWorkspaceStorageBoundary,
} = {}) {
  validateStorage(WORKSPACE_ROOT);
  return WORKSPACE_STORAGE_ATTESTATION;
}

function resolveProviderPlaneIdentities({ lookup = spawnSync } = {}) {
  const identities = {};
  for (const provider of Object.keys(PROVIDER_PLANE_HOMES)) {
    const name = `teleagent-${provider}-supervisor`;
    const options = {
      cwd: '/',
      encoding: 'utf8',
      timeout: 5000,
      maxBuffer: 4096,
      env: { PATH: '/usr/sbin:/usr/bin:/sbin:/bin', LANG: 'C.UTF-8', LC_ALL: 'C.UTF-8' },
      stdio: ['ignore', 'pipe', 'pipe'],
    };
    const passwdResult = lookup(GETENT, ['passwd', name], options);
    const groupResult = lookup(GETENT, ['group', name], options);
    const passwdLines = String(passwdResult?.stdout || '').trim().split('\n');
    const groupLines = String(groupResult?.stdout || '').trim().split('\n');
    const passwd = passwdLines.length === 1 ? passwdLines[0].split(':') : [];
    const group = groupLines.length === 1 ? groupLines[0].split(':') : [];
    const uid = passwd.length === 7 && passwd[0] === name && /^[0-9]+$/.test(passwd[2])
      ? Number(passwd[2])
      : NaN;
    const primaryGid = passwd.length === 7 && /^[0-9]+$/.test(passwd[3])
      ? Number(passwd[3])
      : NaN;
    const gid = group.length === 4 && group[0] === name && /^[0-9]+$/.test(group[2])
      ? Number(group[2])
      : NaN;
    if (passwdResult?.error || passwdResult?.status !== 0 || passwdResult?.signal ||
        groupResult?.error || groupResult?.status !== 0 || groupResult?.signal ||
        !Number.isSafeInteger(uid) || uid <= 0 || uid >= 0xffffffff ||
        !Number.isSafeInteger(gid) || gid <= 0 || gid >= 0xffffffff ||
        primaryGid !== gid || passwd[5] !== PROVIDER_PLANE_HOMES[provider] ||
        !['/usr/sbin/nologin', '/sbin/nologin'].includes(passwd[6])) {
      fail('a provider supervisor storage identity is unavailable or unsafe');
    }
    identities[provider] = Object.freeze({ uid, gid });
  }
  return Object.freeze(identities);
}

function validateProviderPlaneStorageBoundary({
  requireReserve = true,
  requireHomes = true,
  identities = null,
  lookup = spawnSync,
  lstat = fs.lstatSync,
  stat = (filename) => fs.statSync(filename, { bigint: true }),
  statfs = (filename) => fs.statfsSync(filename, { bigint: true }),
  realpath = fs.realpathSync,
} = {}) {
  const expected = requireHomes
    ? (identities || resolveProviderPlaneIdentities({ lookup }))
    : null;
  let parent;
  let root;
  let parentDevice;
  let rootDevice;
  let storage;
  const homes = {};
  const homeDevices = {};
  try {
    parent = lstat(PROVIDER_PLANE_PARENT);
    root = lstat(PROVIDER_PLANE_ROOT);
    parentDevice = stat(PROVIDER_PLANE_PARENT);
    rootDevice = stat(PROVIDER_PLANE_ROOT);
    storage = statfs(PROVIDER_PLANE_ROOT);
    if (requireHomes) {
      for (const [provider, directory] of Object.entries(PROVIDER_PLANE_HOMES)) {
