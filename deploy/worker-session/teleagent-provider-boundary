    fd = fs.openSync(
      filename,
      fs.constants.O_WRONLY | fs.constants.O_CREAT | fs.constants.O_EXCL |
        fs.constants.O_NOFOLLOW,
      0o600
    );
    fs.writeFileSync(fd, `${capability}\n`, 'utf8');
    fs.fsyncSync(fd);
  } finally {
    if (fd !== undefined) fs.closeSync(fd);
  }
  fsyncDirectory(CAPABILITY_DIRECTORY);
  return filename;
}

function removeCapabilityFile(filename) {
  if (!filename || path.dirname(filename) !== CAPABILITY_DIRECTORY) return;
  try { fs.unlinkSync(filename); }
  catch (error) {
    if (error?.code !== 'ENOENT') throw error;
  }
  fsyncDirectory(CAPABILITY_DIRECTORY);
}

function removeReadinessFile(filename, directory = CAPABILITY_DIRECTORY) {
  if (!filename || path.dirname(filename) !== directory ||
      !filename.endsWith('.provider-readiness.jsonl')) return;
  try { fs.unlinkSync(filename); }
  catch (error) {
    if (error?.code !== 'ENOENT') throw error;
  }
  fsyncDirectory(directory);
}

function processStarttime(pid) {
  if (!Number.isSafeInteger(pid) || pid <= 1) return null;
  let serialized;
  try { serialized = fs.readFileSync(`/proc/${pid}/stat`, 'utf8'); }
  catch { return null; }
  const close = serialized.lastIndexOf(')');
  if (close < 0) return null;
  const fields = serialized.slice(close + 2).trim().split(/\s+/);
  return /^[0-9]+$/.test(fields[19] || '') ? fields[19] : null;
}

function processControlGroup(pid) {
  try {
    const line = fs.readFileSync(`/proc/${pid}/cgroup`, 'utf8')
      .split('\n').find((candidate) => candidate.startsWith('0::'));
    return line ? line.slice(3) : null;
  } catch { return null; }
}

function inspectProviderReadiness(provider, launchId, unitStatus, {
  directory = CAPABILITY_DIRECTORY,
  uid = 0,
  starttime = processStarttime,
  controlGroup = processControlGroup,
} = {}) {
  const filename = readinessFilePath(provider, launchId, directory);
  let metadata;
  try { metadata = fs.lstatSync(filename); }
  catch (error) {
    if (error?.code === 'ENOENT') {
      // Distinguish one absent record from a missing/unsafe parent boundary.
      secureRootDirectory(directory, 0o022, uid);
      throw Object.assign(new Error('provider readiness evidence is missing'), {
        code: 'PROVIDER_READINESS_MISSING', exitCode: 77,
      });
    }
    throw error;
  }
  if (!metadata.isFile() || metadata.isSymbolicLink() || metadata.uid !== uid ||
      (metadata.mode & 0o077) !== 0 || metadata.size > 512 ||
      fs.realpathSync(filename) !== filename) fail('provider readiness evidence is unsafe');
  let records;
  try {
    const serialized = fs.readFileSync(filename, 'utf8');
    if (!serialized.endsWith('\n')) throw new Error('partial readiness record');
    records = serialized.trimEnd().split('\n').map((line) => JSON.parse(line));
  }
  catch { fail('provider readiness evidence is invalid'); }
  const planned = records[0];
  if (planned?.version !== 1 || planned.type !== 'provider_planned' ||
      planned.provider !== provider || planned.launchId !== launchId ||
      records.length < 1 || records.length > 3) {
    fail('provider readiness evidence is invalid');
  }
  if (records.length === 1) {
    return {
      providerExecutionAttempted: false,
      providerSpawnedEver: false,
      providerAlive: false,
    };
  }
  const intent = records[1];
  if (intent?.version !== 1 || intent.type !== 'provider_start_intent' ||
      intent.provider !== provider || intent.launchId !== launchId) {
    fail('provider readiness evidence is invalid');
  }
  if (records.length === 2) {
    return {
      providerExecutionAttempted: true,
      providerSpawnedEver: false,
      providerAlive: false,
    };
  }
  const marker = records[2];
  const verifiedIdentity = Number.isSafeInteger(marker?.pid) && marker.pid > 1 &&
    /^[0-9]+$/.test(String(marker.starttime || '')) && marker.identityUnavailable !== true;
  const unavailableIdentity = marker?.identityUnavailable === true &&
    marker.pid === undefined && marker.starttime === undefined;
  if (marker?.version !== 1 || marker.type !== 'provider_spawned' ||
      marker.provider !== provider || marker.launchId !== launchId ||
      (!verifiedIdentity && !unavailableIdentity)) {
    fail('provider readiness evidence is invalid');
  }
  const live = verifiedIdentity && unitStatus?.quiesced !== true && Boolean(unitStatus?.controlGroup) &&
    starttime(marker.pid) === String(marker.starttime) &&
    controlGroup(marker.pid) === unitStatus.controlGroup;
  return {
    providerExecutionAttempted: true,
    providerSpawnedEver: true,
    providerAlive: live,
    providerIdentityVerified: verifiedIdentity,
    providerPid: verifiedIdentity ? marker.pid : null,
    providerStarttime: verifiedIdentity ? String(marker.starttime) : null,
  };
}

function purgeProviderReadinessArtifacts(provider, {
  directory = CAPABILITY_DIRECTORY,
  uid = 0,
} = {}) {
  secureRootDirectory(directory, 0o022, uid);
  const entries = fs.readdirSync(directory, { withFileTypes: true });
  let removed = 0;
  for (const entry of entries) {
    const match = entry.name.match(
      /^(claude|codex)\.(launch_[a-f0-9]{32})\.provider-readiness\.jsonl$/
    );
    if (!match) continue;
    if (match[1] !== provider) continue;
    const filename = path.join(directory, entry.name);
    const metadata = fs.lstatSync(filename);
    if (!entry.isFile() || metadata.isSymbolicLink() || metadata.uid !== uid ||
        (metadata.mode & 0o077) !== 0 || metadata.size > 512 ||
        fs.realpathSync(filename) !== filename) {
      fail('provider readiness evidence is unsafe');
    }
    let records;
    try {
      const serialized = fs.readFileSync(filename, 'utf8');
      if (!serialized.endsWith('\n')) throw new Error('partial readiness record');
      records = serialized.trimEnd().split('\n').map((line) => JSON.parse(line));
    }
    catch { fail('provider readiness evidence is invalid'); }
    const planned = records[0];
    const intent = records[1];
    const spawned = records[2];
    if (records.length < 1 || records.length > 3 || planned?.version !== 1 ||
        planned.type !== 'provider_planned' || planned.provider !== match[1] ||
        planned.launchId !== match[2] || (intent && (
          intent.version !== 1 || intent.type !== 'provider_start_intent' ||
          intent.provider !== match[1] || intent.launchId !== match[2]
        )) || (spawned && (
          spawned.version !== 1 || spawned.type !== 'provider_spawned' ||
          spawned.provider !== match[1] || spawned.launchId !== match[2]
        ))) {
      fail('provider readiness evidence is invalid');
    }
    removeReadinessFile(filename, directory);
    removed += 1;
  }
  return removed;
}

function providerControl(input, { timeoutMs = 5000, socketPath = null } = {}) {
  const spec = PROVIDERS[input.provider];
  if (!spec) return Promise.reject(new Error('provider control identity is invalid'));
  const action = String(input.action || '');
  const route = action === 'register'
    ? '/v1/control/register'
    : action === 'recover'
      ? '/v1/control/recover'
      : action === 'budget'
        ? '/v1/control/budget'
        : '/v1/control/revoke';
  const method = action === 'budget' ? 'GET' : 'POST';
  const body = method === 'POST' ? Buffer.from(JSON.stringify({
    version: 1,
    provider: input.provider,
    ...(input.launchId ? { launchId: input.launchId } : {}),
    ...(input.capability ? { capability: input.capability } : {}),
    ...(input.expiresAtMs ? { expiresAtMs: input.expiresAtMs } : {}),
    ...(input.maxRequests ? { maxRequests: input.maxRequests } : {}),
    ...(input.maxReservedTokens ? { maxReservedTokens: input.maxReservedTokens } : {}),
    ...(action === 'register' ? {
      model: input.model,
      reasoningEffort: input.reasoningEffort,
      routeKinds: input.routeKinds,
      mode: input.mode,
    } : {}),
    ...(input.reason ? { reason: input.reason } : {}),
  })) : null;
  return new Promise((resolve, reject) => {
    const request = http.request({
      socketPath: socketPath || spec.egressControlSocket,
      method,
      path: route,
      headers: body ? {
        'content-type': 'application/json',
        'content-length': body.length,
      } : {},
      timeout: timeoutMs,
    }, (response) => {
      const chunks = [];
      let bytes = 0;
      response.on('data', (chunk) => {
        bytes += chunk.length;
        if (bytes > 128 * 1024) request.destroy(new Error('provider control response exceeded bound'));
        else chunks.push(chunk);
      });
      response.once('end', () => {
        let value;
        try { value = JSON.parse(Buffer.concat(chunks).toString('utf8')); }
        catch { return reject(new Error('provider control response is invalid')); }
        if (response.statusCode < 200 || response.statusCode >= 300 || value?.success !== true) {
          return reject(new Error('provider control refused the request'));
        }
        resolve(value);
      });
    });
    request.once('timeout', () => request.destroy(new Error('provider control timed out')));
    request.once('error', reject);
    request.end(body || undefined);
  });
}

function buildSystemdRunInvocation(input) {
  if (input.credentialPath !== capabilityFilePath(input.launchId)) {
    fail('launch credential path is invalid');
  }
  if (input.readinessPath !== readinessFilePath(input.provider, input.launchId)) {
    fail('launch readiness path is invalid');
  }
  const unit = unitName(input.provider, input.launchId);
  const supervisorUnit = `teleagent-provider-supervisor@${input.provider}.service`;
  const egressUnit = `teleagent-provider-egress@${input.provider}.service`;
  const runtimeArgs = [
    '--provider', input.provider,
    '--launch-id', input.launchId,
    '--mode', input.mode,
    '--access-mode', input.accessMode,
    '--workspace', input.workspace,
  ];
  if (input.taskId) runtimeArgs.push('--task-id', input.taskId);
  if (input.sessionId) runtimeArgs.push('--session-id', input.sessionId);
  runtimeArgs.push('--', ...input.providerArgs);
  const properties = [
    'Type=exec',
    'Slice=teleagent-provider-model.slice',
    `BindsTo=${supervisorUnit} ${egressUnit}`,
    `After=${supervisorUnit} ${egressUnit}`,
    'User=root',
    'Group=root',
    'UMask=0027',
    'KillMode=control-group',
    'TimeoutStopSec=8s',
    'RuntimeMaxSec=1h',
    'MemoryHigh=2G',
    'MemoryMax=3G',
    'MemorySwapMax=0',
    'TasksMax=384',
    'CPUQuota=150%',
    'CPUWeight=25',
    'IOAccounting=yes',
    'IOWeight=25',
    'LimitNOFILE=4096',
    'LimitFSIZE=268435456',
    'LimitCORE=0',
    'OOMPolicy=kill',
    'PrivateNetwork=yes',
    'PrivateIPC=yes',
    'KeyringMode=private',
    'PrivateDevices=yes',
    // A private namespace alone is not a storage bound. This tmpfs contains
    // the ephemeral HOME and /tmp and cannot consume the host root filesystem.
    'TemporaryFileSystem=/tmp:rw,nodev,nosuid,noexec,size=512M,mode=1777',
    // PrivateNetwork does not isolate pathname Unix sockets. Replace the host
    // runtime tree and re-expose only the one provider-specific egress socket;
    // systemd mounts this unit's LoadCredential directory separately.
    'TemporaryFileSystem=/run:ro,nodev,nosuid,noexec',
    // Hide every sibling workspace, then project only the exact canonical
    // selected tree back into this launch namespace.
    `TemporaryFileSystem=${WORKSPACE_ROOT}:ro,nodev,nosuid`,
    'ProtectSystem=strict',
    'ProtectHome=yes',
    'ProtectControlGroups=yes',
    'ProtectKernelLogs=yes',
    'ProtectKernelModules=yes',
    'ProtectKernelTunables=yes',
    'ProtectClock=yes',
    'ProtectHostname=yes',
    'ProtectProc=invisible',
    'ProcSubset=pid',
    'RestrictNamespaces=yes',
    'RestrictSUIDSGID=yes',
    'LockPersonality=yes',
    'RestrictRealtime=yes',
    'RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6',
    'SystemCallFilter=~io_uring_setup io_uring_enter io_uring_register',
    'ReadOnlyPaths=/opt/teleagent/agent-tools /opt/teleagent/node /usr/local/libexec /etc/teleagent/provider-runtime',
    ...(input.accessMode === 'read-only'
      ? [`BindReadOnlyPaths=${input.workspace}:${input.workspace}`]
      : [`BindPaths=${input.workspace}:${input.workspace}`]),
    `BindReadOnlyPaths=${input.spec.egressSocket}:${input.spec.egressSocket}`,
    `BindPaths=${input.readinessPath}:${input.readinessPath}`,
    `InaccessiblePaths=/opt/teleagent/current /var/run /var/lib/teleagent-control /var/lib/teleagent-worker-state /var/lib/teleagent-privileged-action -/var/lib/teleagent-claude-worker -/var/lib/teleagent-codex-worker -${input.spec.workerHome} -${input.spec.otherHome} /run/teleagent-worker-session /run/teleagent-provider-launch /run/teleagent-provider-egress-control /run/teleagent-privileged-action /etc/teleagent/provider-egress-secrets -/etc/teleagent/credentials -/etc/teleagent-control -/etc/teleagent/controller -/etc/teleagent/privileged-action -/etc/teleagent-voice -${input.workspace}/.codex -${input.workspace}/.claude`,
    // SETPCAP is required for setpriv to drop the descendant bounding set;
    // KILL lets the root wrapper terminate its two different-UID children.
    // Both descendants assert Cap*=0 and NoNewPrivs=1 before provider start.
    'CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_SETPCAP CAP_KILL',
    'NoNewPrivileges=no',
    `LoadCredential=provider-launch-capability:${input.credentialPath}`,
  ];
  return {
    command: SYSTEMD_RUN,
    args: [
      '--quiet', '--wait', '--collect',
      input.mode === 'interactive' ? '--pty' : '--pipe',
      '--service-type=exec',
      `--unit=${unit}`,
      `--working-directory=${input.workspace}`,
      ...properties.flatMap((property) => ['--property', property]),
      '--', RUNTIME, ...runtimeArgs,
    ],
    unit,
  };
}

function systemctl(args, { allowFailure = false } = {}) {
  const result = spawnSync(SYSTEMCTL, args, {
    encoding: 'utf8',
    timeout: 10000,
    maxBuffer: 256 * 1024,
    env: { PATH: '/usr/sbin:/usr/bin:/sbin:/bin', LANG: 'C.UTF-8', LC_ALL: 'C.UTF-8' },
  });
  if (result.error || (!allowFailure && result.status !== 0)) fail('systemd boundary control failed');
  return result;
}

function parseCgroupPopulated(events) {
  if (typeof events !== 'string' || Buffer.byteLength(events) > 4096 ||
      !events.endsWith('\n')) fail('provider cgroup events are invalid');
  const fields = new Map();
  for (const line of events.slice(0, -1).split('\n')) {
    const match = line.match(/^([a-z][a-z0-9_]*) ([0-9]+)$/u);
    if (!match || fields.has(match[1])) fail('provider cgroup events are invalid');
    fields.set(match[1], match[2]);
  }
  if (!['0', '1'].includes(fields.get('populated'))) {
    fail('provider cgroup population is unavailable');
  }
  return fields.get('populated') === '1';
}

function inspectUnit(unit, {
  runSystemctl = systemctl,
  readCgroupEvents = (filename) => fs.readFileSync(filename, 'utf8'),
} = {}) {
  const result = runSystemctl([
    'show', unit, '--no-pager',
    '--property=LoadState', '--property=ActiveState', '--property=SubState', '--property=ControlGroup',
  ], { allowFailure: true });
  if (!result || result.error || result.signal || result.status !== 0 ||
      typeof result.stdout !== 'string') {
    fail('provider unit status is unavailable');
  }
  const lines = String(result.stdout).trim().split('\n').filter(Boolean);
  if (lines.some((line) => !/^[A-Za-z]+=[^\r\n]*$/.test(line))) {
    fail('provider unit status is invalid');
  }
  const entries = lines.map((line) => {
    const index = line.indexOf('=');
    return [line.slice(0, index), line.slice(index + 1)];
  });
  const names = entries.map(([name]) => name);
  const expected = ['LoadState', 'ActiveState', 'SubState', 'ControlGroup'];
  if (expected.some((name) => names.filter((candidate) => candidate === name).length !== 1) ||
      names.some((name) => !expected.includes(name))) {
    fail('provider unit status is incomplete');
  }
  const fields = Object.fromEntries(entries);
  if (fields.LoadState === 'not-found') {
    if (fields.ActiveState !== 'inactive' || fields.SubState !== 'dead' || fields.ControlGroup) {
      fail('provider missing-unit status is inconsistent');
    }
    return { exists: false, quiesced: true, activeState: 'not-found', controlGroup: null };
  }
  if (!['loaded', 'masked'].includes(fields.LoadState) || !fields.ActiveState || !fields.SubState) {
    fail('provider unit load state is invalid');
  }
  let populated = null;
  if (fields.ControlGroup) {
    try {
      const events = readCgroupEvents(path.join('/sys/fs/cgroup', fields.ControlGroup, 'cgroup.events'));
      populated = parseCgroupPopulated(events);
    } catch { populated = true; }
  }
  const inactive = ['inactive', 'failed'].includes(fields.ActiveState);
  return {
    exists: true,
    quiesced: inactive && populated !== true,
    activeState: fields.ActiveState,
    subState: fields.SubState,
    controlGroup: fields.ControlGroup || null,
    populated,
  };
}

function inspectProviderLaunchStatus(provider, launchId, {
  inspectStatus = inspectUnit,
  inspectReadiness = inspectProviderReadiness,
} = {}) {
  const status = inspectStatus(unitName(provider, launchId));
  try {
    return { ...status, ...inspectReadiness(provider, launchId, status) };
  } catch (error) {
    if (error?.code !== 'PROVIDER_READINESS_MISSING') throw error;
    // The supervisor polls as soon as the root launcher is spawned, before
    // its preflight necessarily publishes the planned record. Missing history
    // is an unconfirmed observation, never readiness, quiescence, or proof
    // that a model did not execute. Ordinary termination still requires the
    // durable history; only the existing global recovery path may omit it.
    return { ...status, quiesced: false, providerHistoryUnavailable: true };
  }
}

async function waitQuiesced(unit, timeoutMs) {
  const deadline = Date.now() + timeoutMs;
  while (Date.now() < deadline) {
    const status = inspectUnit(unit);
    if (status.quiesced === true) return status;
    await new Promise((resolve) => setTimeout(resolve, 50));
  }
  return inspectUnit(unit);
}

async function terminateUnit(provider, launchId, {
  control = providerControl,
  allowMissingReadinessForGlobalRecovery = false,
  persistTombstone = persistCancellationTombstone,
  runSystemctl = systemctl,
  awaitQuiescence = waitQuiesced,
  inspectReadiness = inspectProviderReadiness,
  removeReadiness = removeReadinessFile,
} = {}) {
  const unit = unitName(provider, launchId);
  // The root-owned symlink is a boot-lifetime cancellation tombstone. Unlike
  // a best-effort `systemctl mask`, creation and fsync are checked before the
  // boundary reports acceptance, closing launch-before-unit-creation races.
  if (persistTombstone(unit) !== true) fail('provider cancellation tombstone was not persisted');
  let capabilityRevoked = false;
  try {
    const revoked = await control({ provider, action: 'revoke', launchId, reason: 'canceled' });
    capabilityRevoked = revoked?.persisted === true && revoked?.quiesced === true;
  } catch { capabilityRevoked = false; }
  runSystemctl(['kill', '--kill-whom=all', '--signal=SIGTERM', unit], { allowFailure: true });
  // An inactive/empty unit can still have a queued start job. The mask fences
  // future creation; a replacing, completed StopUnit also cancels existing
  // jobs. Never infer that cancellation solely from an empty cgroup snapshot.
  let stopped = runSystemctl(['stop', '--job-mode=replace', unit], { allowFailure: true });
  let status = await awaitQuiescence(unit, 2000);
  if (status?.quiesced !== true) {
    runSystemctl(['kill', '--kill-whom=all', '--signal=SIGKILL', unit], { allowFailure: true });
    stopped = runSystemctl(['stop', '--job-mode=replace', unit], { allowFailure: true });
    status = await awaitQuiescence(unit, 5000);
  }
  const stopConfirmed = stopped?.status === 0 && !stopped.error && !stopped.signal;
  const quiesced = stopConfirmed && status?.quiesced === true && capabilityRevoked;
  let readiness;
  try { readiness = inspectReadiness(provider, launchId, status); }
  catch (error) {
    if (allowMissingReadinessForGlobalRecovery !== true || !quiesced ||
        error?.code !== 'PROVIDER_READINESS_MISSING') throw error;
    // Only global panic uses this cleanup-only mode. Ordinary status/terminate
    // must not turn missing history into PROVIDER_NOT_STARTED/retrySafe=true
    // in the supervisor. This result makes no assertion about prior execution.
    readiness = { providerHistoryUnavailable: true };
  }
  if (quiesced) {
    removeReadiness(readinessFilePath(provider, launchId));
  }
  return {
    accepted: true,
    persisted: capabilityRevoked,
    quiesced,
    status,
    ...readiness,
  };
}

async function forceStopSystemdUnit(unit) {
  systemctl(['kill', '--kill-whom=all', '--signal=SIGTERM', unit], { allowFailure: true });
  systemctl(['stop', unit], { allowFailure: true });
  let status = await waitQuiesced(unit, 2000);
  if (!status.quiesced) {
    systemctl(['kill', '--kill-whom=all', '--signal=SIGKILL', unit], { allowFailure: true });
    systemctl(['stop', unit], { allowFailure: true });
    status = await waitQuiesced(unit, 5000);
  }
  return status;
}

async function recoverProviderEgress(provider, control = providerControl) {
  try {
    const recovered = await control({ provider, action: 'recover' });
    if (recovered?.persisted === true && recovered?.quiesced === true) return recovered;
  } catch { /* restart the exact credential broker below */ }
  const unit = `teleagent-provider-egress@${provider}.service`;
  const stopped = await forceStopSystemdUnit(unit);
  if (!stopped.quiesced) return { persisted: false, quiesced: false };
  const started = systemctl(['start', unit], { allowFailure: true });
  if (started.error || started.signal || started.status !== 0) {
    return { persisted: false, quiesced: false };
  }
  try {
    const recovered = await control({ provider, action: 'recover' });
    return {
      persisted: recovered?.persisted === true,
      quiesced: recovered?.persisted === true && recovered?.quiesced === true,
      restarted: true,
    };
  } catch {
    return { persisted: false, quiesced: false, restarted: true };
  }
}

function probeProviderSupervisor(provider, {
  timeoutMs = 3000,
  connect = (options) => net.createConnection(options),
} = {}) {
  const spec = PROVIDERS[provider];
  if (!spec) return Promise.reject(new Error('provider supervisor probe identity is invalid'));
  return new Promise((resolve, reject) => {
    const socket = connect({ path: spec.supervisorSocket });
    let settled = false;
    let buffer = Buffer.alloc(0);
    const finish = (error, payload) => {
      if (settled) return;
      settled = true;
      clearTimeout(timer);
      socket.destroy();
      if (error) reject(error);
      else resolve(payload);
    };
    const timer = setTimeout(() => finish(new Error('provider supervisor health timed out')), timeoutMs);
    socket.once('connect', () => {
      socket.write(`${JSON.stringify({ version: 1, type: 'health' })}\n`);
    });
    socket.on('data', (chunk) => {
      buffer = Buffer.concat([buffer, chunk]);
      if (buffer.length > 64 * 1024) {
        return finish(new Error('provider supervisor health response is too large'));
      }
      const newline = buffer.indexOf(0x0a);
      if (newline < 0) return;
      if (buffer.subarray(newline + 1).some((byte) => ![0x0a, 0x0d, 0x20, 0x09].includes(byte))) {
        return finish(new Error('provider supervisor health response has trailing data'));
      }
      let payload;
      try { payload = JSON.parse(buffer.subarray(0, newline).toString('utf8')); }
      catch { return finish(new Error('provider supervisor health response is invalid')); }
      finish(null, payload);
    });
    socket.once('error', (error) => finish(error));
    socket.once('end', () => {
      if (!settled) finish(new Error('provider supervisor health response is incomplete'));
    });
  });
}

function isLockedSupervisorHealth(provider, payload) {
  return payload?.success === true && payload?.provider === provider &&
    payload?.ready === false && payload?.panicLocked === true &&
    payload?.boundaryRecovered === true && payload?.active === 0;
}

async function panicAllProviderPlanes({
  control = providerControl,
  persistPanic = persistGlobalProviderPanic,
  activationProviders = null,
  readProviders = readEnabledProviders,
  runSystemctl = systemctl,
  stopUnit = forceStopSystemdUnit,
  enumerateUnits = listProviderUnits,
  terminate = terminateUnit,
  recoverEgress = recoverProviderEgress,
  inspectLaunchLock = () => inspectGlobalLaunchLock(globalLaunchLockPath()),
  clearLaunchLock = clearStaleGlobalLaunchLockAfterQuiescence,
} = {}) {
  const lock = persistPanic();
  if (lock?.persisted !== true) fail('global provider panic was not persisted');
  let enabledProviders;
  let modeUncertain = false;
  try {
    enabledProviders = activationProviders ?? readProviders();
    if (!Array.isArray(enabledProviders) ||
        !(['codex', 'claude,codex'].includes(enabledProviders.join(',')))) {
      throw new Error('invalid provider activation selection');
    }
  } catch {
    // Keep the durable panic and stop both planes; uncertainty cannot report
    // a complete stop or let recovery unlock either provider.
    enabledProviders = Object.keys(PROVIDERS);
    modeUncertain = true;
  }
  for (const provider of Object.keys(PROVIDERS)) {
    runSystemctl(['stop', `teleagent-provider-supervisor@${provider}.socket`], {
      allowFailure: true,
    });
  }
  const supervisorResults = {};
  for (const provider of Object.keys(PROVIDERS)) {
    supervisorResults[provider] = await stopUnit(
      `teleagent-provider-supervisor@${provider}.service`
    );
  }
  const supervisorUnits = Object.keys(PROVIDERS).flatMap((provider) => [
    `teleagent-provider-supervisor@${provider}.socket`,
    `teleagent-provider-supervisor@${provider}.service`,
  ]);
  const masked = runSystemctl(['mask', '--runtime', ...supervisorUnits], { allowFailure: true });
  const launchResults = [];
  const retainedLaunchResults = [];
  let retainedLaunch = null;
  try { retainedLaunch = inspectLaunchLock(); }
  catch (error) {
    if (error?.code !== 'ENOENT') throw error;
  }
  // A failed systemd-run submission may still be in flight when enumeration
  // returns no units. Fence and quiesce the retained exact identity first.
  // Version 1 locks omit the provider, so both exact unit names are canceled.
  // terminateUnit persists the mask before inspecting cgroup/egress state.
  if (retainedLaunch !== null) {
    for (const provider of Object.keys(PROVIDERS)) {
      retainedLaunchResults.push(await terminate(provider, retainedLaunch.launchId, {
        control, allowMissingReadinessForGlobalRecovery: true,
      }));
    }
  }
  for (const provider of Object.keys(PROVIDERS)) {
    for (const unit of enumerateUnits(provider)) {
      const match = unit.match(
        /^teleagent-provider-launch-(?:claude|codex)-([a-f0-9]{32})\.service$/
      );
      if (!match) fail('provider panic unit identity is invalid');
      launchResults.push(await terminate(provider, `launch_${match[1]}`, {
        control, allowMissingReadinessForGlobalRecovery: true,
      }));
    }
  }
  const egress = {};
  for (const provider of Object.keys(PROVIDERS)) {
    if (enabledProviders.includes(provider)) {
      egress[provider] = await recoverEgress(provider, control);
      continue;
    }
    const dataStopped = runSystemctl(['stop', `teleagent-provider-egress@${provider}.socket`], {
      allowFailure: true,
    });
    const controlStopped = runSystemctl(
      ['stop', `teleagent-provider-egress-control@${provider}.socket`],
      { allowFailure: true },
    );
    const serviceStopped = await stopUnit(`teleagent-provider-egress@${provider}.service`);
    const quiesced = [dataStopped, controlStopped].every((status) =>
      status && !status.error && !status.signal && status.status === 0) &&
      serviceStopped?.quiesced === true;
    egress[provider] = { persisted: quiesced, quiesced, disabled: true };
  }
  const allLaunchResults = [...retainedLaunchResults, ...launchResults];
  const providerPlaneQuiesced =
    !modeUncertain &&
    Object.values(supervisorResults).every((status) => status?.quiesced === true) &&
    allLaunchResults.every((result) => result?.persisted === true && result?.quiesced === true) &&
    Object.values(egress).every((result) => result?.persisted === true && result?.quiesced === true) &&
    !masked.error && !masked.signal && masked.status === 0;
  let launchLockRecovery = { proved: providerPlaneQuiesced, removed: false };
  if (providerPlaneQuiesced) {
    try {
      launchLockRecovery = clearLaunchLock({ quiesced: true, expectedRecord: retainedLaunch });
    } catch (error) {
      launchLockRecovery = { proved: false, removed: false, error: error.message };
    }
  }
  const quiesced = providerPlaneQuiesced && launchLockRecovery.proved === true;
  return {
    accepted: true,
    persisted: lock.persisted === true &&
      allLaunchResults.every((result) => result?.persisted === true) &&
      Object.values(egress).every((result) => result?.persisted === true),
    quiesced,
    alreadyLocked: lock.alreadyLocked === true,
    supervisorResults,
    launchCount: launchResults.length,
    retainedLaunchCount: retainedLaunchResults.length,
    launchLockRecovery,
    egress,
  };
}

async function unlockAllProviderPlanes({
  control = providerControl,
  panicAll = (options) => panicAllProviderPlanes({ control, ...options }),
  activationProviders = null,
  readProviders = readEnabledProviders,
  runSystemctl = systemctl,
  forceStop = forceStopSystemdUnit,
  persistRecovery = persistGlobalProviderRecovery,
  clearRecovery = clearGlobalProviderRecovery,
  clearPanic = clearGlobalProviderPanic,
  probe = probeProviderSupervisor,
  probeAttempts = 5,
  probeRetryMs = 250,
} = {}) {
  let selectedBefore;
  try { selectedBefore = activationProviders ?? readProviders(); }
  catch { selectedBefore = null; }
  const recovery = await panicAll({ activationProviders: selectedBefore });
  if (!recovery.persisted || !recovery.quiesced) {
    return { success: false, persisted: recovery.persisted, quiesced: false, recovery };
  }
  let enabledProviders;
  try {
    enabledProviders = activationProviders ?? readProviders();
    if (!Array.isArray(enabledProviders) ||
        !(['codex', 'claude,codex'].includes(enabledProviders.join(','))) ||
        !Array.isArray(selectedBefore) ||
        selectedBefore.join(',') !== enabledProviders.join(',')) {
      throw new Error('invalid provider activation selection');
    }
  } catch {
    return { success: false, persisted: true, quiesced: false,
      code: 'PROVIDER_ACTIVATION_MODE_UNAVAILABLE', recovery };
  }
  const maskedUnits = enabledProviders.flatMap((provider) => [
    `teleagent-provider-supervisor@${provider}.socket`,
    `teleagent-provider-supervisor@${provider}.service`,
  ]);
  const recoveryFence = persistRecovery();
  if (recoveryFence?.persisted !== true) {
    return { success: false, persisted: true, quiesced: false, code: 'PROVIDER_RECOVERY_FENCE_FAILED' };
  }
  const unmasked = runSystemctl(['unmask', '--runtime', ...maskedUnits], { allowFailure: true });
  if (unmasked.error || unmasked.signal || unmasked.status !== 0) {
    return { success: false, persisted: true, quiesced: false, code: 'PROVIDER_UNMASK_FAILED' };
  }
  const units = enabledProviders.flatMap((provider) => [
    `teleagent-provider-supervisor@${provider}.socket`,
    `teleagent-provider-supervisor@${provider}.service`,
  ]);
  const rollback = async (code) => {
    for (const provider of enabledProviders) {
      runSystemctl(['stop', `teleagent-provider-supervisor@${provider}.socket`], {
        allowFailure: true,
      });
      await forceStop(`teleagent-provider-supervisor@${provider}.service`);
    }
    runSystemctl(['mask', '--runtime', ...maskedUnits], { allowFailure: true });
    try { clearRecovery(); } catch { /* the global panic file remains authoritative */ }
    return { success: false, persisted: true, quiesced: false, code };
  };
  for (const unit of units) {
    const started = runSystemctl(['start', unit], { allowFailure: true });
    if (started.error || started.signal || started.status !== 0) {
      return rollback('PROVIDER_RESTART_FAILED');
    }
  }
  for (const provider of enabledProviders) {
    let health;
    // systemctl start confirms the process entered its start unit, while the
    // supervisor still has to complete its own root boundary recovery before
    // its inherited socket can answer health. Keep the global panic and
    // recovery marker in place throughout this bounded readiness window.
    let observed = false;
    for (let attempt = 0; attempt < probeAttempts; attempt += 1) {
      try {
        health = await probe(provider);
        observed = true;
        break;
      } catch {
        if (attempt + 1 < probeAttempts) {
          await new Promise((resolve) => setTimeout(resolve, probeRetryMs));
        }
      }
    }
    if (!observed) return rollback('PROVIDER_RESTART_HEALTH_FAILED');
    if (!isLockedSupervisorHealth(provider, health)) {
      return rollback('PROVIDER_RESTART_NOT_LOCKED');
    }
  }
  // Remove the recovery marker first while the original panic file still
  // blocks every launch. Unlinking and fsyncing the panic file is the single,
  // final commit point after all enabled locked supervisors have answered health.
  const recoveryCleared = clearRecovery();
  if (recoveryCleared?.persisted !== true) {
    return rollback('PROVIDER_RECOVERY_FENCE_CLEAR_FAILED');
  }
  const panicCleared = clearPanic();
  if (panicCleared?.persisted !== true) {
    return rollback('PROVIDER_PANIC_CLEAR_FAILED');
  }
  return { success: true, persisted: true, quiesced: true, recovery };
}

function listProviderUnits(provider, { runSystemctl = systemctl } = {}) {
  const prefix = `teleagent-provider-launch-${provider}-`;
  const result = runSystemctl([
    'list-units', '--all', '--plain', '--no-legend', `${prefix}*.service`,
  ], { allowFailure: true });
  if (!result || result.error || result.signal || result.status !== 0 ||
      typeof result.stdout !== 'string') {
    fail('provider unit enumeration is unavailable');
  }
  const lines = result.stdout.split('\n').map((line) => line.trim()).filter(Boolean);
  const units = [];
  for (const line of lines) {
    const fields = line.split(/\s+/);
    const unit = fields[0];
    if (fields.length < 4 || !new RegExp(
      `^${prefix}[a-f0-9]{32}\\.service$`
    ).test(unit)) {
      fail('provider unit enumeration is invalid');
    }
    units.push(unit);
  }
  return units;
}

// Programmatic dependencies let the launch transaction be exercised without
// root, systemd, live credentials, or provider traffic. No CLI/environment
// setting can replace these production operations.
const PROVIDER_LAUNCH_OPERATIONS = Object.freeze({
  hasCancellationTombstone,
  assertProviderEnabled,
  createGlobalLaunchLock,
  assertResourceAdmission,
  validateProviderStorageIsolation,
  assertGlobalProviderLaunchUnlocked,
  validateWorkspaceAnchor,
  validateProviderWorkspace,
  createCapabilityFile,
  createReadinessFile,
  buildSystemdRunInvocation,
  waitQuiesced,
  removeCapabilityFile,
  removeGlobalLaunchLock,
});

async function main(argv = process.argv.slice(2), environment = process.env, {
  control = providerControl,
  randomCapability = () => crypto.randomBytes(32).toString('hex'),
  spawnImpl = spawn,
  checkProviderCli = requirePinnedProviderCli,
  requirePreflight = requireImmutablePreflight,
  parseInput = parseControl,
  attestWorkerStorage = attestWorkerStorageBoundary,
  launchOperations = PROVIDER_LAUNCH_OPERATIONS,
  panicAll = panicAllProviderPlanes,
} = {}) {
  const input = parseInput(argv, environment);
  if (['assert-supervisor-start-admitted', 'attest-worker-storage'].includes(input.action)) {
    requirePreflight({ environment });
  }
  if (input.action === 'attest-worker-storage') {
    process.stdout.write(`${attestWorkerStorage()}\n`);
    return 0;
  }
  if (input.action === 'attest-workspace-storage') {
    process.stdout.write(`${attestWorkspaceStorageBoundary()}\n`);
    return 0;
  }
  if (input.action === 'attest-provider-plane-storage') {
    process.stdout.write(`${attestProviderPlaneStorageBoundary()}\n`);
    return 0;
  }
  if (input.action === 'assert-global-unlocked') {
    if (globalProviderPanicLocked()) fail('global provider plane is panic-locked', 75);
    return 0;
  }
  if (input.action === 'assert-supervisor-start-admitted') {
    assertSupervisorStartAdmitted();
    return 0;
  }
  if (input.action === 'panic-all' || input.action === 'root-stop-all') {
    // Root recovery has the same stop transaction, never the unlock path. Its
    // independently pinned dispatcher/installation supplies host authority;
    // no caller-selected target, retained start lock or ENABLE gate is used.
    const result = await panicAll({ control });
    process.stdout.write(`${JSON.stringify(result)}\n`);
    return result.persisted && result.quiesced ? 0 : 75;
  }
  if (input.action === 'recover-root-panic') {
    const result = await unlockAllProviderPlanes({ control });
    process.stdout.write(`${JSON.stringify(result)}\n`);
    return result.success && result.quiesced ? 0 : 75;
  }
  if (input.action === 'launch') {
    const {
      hasCancellationTombstone,
      assertProviderEnabled,
      createGlobalLaunchLock,
      assertResourceAdmission,
      validateProviderStorageIsolation,
      assertGlobalProviderLaunchUnlocked,
      validateWorkspaceAnchor,
      validateProviderWorkspace,
      createCapabilityFile,
      createReadinessFile,
      buildSystemdRunInvocation,
      waitQuiesced,
      removeCapabilityFile,
      removeGlobalLaunchLock,
    } = launchOperations;
    const unit = unitName(input.provider, input.launchId);
    assertProviderEnabled(input.provider);
    if (hasCancellationTombstone(unit)) fail('provider launch was canceled before submit', 75);
    const capability = randomCapability();
    if (!/^[a-f0-9]{64}$/.test(capability)) fail('provider launch capability source is invalid');
    const expiresAtMs = Date.now() + 60 * 60 * 1000;
    let credentialPath = null;
    let readinessPath = null;
    let capabilityQuiesced = true;
    let modelQuiesced = true;
    let globalLaunchLock = null;
    try {
      globalLaunchLock = createGlobalLaunchLock(input.launchId);
      validateProviderStorageIsolation();
      assertGlobalProviderLaunchUnlocked();
      checkProviderCli(input.provider);
      validateWorkspaceAnchor(input.workspace);
      validateProviderWorkspace(input.workspace);
      // Only new work is gated. Panic, cancellation and cleanup must remain
      // usable when the pool is full or its evidence cannot be inspected.
      await assertResourceAdmission();
      assertGlobalProviderLaunchUnlocked();
      credentialPath = createCapabilityFile(input.launchId, capability);
      readinessPath = createReadinessFile(input.provider, input.launchId);
      assertGlobalProviderLaunchUnlocked();
      // Even a lost/invalid reply can leave a durably registered capability.
      // Revoke-before-late-register is safe because egress persists a canceled
      // tombstone for unknown launch IDs and never re-registers that identity.
      capabilityQuiesced = false;
      const registration = await control({
        provider: input.provider,
        action: 'register',
        launchId: input.launchId,
        capability,
        expiresAtMs,
        model: input.model,
        reasoningEffort: input.reasoningEffort,
        routeKinds: input.routeKinds,
        mode: input.mode,
      });
      if (registration?.registered !== true) fail('provider launch capability was not registered');
      if (hasCancellationTombstone(unit)) fail('provider launch was canceled before start', 75);
      // Registration can await another process. Resample immediately before
      // the first model-start effect while the same global fence is held.
      await assertResourceAdmission();
      if (hasCancellationTombstone(unit)) fail('provider launch was canceled before start', 75);
      assertProviderEnabled(input.provider);
      assertGlobalProviderLaunchUnlocked();
      const invocation = buildSystemdRunInvocation({ ...input, credentialPath, readinessPath });
      assertGlobalProviderLaunchUnlocked();
      // Mark submission uncertainty before invoking the helper. Neither a
      // spawn failure nor a nonzero/abnormal exit excludes a delayed systemd
      // request, even if a later status snapshot says the unit is absent.
      modelQuiesced = false;
      const child = spawnImpl(invocation.command, invocation.args, {
        stdio: 'inherit',
        env: { PATH: '/usr/sbin:/usr/bin:/sbin:/bin', LANG: 'C.UTF-8', LC_ALL: 'C.UTF-8' },
        shell: false,
      });
      const result = await new Promise((resolve, reject) => {
        child.once('error', reject);
        child.once('exit', (code, signal) => resolve({ code, signal }));
      });
      const status = await waitQuiesced(invocation.unit, 5000);
      modelQuiesced = result.code === 0 && result.signal === null && status?.quiesced === true;
      if (!modelQuiesced) fail('provider unit completion or cgroup quiescence is unproved', 75);
      const revoked = await control({
        provider: input.provider,
        action: 'revoke',
        launchId: input.launchId,
        reason: 'completed',
      });
      if (revoked?.persisted !== true || revoked?.quiesced !== true) {
        fail('provider launch capability revocation did not reach quiescence');
      }
      capabilityQuiesced = true;
      return Number.isInteger(result.code) ? result.code : 1;
    } finally {
      let credentialCleanupError = null;
      try { removeCapabilityFile(credentialPath); }
      catch (error) { credentialCleanupError = error; }
      // Spawn evidence intentionally outlives the transient wrapper. The
      // supervisor must distinguish a launch that never reached the model
      // from a model that spawned and exited between readiness polls. Exact
      // terminate/recover control removes it only after cgroup+egress zero.
      if (!capabilityQuiesced) {
        try {
          const revoked = await control({
            provider: input.provider,
            action: 'revoke',
            launchId: input.launchId,
            reason: 'interrupted',
          });
          capabilityQuiesced = revoked?.persisted === true && revoked?.quiesced === true;
        } catch { /* retain the global lock; expiry is not proof of quiescence */ }
      }
      // This root-only, crash-published lock is a same-boot global admission
      // fence, not merely a wrapper-PID mutex. Only global panic recovery may
      // clear a stranded lock after fencing and quiescing both providers.
      if (globalLaunchLock && modelQuiesced && capabilityQuiesced && !credentialCleanupError) {
        removeGlobalLaunchLock(globalLaunchLock, input.launchId);
      }
      if (credentialCleanupError) throw credentialCleanupError;
    }
  }
  if (input.action === 'status') {
    process.stdout.write(`${JSON.stringify(
      inspectProviderLaunchStatus(input.provider, input.launchId)
    )}\n`);
    return 0;
  }
  if (input.action === 'terminate') {
    const result = await terminateUnit(input.provider, input.launchId, { control });
    process.stdout.write(`${JSON.stringify(result)}\n`);
    return result.quiesced ? 0 : 75;
  }
  let capabilityRecovery;
  try { capabilityRecovery = await control({ provider: input.provider, action: 'recover' }); }
  catch { capabilityRecovery = null; }
  const results = [];
  for (const unit of listProviderUnits(input.provider)) {
    const match = unit.match(/^teleagent-provider-launch-(?:claude|codex)-([a-f0-9]{32})\.service$/);
    if (match) results.push(await terminateUnit(input.provider, `launch_${match[1]}`, { control }));
  }
  const quiesced = capabilityRecovery?.persisted === true && capabilityRecovery?.quiesced === true &&
    results.every((result) => result.quiesced);
  const readinessRemoved = quiesced ? purgeProviderReadinessArtifacts(input.provider) : 0;
  process.stdout.write(`${JSON.stringify({
    accepted: true,
    persisted: capabilityRecovery?.persisted === true &&
      results.every((result) => result.persisted),
    quiesced,
    unitCount: results.length,
    readinessRemoved,
  })}\n`);
  return quiesced ? 0 : 75;
}

if (require.main === module) {
  main().then((code) => process.exit(code)).catch((error) => {
    process.stderr.write(`Provider boundary control failed: ${error.message}\n`);
    process.exit(error.exitCode || 77);
  });
}

