    for (const [provider, directory] of Object.entries(PROVIDER_PLANE_HOMES)) {
      const identity = expected[provider];
      const metadata = homes[provider];
      if (!identity || !Number.isSafeInteger(identity.uid) || identity.uid <= 0 ||
          !Number.isSafeInteger(identity.gid) || identity.gid <= 0 ||
          !metadata.isDirectory() || metadata.isSymbolicLink() ||
          metadata.uid !== identity.uid || metadata.gid !== identity.gid ||
          (metadata.mode & 0o7777) !== 0o700 || realpath(directory) !== directory ||
