  const providerArgs = separator >= 0 ? argv.slice(separator + 1) : [];
  const action = take(options, '--action');
  const globalAction = [
    'panic-all', 'root-stop-all', 'recover-root-panic', 'assert-global-unlocked',
    'assert-supervisor-start-admitted', 'attest-workspace-storage',
    'attest-provider-plane-storage', 'attest-worker-storage',
  ].includes(action);
  const provider = take(options, '--provider', !globalAction);
  const launchId = take(options, '--launch-id', action === 'launch' || action === 'terminate' || action === 'status');
  const mode = take(options, '--mode', action === 'launch');
  const accessMode = take(options, '--access-mode', action === 'launch');
  const workspaceInput = take(options, '--workspace', action === 'launch');
  const taskId = take(options, '--task-id', false);
  const sessionId = take(options, '--session-id', false);
  const spec = PROVIDERS[provider];
  if (globalAction) {
    if (action === 'root-stop-all' && (
      uid !== 0 || euid !== 0 || argv.length !== 2 ||
      argv[0] !== '--action' || argv[1] !== 'root-stop-all' ||
      !Array.isArray(execArguments) || execArguments.length !== 0 ||
      Object.keys(environment).sort().join('\n') !== Object.keys(ROOT_STOP_ENVIRONMENT).sort().join('\n') ||
      Object.entries(ROOT_STOP_ENVIRONMENT).some(([key, value]) => environment[key] !== value)
    )) {
      fail('root provider stop requires genuine root, exact argv and the fixed clean environment');
    }
    const validIdentity = action === 'panic-all'
      ? environment.SUDO_USER === 'teleagent-session-broker'
      : action === 'recover-root-panic'
        ? [undefined, 'teleagent-session-broker'].includes(environment.SUDO_USER)
        : ['attest-workspace-storage', 'attest-provider-plane-storage'].includes(action)
          ? true
          : environment.SUDO_USER === undefined;
    if (options.length || providerArgs.length || provider !== null || launchId !== null ||
        mode !== null || accessMode !== null || workspaceInput !== null ||
        taskId !== null || sessionId !== null || uid !== 0 ||
        !validIdentity) {
      fail('global provider boundary identity is invalid');
    }
    return { action, provider: null, launchId: null, spec: null };
  }
  if (options.length || !spec || !['launch', 'terminate', 'status', 'recover'].includes(action) ||
      uid !== 0 || environment.SUDO_USER !== spec.supervisor) {
    fail('boundary controller identity is invalid');
  }
