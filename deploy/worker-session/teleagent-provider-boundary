      before.nlink !== after.nlink || before.mtimeMs !== after.mtimeMs ||
      before.ctimeMs !== after.ctimeMs) {
    fail('the global provider launch lock changed while it was inspected');
  }
  return {
    record: normalizeGlobalLaunchLock(content.toString('utf8')),
    metadata: before,
  };
