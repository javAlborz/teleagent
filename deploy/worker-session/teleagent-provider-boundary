    mode || accessMode || workspaceInput || taskId || sessionId || providerArgs.length
  )) {
    fail('control action contains launch arguments');
  }
  if (launchId && !LAUNCH_ID.test(launchId)) fail('launch ID is invalid');
  if (action !== 'launch') return { action, provider, launchId, spec };
  const workspace = path.resolve(String(workspaceInput || ''));
  if (!['managed', 'interactive'].includes(mode) ||
      !['read-only', 'mutating'].includes(accessMode) ||
      mode === 'interactive' ||
      workspace !== FIXED_WORKSPACE || (taskId && !TASK_ID.test(taskId)) ||
      providerArgs.length > 256 || providerArgs.some((arg) => arg.length > 8192 || /[\0\r\n]/.test(arg))) {
