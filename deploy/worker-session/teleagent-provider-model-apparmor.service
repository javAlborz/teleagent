[Unit]
After=teleagent-provider.slice teleagent-voice.slice teleagent-media.slice teleagent-recovery.slice
Requires=teleagent-provider.slice teleagent-voice.slice teleagent-media.slice teleagent-recovery.slice
Description=Load the enforced Teleagent model-only AppArmor profile
Requires=teleagent-provider-libexec-install.service
After=teleagent-provider-libexec-install.service
Before=teleagent-provider-supervisor@claude.service teleagent-provider-supervisor@codex.service
ConditionPathExists=/etc/teleagent/worker-session/ENABLE

[Service]
Slice=teleagent-provider.slice
CPUAccounting=yes
CPUQuota=25%
CPUQuotaPeriodSec=100ms
MemoryAccounting=yes
MemoryHigh=100663296
MemoryMax=134217728
MemorySwapMax=0
TasksAccounting=yes
TasksMax=32
Type=oneshot
ExecStart=/usr/local/libexec/teleagent-provider-apparmor-install install
RemainAfterExit=yes
UMask=0077
LimitCORE=0

# Deliberately dormant: provider supervisors pull this unit in only after the
# root-owned ENABLE gate is installed and activation verification succeeds.
