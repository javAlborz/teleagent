[Unit]
Description=Teleagent credential-holding %i provider egress broker
Requires=teleagent-provider-egress@%i.socket teleagent-provider-egress-control@%i.socket
After=local-fs.target network-online.target teleagent-provider-egress@%i.socket teleagent-provider-egress-control@%i.socket
RequiresMountsFor=/var/lib/teleagent-worker-state
ConditionPathExists=/etc/teleagent/worker-session/ENABLE
ConditionPathExists=/etc/teleagent/provider-egress/%i.json
ConditionPathExists=/etc/teleagent/provider-egress-secrets/%i.api-key
ConditionPathExists=/run/systemd/resolve/resolv.conf

[Service]
Type=simple
Slice=teleagent-provider.slice
User=teleagent-%i-egress
Group=teleagent-%i-egress
Sockets=teleagent-provider-egress@%i.socket teleagent-provider-egress-control@%i.socket
UMask=0077
WorkingDirectory=/var/lib/teleagent-worker-state/%i-egress
Environment=HOME=/var/lib/teleagent-worker-state/%i-egress
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=NODE_DEBUG=
Environment=NODE_OPTIONS=
Environment=NODE_PATH=
Environment=NODE_EXTRA_CA_CERTS=
Environment=NODE_TLS_REJECT_UNAUTHORIZED=
Environment=NODE_USE_ENV_PROXY=
Environment=SSLKEYLOGFILE=
Environment=SSL_CERT_FILE=
Environment=SSL_CERT_DIR=
Environment=HTTP_PROXY=
Environment=HTTPS_PROXY=
Environment=ALL_PROXY=
Environment=NO_PROXY=
Environment=http_proxy=
Environment=https_proxy=
Environment=all_proxy=
Environment=no_proxy=
UnsetEnvironment=LD_PRELOAD LD_LIBRARY_PATH OPENAI_API_KEY ANTHROPIC_API_KEY CLAUDE_API_KEY CLAUDE_API_TOKEN CODEX_API_KEY API_KEY API_TOKEN AUTH_TOKEN ACCESS_TOKEN PROVIDER_TOKEN PROVIDER_SECRET
Environment=TELEAGENT_PROVIDER=%i
Environment=PROVIDER_EGRESS_SOCKET_PATH=/run/teleagent-provider-egress/%i.sock
Environment=PROVIDER_EGRESS_CONTROL_SOCKET_PATH=/run/teleagent-provider-egress-control/%i.sock
Environment=PROVIDER_EGRESS_DB_PATH=/var/lib/teleagent-worker-state/%i-egress/budget.sqlite
Environment=PROVIDER_EGRESS_POLICY_PATH=/etc/teleagent/provider-egress/%i.json
LoadCredential=provider-api-key:/etc/teleagent/provider-egress-secrets/%i.api-key
LoadCredential=teleagent-release-gate:/run/teleagent-release-gate/verified.json
ExecStartPre=+/usr/bin/env -i HOME=/var/empty PATH=/usr/sbin:/usr/bin:/sbin:/bin LANG=C.UTF-8 LC_ALL=C.UTF-8 /usr/local/libexec/verify-teleagent-release-closure --check-start-gate
ExecStartPre=+/usr/bin/python3 -I /usr/local/libexec/verify-teleagent-release-closure --preflight-component provider-egress-%i ${CREDENTIALS_DIRECTORY}/teleagent-release-gate
ExecStart=!/usr/bin/python3 -I /usr/local/libexec/verify-teleagent-release-closure --supervise-component provider-egress-%i ${CREDENTIALS_DIRECTORY}/teleagent-release-gate
Restart=on-failure
RestartSec=2s
KillMode=control-group
TimeoutStopSec=20s
LimitCORE=0
MemoryHigh=384M
MemoryMax=512M
MemorySwapMax=0
TasksMax=128
CPUQuota=25%
CPUWeight=100
IOAccounting=yes
IOWeight=100
NoNewPrivileges=yes
AmbientCapabilities=
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_SETPCAP CAP_KILL
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/opt/teleagent/releases /usr/local/libexec /etc/teleagent/provider-egress
BindReadOnlyPaths=/run/systemd/resolve/resolv.conf:/etc/resolv.conf
ReadWritePaths=/var/lib/teleagent-worker-state/%i-egress
InaccessiblePaths=/var/lib/teleagent-control /var/lib/teleagent-worker-state/session-broker -/var/lib/teleagent-claude-worker -/var/lib/teleagent-codex-worker /srv/teleagent-agent-workspaces /run/teleagent-worker-session /run/teleagent-provider-launch /run/teleagent-privileged-action /opt/teleagent/current/voice-app/audio /opt/teleagent/current/voice-app/static
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=all
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=localhost
IPAddressDeny=10.0.0.0/8
IPAddressDeny=100.64.0.0/10
IPAddressDeny=169.254.0.0/16
IPAddressDeny=172.16.0.0/12
IPAddressDeny=192.168.0.0/16
IPAddressDeny=fc00::/7
IPAddressDeny=fe80::/10
SystemCallArchitectures=native

# The worker cannot join this service, read its credential, or reach the public
# network. Only this credential UID resolves/connects to the fixed public API;
# application code still enforces exact host, path, model, body, concurrency,
# expiry, and spend bounds.

# Deliberately dormant: no [Install] section.
