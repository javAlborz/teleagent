[Unit]
After=teleagent-provider.slice teleagent-voice.slice teleagent-media.slice teleagent-recovery.slice
Requires=teleagent-provider.slice teleagent-voice.slice teleagent-media.slice teleagent-recovery.slice
Description=Install reviewed Teleagent provider libexec closure
Before=teleagent-provider-model-apparmor.service teleagent-provider-supervisor@claude.socket teleagent-provider-supervisor@codex.socket
ConditionPathExists=/etc/teleagent/worker-session/ENABLE

[Service]
Slice=teleagent-provider.slice
CPUAccounting=yes
CPUQuota=50%
CPUQuotaPeriodSec=100ms
MemoryAccounting=yes
MemoryHigh=100663296
MemoryMax=134217728
MemorySwapMax=0
TasksAccounting=yes
TasksMax=32
Type=oneshot
LoadCredential=teleagent-release-gate:/run/teleagent-release-gate/verified.json
ExecStartPre=+/usr/bin/env -i HOME=/var/empty PATH=/usr/sbin:/usr/bin:/sbin:/bin LANG=C.UTF-8 LC_ALL=C.UTF-8 /usr/local/libexec/verify-teleagent-release-closure --check-start-gate
ExecStart=/usr/bin/python3 -I /usr/local/libexec/verify-teleagent-release-closure --start-component provider-libexec-install ${CREDENTIALS_DIRECTORY}/teleagent-release-gate
RemainAfterExit=yes
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadOnlyPaths=/opt/teleagent/releases
ReadWritePaths=/usr/local/libexec /etc/teleagent/provider-runtime
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native

# Deliberately dormant: no [Install] section.
