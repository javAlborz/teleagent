#!/usr/local/libexec/teleagent-node
'use strict';

const crypto = require('node:crypto');
const fs = require('node:fs');
const path = require('node:path');
const { spawnSync } = require('node:child_process');

const MANIFEST = '/usr/local/libexec/teleagent-provider-cli.manifest.json';
const CHECKER = '/usr/local/libexec/teleagent-provider-cli-check';
const SYSTEMCTL = '/usr/bin/systemctl';
const TARGET_ROOT = '/opt/teleagent/agent-tools';

class ProviderCliInstallRefusal extends Error {}

function fail(message) {
  throw new ProviderCliInstallRefusal(message);
}

function run(filename, args, { allowFailure = false } = {}) {
  const result = spawnSync(filename, args, {
    cwd: '/',
    encoding: 'utf8',
    timeout: 10000,
    maxBuffer: 256 * 1024,
    env: { PATH: '/usr/sbin:/usr/bin:/sbin:/bin', LANG: 'C.UTF-8', LC_ALL: 'C.UTF-8' },
    stdio: ['ignore', 'pipe', 'pipe'],
  });
  if (result.error || (!allowFailure && result.status !== 0)) {
    fail('a fixed installation dependency rejected the operation');
  }
  return result;
}

function digest(filename) {
  const hash = crypto.createHash('sha256');
  const descriptor = fs.openSync(filename, fs.constants.O_RDONLY | (fs.constants.O_NOFOLLOW || 0));
  try {
    const buffer = Buffer.allocUnsafe(1024 * 1024);
    for (;;) {
      const count = fs.readSync(descriptor, buffer, 0, buffer.length, null);
      if (count === 0) break;
      hash.update(buffer.subarray(0, count));
    }
  } finally {
    fs.closeSync(descriptor);
  }
  return hash.digest('hex');
}

function readManifest() {
  const metadata = fs.lstatSync(MANIFEST);
  if (!metadata.isFile() || metadata.isSymbolicLink() || metadata.uid !== 0 ||
      metadata.gid !== 0 || (metadata.mode & 0o777) !== 0o444 || metadata.nlink !== 1) {
    fail('the installed CLI manifest is unsafe');
  }
  const manifest = JSON.parse(fs.readFileSync(MANIFEST, 'utf8'));
  if (manifest?.version !== 1 || !Array.isArray(manifest.artifacts) ||
      manifest.artifacts.length !== 3) fail('the installed CLI manifest is invalid');
  return manifest;
}

function requireQuiescentProviderPlane() {
  for (const provider of ['claude', 'codex']) {
    for (const suffix of ['service', 'socket']) {
      const unit = `teleagent-provider-supervisor@${provider}.${suffix}`;
      const active = run(SYSTEMCTL, ['show', unit, '--property=ActiveState', '--value']);
      if (active.stdout.trim() !== 'inactive') {
        fail('CLI installation requires exactly inactive provider supervisors');
      }
    }
  }
  const launches = run(SYSTEMCTL, [
    'list-units', '--all', '--plain', '--no-legend', 'teleagent-provider-launch-*.service',
  ]);
  if (launches.stdout.trim()) fail('CLI installation requires zero transient provider launches');
}

function inspectSourceDescriptor(metadata, artifact, expectedUid, expectedGid) {
  if (!metadata.isFile() || metadata.uid !== BigInt(expectedUid) ||
      metadata.gid !== BigInt(expectedGid) || (metadata.mode & 0o022n) !== 0n ||
      metadata.nlink !== 1n || metadata.size !== BigInt(artifact.size)) {
    fail('a CLI source descriptor is unsafe or unreviewed');
  }
}

function sameSourceSnapshot(before, after) {
  return before.dev === after.dev && before.ino === after.ino &&
    before.size === after.size && before.mode === after.mode &&
    before.uid === after.uid && before.gid === after.gid &&
    before.nlink === after.nlink && before.mtimeNs === after.mtimeNs &&
    before.ctimeNs === after.ctimeNs;
}

function writeAll(descriptor, buffer, length) {
  let offset = 0;
  while (offset < length) {
    offset += fs.writeSync(descriptor, buffer, offset, length - offset, null);
  }
}

function copySourceToStage(filename, staged, artifact, {
  expectedUid = 0,
  expectedGid = 0,
} = {}) {
  if (!path.isAbsolute(filename) || fs.realpathSync(filename) !== filename) {
    fail('CLI source must be one canonical absolute path');
  }
  const sourceDescriptor = fs.openSync(
    filename,
    fs.constants.O_RDONLY | (fs.constants.O_NOFOLLOW || 0)
  );
  let stagedDescriptor;
  try {
    const before = fs.fstatSync(sourceDescriptor, { bigint: true });
    inspectSourceDescriptor(before, artifact, expectedUid, expectedGid);
    stagedDescriptor = fs.openSync(
      staged,
      fs.constants.O_WRONLY | fs.constants.O_CREAT | fs.constants.O_EXCL |
        (fs.constants.O_NOFOLLOW || 0),
      0o600
    );
    const hash = crypto.createHash('sha256');
    const buffer = Buffer.allocUnsafe(1024 * 1024);
    let copied = 0;
    for (;;) {
      const count = fs.readSync(sourceDescriptor, buffer, 0, buffer.length, null);
      if (count === 0) break;
      writeAll(stagedDescriptor, buffer, count);
      hash.update(buffer.subarray(0, count));
      copied += count;
      if (copied > artifact.size) fail('a CLI source changed while it was staged');
    }
    const after = fs.fstatSync(sourceDescriptor, { bigint: true });
    if (!sameSourceSnapshot(before, after) || copied !== artifact.size ||
        hash.digest('hex') !== artifact.sha256) {
      fail('a CLI source changed while it was staged');
    }
    fs.fchownSync(stagedDescriptor, expectedUid, expectedGid);
    fs.fchmodSync(stagedDescriptor, 0o755);
    fs.fsyncSync(stagedDescriptor);
    const stagedMetadata = fs.fstatSync(stagedDescriptor, { bigint: true });
    if (!stagedMetadata.isFile() || stagedMetadata.uid !== BigInt(expectedUid) ||
        stagedMetadata.gid !== BigInt(expectedGid) ||
        (stagedMetadata.mode & 0o777n) !== 0o755n || stagedMetadata.nlink !== 1n ||
        stagedMetadata.size !== BigInt(artifact.size)) {
      fail('a staged CLI descriptor has unsafe metadata');
    }
  } finally {
    if (stagedDescriptor !== undefined) fs.closeSync(stagedDescriptor);
    fs.closeSync(sourceDescriptor);
  }
  const installedMetadata = fs.lstatSync(staged);
  if (!installedMetadata.isFile() || installedMetadata.isSymbolicLink() ||
      installedMetadata.uid !== expectedUid || installedMetadata.gid !== expectedGid ||
      (installedMetadata.mode & 0o777) !== 0o755 || installedMetadata.nlink !== 1 ||
      installedMetadata.size !== artifact.size || fs.realpathSync(staged) !== staged ||
      digest(staged) !== artifact.sha256) {
    fail('a staged CLI copy is unsafe or unreviewed');
  }
  return staged;
}

function assertTargetKnownOrAbsent(artifact) {
  let metadata;
  try { metadata = fs.lstatSync(artifact.path); }
  catch (error) {
    if (error?.code === 'ENOENT') return;
    throw error;
  }
  if (!metadata.isFile() || metadata.isSymbolicLink() || metadata.uid !== 0 ||
      metadata.gid !== 0 || (metadata.mode & 0o777) !== 0o755 || metadata.nlink !== 1 ||
      metadata.size !== artifact.size || fs.realpathSync(artifact.path) !== artifact.path ||
      digest(artifact.path) !== artifact.sha256) {
    fail('refusing to overwrite an unknown provider CLI target');
  }
}

function verifyVersion(filename, artifact) {
  const result = spawnSync(filename, artifact.versionArgs, {
    cwd: '/',
    encoding: 'utf8',
    timeout: 5000,
    maxBuffer: 4096,
    env: { PATH: '/usr/bin:/bin', LANG: 'C.UTF-8', LC_ALL: 'C.UTF-8' },
    stdio: ['ignore', 'pipe', 'pipe'],
  });
  if (result.error || result.status !== 0 || result.stdout.trim() !== artifact.versionStdout) {
    fail('a staged provider CLI version is unreviewed');
  }
}

function installArtifactsInPrivateStage(manifest, artifacts, sources, {
  targetRoot = TARGET_ROOT,
  expectedUid = 0,
  expectedGid = 0,
  copySource = copySourceToStage,
  versionCheck = verifyVersion,
} = {}) {
  const stage = fs.mkdtempSync(path.join(targetRoot, '.provider-cli-stage-'));
  try {
    const stageMetadata = fs.lstatSync(stage);
    if (!stageMetadata.isDirectory() || stageMetadata.isSymbolicLink() ||
        stageMetadata.uid !== expectedUid || stageMetadata.gid !== expectedGid ||
        (stageMetadata.mode & 0o777) !== 0o700 || fs.realpathSync(stage) !== stage) {
      fail('the private provider CLI stage is unsafe');
    }
    for (const artifact of manifest.artifacts) {
      const staged = path.join(stage, path.basename(artifact.path));
      copySource(sources[artifact.id], staged, artifact, { expectedUid, expectedGid });
      // Never execute the caller-selected pathname. Only the root-owned,
      // descriptor-copied, fsynced stage can supply executable review evidence.
      if (artifact.id !== 'codex-wrapper') versionCheck(staged, artifact);
    }
    // The wrapper is committed last, so no executable path can select a new
    // vendor until that vendor and the matching Claude artifact are durable.
    for (const id of ['codex-vendor', 'claude', 'codex-wrapper']) {
      const artifact = artifacts[id];
      fs.renameSync(path.join(stage, path.basename(artifact.path)), artifact.path);
      const descriptor = fs.openSync(artifact.path, fs.constants.O_RDONLY);
      try { fs.fsyncSync(descriptor); } finally { fs.closeSync(descriptor); }
    }
  } finally {
    // All refusal and unexpected-error paths unwind here. Internal validation
    // must never terminate the process before a potentially huge stage is gone.
    fs.rmSync(stage, { recursive: true, force: true });
  }
}

function install(claudeSource, codexVendorSource) {
  requireQuiescentProviderPlane();
  const manifest = readManifest();
  const artifacts = Object.fromEntries(manifest.artifacts.map((entry) => [entry.id, entry]));
  const sources = {
    claude: claudeSource,
    'codex-wrapper': artifacts['codex-wrapper'].source,
    'codex-vendor': codexVendorSource,
  };
  for (const artifact of manifest.artifacts) {
    assertTargetKnownOrAbsent(artifact);
  }
  const opt = fs.lstatSync('/opt');
  if (!opt.isDirectory() || opt.isSymbolicLink() || opt.uid !== 0 || opt.gid !== 0 ||
      (opt.mode & 0o022) !== 0 || fs.realpathSync('/opt') !== '/opt') {
    fail('the host /opt root is unsafe');
  }
  if (!fs.existsSync('/opt/teleagent')) {
    fs.mkdirSync('/opt/teleagent', { mode: 0o755 });
    fs.chownSync('/opt/teleagent', 0, 0);
  }
  const root = fs.lstatSync('/opt/teleagent');
  if (!root.isDirectory() || root.isSymbolicLink() || root.uid !== 0 || root.gid !== 0 ||
      (root.mode & 0o022) !== 0 || fs.realpathSync('/opt/teleagent') !== '/opt/teleagent') {
    fail('the Teleagent tool root is unsafe');
  }
  if (!fs.existsSync(TARGET_ROOT)) fs.mkdirSync(TARGET_ROOT, { mode: 0o755 });
  const targetRootMetadata = fs.lstatSync(TARGET_ROOT);
  if (!targetRootMetadata.isDirectory() || targetRootMetadata.isSymbolicLink() ||
      targetRootMetadata.uid !== 0 || targetRootMetadata.gid !== 0 ||
      (targetRootMetadata.mode & 0o777) !== 0o755 ||
      fs.realpathSync(TARGET_ROOT) !== TARGET_ROOT) fail('the provider CLI target root is unsafe');
  installArtifactsInPrivateStage(manifest, artifacts, sources);
  for (const provider of ['claude', 'codex']) {
    run(CHECKER, ['--provider', provider]);
  }
}

function main() {
  if (process.geteuid() !== 0 || process.execArgv.length !== 0 ||
      fs.realpathSync(process.argv[1] || '') !== '/usr/local/libexec/teleagent-provider-cli-install') {
    fail('use the fixed root CLI installer entrypoint');
  }
  if (process.argv.length === 3 && process.argv[2] === '--check') {
    for (const provider of ['claude', 'codex']) run(CHECKER, ['--provider', provider]);
    return;
  }
  if (process.argv.length === 7 && process.argv[2] === '--install' &&
      process.argv[3] === '--claude-source' && process.argv[5] === '--codex-vendor-source') {
    install(process.argv[4], process.argv[6]);
    return;
  }
  fail('usage: teleagent-provider-cli-install --check | --install --claude-source ABS --codex-vendor-source ABS');
}

if (require.main === module) {
  try {
    main();
  } catch (error) {
    const message = error instanceof ProviderCliInstallRefusal
      ? error.message
      : 'the provider CLI installation could not complete safely';
    process.stderr.write(`Provider CLI install refused: ${message}\n`);
    process.exitCode = 77;
  }
}

module.exports = {
  copySourceToStage,
  installArtifactsInPrivateStage,
  sameSourceSnapshot,
  verifyVersion,
};
