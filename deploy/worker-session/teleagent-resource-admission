#!/usr/local/libexec/teleagent-node
'use strict';

// Host-owned admission policy. This helper neither creates cgroups nor changes
// limits. Call it only while holding the root global provider-launch fence.
const fs = require('node:fs');
const path = require('node:path');
const crypto = require('node:crypto');
const { setTimeout: delay } = require('node:timers/promises');
const { spawn } = require('node:child_process');

const PROFILE = '/etc/teleagent/resource-admission.json';
const CGROUP_ROOT = '/sys/fs/cgroup';
const POOL = `${CGROUP_ROOT}/teleagent.slice`;
const RECOVERY = 'teleagent-recovery.slice';
const PROVIDER = 'teleagent-provider.slice';
const MODEL_MEMORY_MAX = 3n * 1024n ** 3n;
const MODEL_TASKS_MAX = 384n;
const MAX_BYTES = 16384;
const MAX_GROUPS = 256;
const MAX_GROUP_DEPTH = 16;
const MAX_DIRECTORY_ENTRIES = 512;
const MOUNTINFO = '/proc/self/mountinfo';
const TOPOLOGY_HELPER = '/usr/local/libexec/teleagent-resource-topology-watch';
const MAX_WATCH_FRAME = 128 * 1024;
const UINT64_MAX = (1n << 64n) - 1n;
const REQUIRED_CHILDREN = Object.freeze([
  'teleagent-agent-controller.service', 'teleagent-provider.slice',
  'teleagent-voice.slice', 'teleagent-worker-session.service',
]);

function refuse(code) {
  const error = new Error(`New provider work refused: ${code}`);
  error.code = code;
  error.exitCode = 75;
  throw error;
}

function exactKeys(value, keys) {
  if (!value || typeof value !== 'object' || Array.isArray(value) ||
      Object.keys(value).sort().join('\n') !== [...keys].sort().join('\n')) {
    refuse('RESOURCE_PROFILE_INVALID');
  }
}

function integer(value, code = 'RESOURCE_EVIDENCE_INVALID') {
  if (typeof value !== 'string' || !/^(?:0|[1-9][0-9]{0,19})$/u.test(value)) refuse(code);
  const number = BigInt(value);
  if (number > UINT64_MAX) refuse(code);
  return number;
}

function scalar(text) {
  if (typeof text !== 'string' || !text.endsWith('\n')) refuse('RESOURCE_EVIDENCE_INVALID');
  return integer(text.slice(0, -1));
}

function validateProfile(text) {
  let profile;
  try { profile = JSON.parse(text); } catch { refuse('RESOURCE_PROFILE_INVALID'); }
  // One canonical encoding rejects duplicate keys, trailing values and hidden
  // noncanonical number forms. No caller/environment-selected policy exists.
  if (`${JSON.stringify(profile)}\n` !== text) refuse('RESOURCE_PROFILE_INVALID');
  exactKeys(profile, [
    'schema', 'hostname', 'pool', 'normalChildren', 'recovery',
    'hostReserveBytes', 'launchMemoryHeadroomBytes', 'launchTasksHeadroom',
    'maxSomePressureBasisPoints', 'maxFullPressureBasisPoints',
  ]);
  if (profile.schema !== 'teleagent.resource-admission.v1' || profile.hostname !== 'hermes') {
    refuse('RESOURCE_PROFILE_INVALID');
  }
  exactKeys(profile.pool, ['memoryHighBytes', 'memoryMaxBytes', 'tasksMax',
    'cpuQuotaMicros', 'cpuPeriodMicros']);
  exactKeys(profile.recovery, ['memoryMaxBytes', 'tasksMax']);
  const numeric = (value) => integer(value, 'RESOURCE_PROFILE_INVALID');
  const pool = Object.fromEntries(Object.entries(profile.pool).map(([key, value]) => [key, numeric(value)]));
  const recovery = Object.fromEntries(Object.entries(profile.recovery).map(([key, value]) => [key, numeric(value)]));
  const hostReserve = numeric(profile.hostReserveBytes);
  const launchMemory = numeric(profile.launchMemoryHeadroomBytes);
  const launchTasks = numeric(profile.launchTasksHeadroom);
  if (Object.values(pool).some((value) => value === 0n) ||
      Object.values(recovery).some((value) => value === 0n) ||
      pool.memoryHighBytes >= pool.memoryMaxBytes ||
      pool.cpuPeriodMicros < 1000n || pool.cpuPeriodMicros > 1000000n ||
      launchMemory < MODEL_MEMORY_MAX || launchTasks < MODEL_TASKS_MAX ||
      hostReserve < recovery.memoryMaxBytes) refuse('RESOURCE_PROFILE_INVALID');
  const some = profile.maxSomePressureBasisPoints;
  const full = profile.maxFullPressureBasisPoints;
  if (![some, full].every((value) => Number.isSafeInteger(value) && value >= 0 && value < 10000) ||
      full > some) refuse('RESOURCE_PROFILE_INVALID');
  if (!Array.isArray(profile.normalChildren) || profile.normalChildren.length < 4 ||
      profile.normalChildren.length > 16) refuse('RESOURCE_PROFILE_INVALID');
  const children = new Map();
  let memorySum = recovery.memoryMaxBytes;
  let tasksSum = recovery.tasksMax;
  for (const child of profile.normalChildren) {
    exactKeys(child, ['name', 'memoryMaxBytes', 'tasksMax']);
    // A direct child slice has exactly one dash after teleagent; systemd puts
    // additional dash-separated slice components in deeper ancestors.
    if (typeof child.name !== 'string' || child.name === RECOVERY ||
        !/^(?:teleagent-[a-z0-9]+\.slice|teleagent-[a-z0-9-]+\.service)$/u.test(child.name) ||
        children.has(child.name)) refuse('RESOURCE_PROFILE_INVALID');
    const memory = numeric(child.memoryMaxBytes);
    const tasks = numeric(child.tasksMax);
    if (memory === 0n || tasks === 0n) refuse('RESOURCE_PROFILE_INVALID');
    children.set(child.name, { memory, tasks });
    memorySum += memory;
    tasksSum += tasks;
  }
  if (REQUIRED_CHILDREN.some((name) => !children.has(name)) ||
      memorySum > pool.memoryMaxBytes || tasksSum > pool.tasksMax ||
      children.get(PROVIDER).memory < launchMemory || children.get(PROVIDER).tasks < launchTasks) {
    refuse('RESOURCE_PROFILE_INVALID');
  }
  return { profile, pool, recovery, children, hostReserve, launchMemory, launchTasks,
    digest: crypto.createHash('sha256').update(text).digest('hex') };
}

function parsePressure(text) {
  if (typeof text !== 'string') refuse('RESOURCE_EVIDENCE_INVALID');
  const lines = text.split('\n');
  if (lines.length !== 3 || lines[2] !== '') refuse('RESOURCE_EVIDENCE_INVALID');
  const result = Object.fromEntries(['some', 'full'].map((kind, index) => {
    const match = lines[index].match(new RegExp(
      `^${kind} avg10=(0|[1-9][0-9]{0,2})\\.([0-9]{2}) avg60=(0|[1-9][0-9]{0,2})\\.([0-9]{2}) avg300=(0|[1-9][0-9]{0,2})\\.([0-9]{2}) total=(0|[1-9][0-9]{0,19})$`, 'u'
    ));
    if (!match) refuse('RESOURCE_EVIDENCE_INVALID');
    const averages = [1, 3, 5].map((offset) => Number(match[offset]) * 100 + Number(match[offset + 1]));
    if (averages.some((value) => value > 10000)) refuse('RESOURCE_EVIDENCE_INVALID');
    return [kind, { averages, total: integer(match[7]) }];
  }));
  if (result.full.total > result.some.total || result.full.averages.some((value, index) =>
    value > result.some.averages[index])) refuse('RESOURCE_EVIDENCE_INVALID');
  return result;
}

function parseEvents(text, required) {
  if (typeof text !== 'string' || !text.endsWith('\n')) refuse('RESOURCE_EVIDENCE_INVALID');
  const fields = new Map();
  for (const line of text.slice(0, -1).split('\n')) {
    const match = line.match(/^([a-z_]+) (0|[1-9][0-9]{0,19})$/u);
    if (!match || fields.has(match[1])) refuse('RESOURCE_EVIDENCE_INVALID');
    fields.set(match[1], integer(match[2]));
  }
  if (required.some((key) => !fields.has(key))) refuse('RESOURCE_EVIDENCE_INVALID');
  return fields;
}

function parseMeminfo(text) {
  if (typeof text !== 'string' || !text.endsWith('\n')) refuse('RESOURCE_EVIDENCE_INVALID');
  const fields = new Map();
  for (const line of text.slice(0, -1).split('\n')) {
    const match = line.match(/^([A-Za-z_()][A-Za-z_()0-9]*): +([0-9]+)( kB)?$/u);
    if (!match || fields.has(match[1])) refuse('RESOURCE_EVIDENCE_INVALID');
    fields.set(match[1], { value: integer(match[2]), unit: match[3] });
  }
  const total = fields.get('MemTotal');
  const available = fields.get('MemAvailable');
  if (!total || !available || total.unit !== ' kB' || available.unit !== ' kB' ||
      total.value === 0n || available.value > total.value) refuse('RESOURCE_EVIDENCE_INVALID');
  return { total: total.value * 1024n, available: available.value * 1024n };
}

function directoryMetadata(directory) {
  const metadata = fs.lstatSync(directory, { bigint: true });
  if (!metadata.isDirectory() || metadata.uid !== 0n || metadata.gid !== 0n ||
      (metadata.mode & 0o7022n) !== 0n || fs.realpathSync(directory) !== directory) {
    refuse('RESOURCE_BOUNDARY_UNSAFE');
  }
  return metadata;
}

function directoryIdentity(directory) {
  const metadata = directoryMetadata(directory);
  return `${metadata.dev}:${metadata.ino}`;
}

function boundedRootRead(filename) {
  const descriptor = fs.openSync(filename, fs.constants.O_RDONLY | fs.constants.O_NOFOLLOW | fs.constants.O_NONBLOCK);
  try {
    const metadata = fs.fstatSync(descriptor, { bigint: true });
    // The kernel exposes this one procfs file as 0666: writes install PSI
    // triggers on the writer's descriptor; they cannot rewrite the counters.
    // collectSnapshot verifies the procfs mount/ancestors before this read.
    const kernelPsiTrigger = filename === '/proc/pressure/memory' &&
      (metadata.mode & 0o7777n) === 0o666n;
    if (!metadata.isFile() || metadata.uid !== 0n || metadata.gid !== 0n ||
        ((metadata.mode & 0o7022n) !== 0n && !kernelPsiTrigger)) refuse('RESOURCE_BOUNDARY_UNSAFE');
    const maximum = filename === MOUNTINFO ? 128 * 1024 : MAX_BYTES;
    const buffer = Buffer.alloc(maximum + 1);
    let count = 0;
    for (;;) {
      const amount = fs.readSync(descriptor, buffer, count, buffer.length - count, null);
      count += amount;
      if (count > maximum) refuse('RESOURCE_EVIDENCE_INVALID');
      if (amount === 0) break;
    }
    const after = fs.fstatSync(descriptor, { bigint: true });
    if (metadata.dev !== after.dev || metadata.ino !== after.ino || metadata.mode !== after.mode ||
        metadata.uid !== after.uid || metadata.gid !== after.gid ||
        metadata.mtimeNs !== after.mtimeNs || metadata.ctimeNs !== after.ctimeNs) {
      refuse('RESOURCE_BOUNDARY_CHANGED');
    }
    const bytes = buffer.subarray(0, count);
    const text = bytes.toString('utf8');
    if (!Buffer.from(text).equals(bytes)) refuse('RESOURCE_EVIDENCE_INVALID');
    return text;
  } finally { fs.closeSync(descriptor); }
}

function readProductionProfile() {
  for (const directory of ['/etc', '/etc/teleagent']) directoryIdentity(directory);
  return boundedRootRead(PROFILE);
}

function parseCgroupMount(text, ownCgroup = null) {
  if (typeof text !== 'string' || !text.endsWith('\n')) refuse('RESOURCE_EVIDENCE_INVALID');
  if (ownCgroup !== null && (typeof ownCgroup !== 'string' ||
      !/^\/(?:[A-Za-z0-9_.:@-]+(?:\/[A-Za-z0-9_.:@-]+)*)?$/u.test(ownCgroup) ||
      ownCgroup.split('/').some((part) => part === '.' || part === '..'))) {
    refuse('RESOURCE_BOUNDARY_UNSAFE');
  }
  let selected;
  let rootFields;
  const descendants = [];
  for (const line of text.slice(0, -1).split('\n')) {
    const halves = line.split(' - ');
    const left = halves[0].split(' ');
    const right = halves[1]?.split(' ');
    if (halves.length !== 2 || left.length < 6 || right.length !== 3 ||
        !/^[1-9][0-9]*$/u.test(left[0]) || !/^[1-9][0-9]*$/u.test(left[1]) ||
        !/^[0-9]+:[0-9]+$/u.test(left[2])) refuse('RESOURCE_EVIDENCE_INVALID');
    if (left[4].startsWith(`${CGROUP_ROOT}/`)) {
      descendants.push({ line, left, right });
      continue;
    }
    if (left[4] !== CGROUP_ROOT) continue;
    if (selected || left[3] !== '/' || right[0] !== 'cgroup2') refuse('RESOURCE_BOUNDARY_UNSAFE');
    const flags = right[2].split(',');
    const supported = new Set(['rw', 'ro', 'nsdelegate', 'favordynmods', 'memory_localevents',
      'memory_recursiveprot', 'memory_hugetlb_accounting', 'pids_localevents']);
    const accessFlags = (options) => options.filter((flag) => flag === 'rw' || flag === 'ro').length;
    // ProtectControlGroups may expose a read-only full-root view. Observation
    // does not need write access and must not weaken that service sandbox.
    if (accessFlags(left[5].split(',')) !== 1 || accessFlags(flags) !== 1 ||
        new Set(flags).size !== flags.length || flags.some((flag) => !supported.has(flag))) {
      refuse('RESOURCE_MOUNT_UNSUPPORTED');
    }
    selected = { identity: line,
      memoryEvents: flags.includes('memory_localevents') ? 'local' : 'subtree',
      // Default PID event propagation differs between kernel generations.
      // Every group is sampled, so neither default is assumed to aggregate.
      tasksEvents: flags.includes('pids_localevents') ? 'local' : 'kernel-default' };
    rootFields = { left, right };
  }
  if (!selected) refuse('RESOURCE_BOUNDARY_UNSAFE');
  // systemd pressure monitoring binds the service's own memory.pressure file
  // over the read-only cgroup view. Admit only that same file on the same
  // cgroup2 superblock; other mounts could replace the observed evidence.
  if (descendants.length) {
    const pressureRoot = `${ownCgroup === '/' ? '' : ownCgroup}/memory.pressure`;
    if (ownCgroup === null || descendants.length !== 1 ||
        !rootFields.left[5].split(',').includes('ro')) refuse('RESOURCE_BOUNDARY_UNSAFE');
    const bind = descendants[0];
    const options = bind.left[5].split(',');
    if (bind.left[1] !== rootFields.left[0] || bind.left[2] !== rootFields.left[2] ||
        bind.left[3] !== pressureRoot || bind.left[4] !== `${CGROUP_ROOT}${pressureRoot}` ||
        bind.right.join(' ') !== rootFields.right.join(' ') ||
        new Set(options).size !== options.length ||
        !['rw', 'nosuid', 'nodev', 'noexec'].every((flag) => options.includes(flag)) ||
        options.some((flag) => !['rw', 'nosuid', 'nodev', 'noexec', 'relatime'].includes(flag))) {
      refuse('RESOURCE_BOUNDARY_UNSAFE');
    }
    selected.identity += `\n${bind.line}`;
  }
  return selected;
}

function readOwnCgroup() {
  const text = boundedRootRead('/proc/self/cgroup');
  const match = text.match(/^0::(\/[^\n]*)\n$/u);
  if (!match) refuse('RESOURCE_BOUNDARY_UNSAFE');
  return match[1];
}

function collectEventInventory(withCounters) {
  const inventory = new Map();
  const pending = [{ relative: '', depth: 0 }];
  let rootDevice;
  while (pending.length > 0) {
    if (inventory.size >= MAX_GROUPS) refuse('RESOURCE_INVENTORY_LIMIT');
    const { relative, depth } = pending.pop();
    if (depth > MAX_GROUP_DEPTH) refuse('RESOURCE_INVENTORY_LIMIT');
    const directory = relative ? path.join(POOL, relative) : POOL;
    const metadata = directoryMetadata(directory);
    rootDevice ??= metadata.dev;
    if (metadata.dev !== rootDevice) refuse('RESOURCE_BOUNDARY_UNSAFE');
    const identity = `${metadata.dev}:${metadata.ino}`;
    const generation = `${metadata.mtimeNs}:${metadata.ctimeNs}`;
    const children = [];
    const stream = fs.opendirSync(directory, { bufferSize: 16 });
    try {
      let count = 0;
      for (let entry = stream.readSync(); entry !== null; entry = stream.readSync()) {
        if (++count > MAX_DIRECTORY_ENTRIES) refuse('RESOURCE_INVENTORY_LIMIT');
        if (entry.isSymbolicLink()) refuse('RESOURCE_BOUNDARY_UNSAFE');
        if (!entry.isDirectory()) continue;
        if (!/^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,254}$/u.test(entry.name)) {
          refuse('RESOURCE_BOUNDARY_UNSAFE');
        }
        if (inventory.size + pending.length + children.length + 1 >= MAX_GROUPS) {
          refuse('RESOURCE_INVENTORY_LIMIT');
        }
        children.push(entry.name);
      }
    } finally { stream.closeSync(); }
    const read = (name) => boundedRootRead(path.join(directory, name));
    if (read('cgroup.type') !== 'domain\n') refuse('RESOURCE_EVIDENCE_INVALID');
    const record = { identity, generation, children: children.sort().join('\n') };
    if (withCounters) {
      record.memoryEvents = parseEvents(read('memory.events'), ['high', 'max', 'oom', 'oom_kill']);
      record.tasksEvents = parseEvents(read('pids.events'), ['max']);
    }
    const after = directoryMetadata(directory);
    if (identity !== `${after.dev}:${after.ino}` ||
        generation !== `${after.mtimeNs}:${after.ctimeNs}`) refuse('RESOURCE_BOUNDARY_CHANGED');
    inventory.set(relative, record);
    for (const child of children) pending.push({
      relative: relative ? `${relative}/${child}` : child, depth: depth + 1,
    });
  }
  return inventory;
}

function assertStableInventory(before, after) {
  if (before.size !== after.size || [...before].some(([name, first]) => {
    const second = after.get(name);
    return !second || first.identity !== second.identity ||
      first.generation !== second.generation || first.children !== second.children;
  })) refuse('RESOURCE_BOUNDARY_CHANGED');
}

async function beginTopologyObservation({ launch = spawn, fileSystem = fs } = {}) {
  for (const directory of ['/', '/usr', '/usr/local', '/usr/local/libexec']) {
    const metadata = fileSystem.lstatSync(directory);
    if (!metadata.isDirectory() || metadata.uid !== 0 || metadata.gid !== 0 ||
        (metadata.mode & 0o7022) !== 0 || fileSystem.realpathSync(directory) !== directory) {
      refuse('RESOURCE_TOPOLOGY_HELPER_UNSAFE');
    }
  }
  const metadata = fileSystem.lstatSync(TOPOLOGY_HELPER);
  if (!metadata.isFile() || metadata.uid !== 0 || metadata.gid !== 0 || metadata.nlink !== 1 ||
      (metadata.mode & 0o7777) !== 0o555 || fileSystem.realpathSync(TOPOLOGY_HELPER) !== TOPOLOGY_HELPER) {
    refuse('RESOURCE_TOPOLOGY_HELPER_UNSAFE');
  }
  const child = launch('/usr/bin/python3', ['-I', TOPOLOGY_HELPER], {
    cwd: '/', env: { LANG: 'C.UTF-8', LC_ALL: 'C.UTF-8' }, stdio: ['pipe', 'pipe', 'ignore'],
  });
  let phase = 'starting';
  let failure;
  let closed = false;
  let ready;
  let nonce;
  let receipt = false;
  let buffer = Buffer.alloc(0);
  let outputBytes = 0;
  let resolveReady;
  let rejectReady;
  let resolveCheck;
  let rejectCheck;
  let resolveClosed;
  const readyPromise = new Promise((resolve, reject) => { resolveReady = resolve; rejectReady = reject; });
  const closedPromise = new Promise((resolve) => { resolveClosed = resolve; });
  const fail = () => {
    if (!failure) {
      try { refuse('RESOURCE_TOPOLOGY_UNCONFIRMED'); } catch (error) { failure = error; }
    }
    rejectReady(failure);
    rejectCheck?.(failure);
    if (!closed) child.kill('SIGKILL');
  };
  const deadline = setTimeout(fail, 2500);
  const cleanup = async () => {
    clearTimeout(deadline);
    phase = 'closing';
    child.stdin.destroy();
    if (!closed) child.kill('SIGKILL');
    let timer;
    await Promise.race([closedPromise, new Promise((resolve) => { timer = setTimeout(resolve, 500); })]);
    clearTimeout(timer);
    if (!closed) refuse('RESOURCE_TOPOLOGY_CLEANUP_UNCONFIRMED');
  };
  child.on('error', fail);
  child.stdin.on('error', fail);
  child.stdout.on('error', fail);
  child.stdout.on('data', (chunk) => {
    if (phase === 'closing' || failure) return;
    try {
      outputBytes += chunk.length;
      if (outputBytes > MAX_WATCH_FRAME + 80) throw new Error();
      buffer = Buffer.concat([buffer, chunk]);
      let end;
      while ((end = buffer.indexOf(10)) !== -1) {
        const bytes = buffer.subarray(0, end);
        const line = bytes.toString('utf8');
        buffer = buffer.subarray(end + 1);
        if (!Buffer.from(line).equals(bytes)) throw new Error();
        if (phase === 'starting') {
          ready = JSON.parse(line);
          exactKeys(ready, ['schema', 'boot', 'groups']);
          if (JSON.stringify(ready) !== line || ready.schema !== 'teleagent.resource-topology-watch.v1' ||
              !/^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}\n$/u.test(ready.boot) ||
              !Array.isArray(ready.groups) || ready.groups.length < 1 || ready.groups.length > MAX_GROUPS) {
            throw new Error();
          }
          const names = new Set();
          const identities = new Set();
          for (const group of ready.groups) {
            if (!Array.isArray(group) || group.length !== 3 || typeof group[0] !== 'string' ||
                group[0].length > 1024 || (group[0] !== '' &&
                  !/^[A-Za-z0-9][A-Za-z0-9_.:@-]*(?:\/[A-Za-z0-9][A-Za-z0-9_.:@-]*)*$/u.test(group[0]))) {
              throw new Error();
            }
            integer(group[1]); integer(group[2]);
            const identity = `${group[1]}:${group[2]}`;
            if (names.has(group[0]) || identities.has(identity)) throw new Error();
            names.add(group[0]); identities.add(identity);
          }
          if (!names.has('')) throw new Error();
          phase = 'ready';
          resolveReady();
        } else if (phase === 'checking' && !receipt && line === `CHECKED ${nonce}`) {
          receipt = true;
        } else throw new Error();
      }
    } catch { fail(); }
  });
  child.on('close', (code, signal) => {
    closed = true;
    resolveClosed();
    if (phase === 'closing') return;
    if (phase === 'checking' && receipt && code === 0 && signal === null && buffer.length === 0 && !failure) {
      clearTimeout(deadline);
      phase = 'finished';
      resolveCheck();
    } else fail();
  });
  try { await readyPromise; } catch (error) { await cleanup(); throw error; }
  return {
    assertSnapshot(snapshot) {
      if (failure || closed || phase !== 'ready' || snapshot.boot !== ready.boot ||
          snapshot.eventInventory.size !== ready.groups.length || ready.groups.some(([name, device, inode]) =>
        snapshot.eventInventory.get(name)?.identity !== `${device}:${inode}`)) {
        refuse('RESOURCE_TOPOLOGY_UNCONFIRMED');
      }
    },
    async finish() {
      if (failure || closed || phase !== 'ready') refuse('RESOURCE_TOPOLOGY_UNCONFIRMED');
      phase = 'checking';
      nonce = crypto.randomBytes(32).toString('hex');
      const checked = new Promise((resolve, reject) => { resolveCheck = resolve; rejectCheck = reject; });
      try { child.stdin.write(`CHECK ${nonce}\n`); } catch { fail(); }
      await checked;
    },
    cleanup,
  };
}

function collectSnapshot(policy) {
  if (process.getuid() !== 0 || process.geteuid() !== 0) refuse('RESOURCE_BOUNDARY_UNSAFE');
  if (fs.statfsSync(CGROUP_ROOT, { bigint: true }).type !== 0x63677270n ||
      fs.readlinkSync('/proc/self/ns/cgroup') !== fs.readlinkSync('/proc/1/ns/cgroup')) {
    refuse('RESOURCE_BOUNDARY_UNSAFE');
  }
  for (const directory of ['/sys', '/sys/fs', CGROUP_ROOT]) directoryIdentity(directory);
  for (const directory of ['/proc', '/proc/pressure']) directoryIdentity(directory);
  if (fs.statfsSync('/proc/pressure/memory', { bigint: true }).type !== 0x9fa0n ||
      fs.statfsSync(MOUNTINFO, { bigint: true }).type !== 0x9fa0n ||
      fs.realpathSync('/proc/pressure/memory') !== '/proc/pressure/memory') {
    refuse('RESOURCE_BOUNDARY_UNSAFE');
  }
  const ownCgroup = readOwnCgroup();
  const mount = parseCgroupMount(boundedRootRead(MOUNTINFO), ownCgroup);
  const boot = boundedRootRead('/proc/sys/kernel/random/boot_id');
  if (!/^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}\n$/u.test(boot) ||
      boundedRootRead('/proc/sys/kernel/hostname') !== `${policy.profile.hostname}\n`) {
    refuse('RESOURCE_HOST_MISMATCH');
  }
  const eventInventory = collectEventInventory(true);
  const poolIdentity = eventInventory.get('').identity;
  const expected = [...policy.children.keys(), RECOVERY].sort();
  if (eventInventory.get('').children !== expected.join('\n')) {
    refuse('RESOURCE_POOL_TOPOLOGY_MISMATCH');
  }
  const readGroup = (directory) => {
    const identity = directoryIdentity(directory);
    const read = (name) => boundedRootRead(path.join(directory, name));
    if (read('cgroup.type') !== 'domain\n') refuse('RESOURCE_EVIDENCE_INVALID');
    const result = {
      identity, memory: scalar(read('memory.current')), high: scalar(read('memory.high')),
      max: scalar(read('memory.max')), swap: scalar(read('memory.swap.current')),
      swapMax: scalar(read('memory.swap.max')), tasks: scalar(read('pids.current')),
      tasksMax: scalar(read('pids.max')),
      pressure: parsePressure(read('memory.pressure')),
    };
    if (identity !== directoryIdentity(directory)) refuse('RESOURCE_BOUNDARY_CHANGED');
    return result;
  };
  // Child MemoryHigh can legitimately be unbounded. Only the commissioned
  // pool's admission threshold is authoritative, so normalize it separately.
  const children = new Map();
  for (const name of expected) {
    const directory = path.join(POOL, name);
    const identity = directoryIdentity(directory);
    if (identity !== eventInventory.get(name)?.identity) refuse('RESOURCE_BOUNDARY_CHANGED');
    const read = (field) => boundedRootRead(path.join(directory, field));
    if (read('cgroup.type') !== 'domain\n') refuse('RESOURCE_EVIDENCE_INVALID');
    children.set(name, { identity, memory: scalar(read('memory.current')), max: scalar(read('memory.max')),
      swap: scalar(read('memory.swap.current')), swapMax: scalar(read('memory.swap.max')),
      tasks: scalar(read('pids.current')), tasksMax: scalar(read('pids.max')) });
    if (identity !== directoryIdentity(directory)) refuse('RESOURCE_BOUNDARY_CHANGED');
  }
  const pool = readGroup(POOL);
  const cpu = boundedRootRead(path.join(POOL, 'cpu.max'));
  if (cpu !== `${policy.pool.cpuQuotaMicros} ${policy.pool.cpuPeriodMicros}\n` ||
      boundedRootRead(path.join(POOL, 'cgroup.procs')) !== '' ||
      poolIdentity !== directoryIdentity(POOL)) refuse('RESOURCE_POOL_TOPOLOGY_MISMATCH');
  const meminfo = parseMeminfo(boundedRootRead('/proc/meminfo'));
  const hostPressure = parsePressure(boundedRootRead('/proc/pressure/memory'));
  assertStableInventory(eventInventory, collectEventInventory(false));
  if (readOwnCgroup() !== ownCgroup ||
      parseCgroupMount(boundedRootRead(MOUNTINFO), ownCgroup).identity !== mount.identity) {
    refuse('RESOURCE_BOUNDARY_CHANGED');
  }
  return { boot, pool, children, meminfo, hostPressure, mount, eventInventory };
}

function assessSnapshot(policy, sample) {
  const pool = sample.pool;
  if (pool.high !== policy.pool.memoryHighBytes || pool.max !== policy.pool.memoryMaxBytes ||
      pool.tasksMax !== policy.pool.tasksMax || pool.swapMax !== 0n || pool.swap !== 0n) {
    refuse('RESOURCE_POOL_LIMIT_MISMATCH');
  }
  for (const [name, limits] of [...policy.children, [RECOVERY,
    { memory: policy.recovery.memoryMaxBytes, tasks: policy.recovery.tasksMax }]]) {
    const child = sample.children.get(name);
    if (!child || child.max !== limits.memory || child.tasksMax !== limits.tasks ||
        child.swapMax !== 0n || child.swap !== 0n) refuse('RESOURCE_CHILD_LIMIT_MISMATCH');
  }
  const provider = sample.children.get(PROVIDER);
  if (sample.meminfo.total < policy.pool.memoryMaxBytes + policy.hostReserve ||
      sample.meminfo.available < policy.launchMemory + policy.hostReserve) refuse('RESOURCE_HOST_HEADROOM');
  if (pool.memory + policy.launchMemory > pool.high ||
      pool.memory + policy.launchMemory + policy.recovery.memoryMaxBytes > pool.max ||
      pool.tasks + policy.launchTasks + policy.recovery.tasksMax > pool.tasksMax ||
      provider.memory + policy.launchMemory > provider.max ||
      provider.tasks + policy.launchTasks > provider.tasksMax) refuse('RESOURCE_POOL_HEADROOM');
  for (const pressure of [sample.hostPressure, pool.pressure]) {
    for (const [kind, threshold] of [['some', policy.profile.maxSomePressureBasisPoints],
      ['full', policy.profile.maxFullPressureBasisPoints]]) {
      if (pressure[kind].averages.some((average) => average > threshold)) refuse('RESOURCE_MEMORY_PRESSURE');
    }
  }
}

function assessInterval(policy, before, after, elapsedNs) {
  if (elapsedNs < 200000000n || elapsedNs > 2000000000n || before.boot !== after.boot ||
      before.pool.identity !== after.pool.identity ||
      before.mount.identity !== after.mount.identity ||
      [...before.children].some(([name, value]) => value.identity !== after.children.get(name)?.identity)) {
    refuse('RESOURCE_BOUNDARY_CHANGED');
  }
  assertStableInventory(before.eventInventory, after.eventInventory);
  for (const [group, record] of before.eventInventory) {
    for (const events of ['memoryEvents', 'tasksEvents']) {
      const first = record[events];
      const second = after.eventInventory.get(group)[events];
      if (first.size !== second.size || [...first].some(([name, value]) => second.get(name) !== value)) {
        refuse('RESOURCE_RECENT_LIMIT_EVENT');
      }
    }
  }
  for (const pair of [[before.hostPressure, after.hostPressure], [before.pool.pressure, after.pool.pressure]]) {
    for (const [kind, threshold] of [['some', policy.profile.maxSomePressureBasisPoints],
      ['full', policy.profile.maxFullPressureBasisPoints]]) {
      const delta = pair[1][kind].total - pair[0][kind].total;
      if (delta < 0n || delta * 1000n * 10000n > elapsedNs * BigInt(threshold)) {
        refuse('RESOURCE_MEMORY_PRESSURE');
      }
    }
  }
}

async function assertResourceAdmission({
  readProfile = readProductionProfile, snapshot = collectSnapshot,
  sleep = delay, monotonic = () => process.hrtime.bigint(),
  watchTopology = beginTopologyObservation,
} = {}) {
  let watcher;
  try {
    const text = readProfile();
    const policy = validateProfile(text);
    const collectionStarted = monotonic();
    watcher = await watchTopology();
    const before = snapshot(policy);
    watcher.assertSnapshot(before);
    // Use only the wait between snapshots as the pressure denominator. Every
    // counter's actual observation interval contains that wait, so slow
    // evidence reads cannot dilute stalls. The ratio is conservative.
    const started = monotonic();
    assessSnapshot(policy, before);
    await sleep(250);
    const observationEnded = monotonic();
    const after = snapshot(policy);
    watcher.assertSnapshot(after);
    assessSnapshot(policy, after);
    assessInterval(policy, before, after, observationEnded - started);
    if (readProfile() !== text) refuse('RESOURCE_BOUNDARY_CHANGED');
    await watcher.finish();
    const finished = monotonic();
    if (finished - collectionStarted > 2000000000n || started < collectionStarted ||
        observationEnded > finished) refuse('RESOURCE_BOUNDARY_CHANGED');
    return Object.freeze({ admitted: true, profileSha256: policy.digest, globallyAdmittedJobs: 1 });
  } catch (error) {
    if (error?.code?.startsWith('RESOURCE_')) throw error;
    // Never expose paths, kernel diagnostics or an accidental upstream error.
    refuse('RESOURCE_EVIDENCE_UNAVAILABLE');
  } finally {
    if (watcher) await watcher.cleanup();
  }
}

module.exports = { assertResourceAdmission, validateProfile, parsePressure, parseEvents,
  parseMeminfo, parseCgroupMount, assessSnapshot, assessInterval, collectSnapshot, readProductionProfile,
  beginTopologyObservation,
  MODEL_MEMORY_MAX, MODEL_TASKS_MAX };
