#!/usr/local/libexec/teleagent-node
'use strict';

const crypto = require('node:crypto');
const fs = require('node:fs');

const MANIFEST = '/usr/local/libexec/teleagent-provider-cli.manifest.json';
const PROVIDERS = new Set(['claude', 'codex']);
const TARGET_ROOT = '/opt/teleagent/agent-tools';
const PRIVATE_STAGE_PREFIX = '.provider-cli-stage-';

class ProviderCliCheckRefusal extends Error {}

function fail(message) {
  throw new ProviderCliCheckRefusal(message);
}

function exactKeys(value, expected) {
  return value && typeof value === 'object' && !Array.isArray(value) &&
    Object.keys(value).sort().join('\n') === [...expected].sort().join('\n');
}

async function digestFile(filename) {
  const hash = crypto.createHash('sha256');
  const stream = fs.createReadStream(filename, {
    flags: fs.constants.O_RDONLY,
    highWaterMark: 1024 * 1024,
  });
  for await (const chunk of stream) hash.update(chunk);
  return hash.digest('hex');
}

function readManifest() {
  const metadata = fs.lstatSync(MANIFEST);
  if (!metadata.isFile() || metadata.isSymbolicLink() || metadata.uid !== 0 ||
      metadata.gid !== 0 || (metadata.mode & 0o777) !== 0o444 || metadata.nlink !== 1 ||
      metadata.size > 32768 || fs.realpathSync(MANIFEST) !== MANIFEST) {
    fail('the root-owned CLI manifest is unsafe');
  }
  let manifest;
  try { manifest = JSON.parse(fs.readFileSync(MANIFEST, 'utf8')); }
  catch { fail('the CLI manifest is invalid JSON'); }
  if (!exactKeys(manifest, ['version', 'artifacts']) || manifest.version !== 1 ||
      !Array.isArray(manifest.artifacts) || manifest.artifacts.length !== 3) {
    fail('the CLI manifest schema is invalid');
  }
  const ids = new Set();
  for (const artifact of manifest.artifacts) {
    if (!exactKeys(artifact, [
      'id', 'provider', 'path', 'source', 'sha256', 'size', 'mode',
      'versionArgs', 'versionStdout',
    ]) || ids.has(artifact.id) || !PROVIDERS.has(artifact.provider) ||
        !/^[-a-z]+$/.test(artifact.id) ||
        !artifact.path.startsWith('/opt/teleagent/agent-tools/') ||
        artifact.path.includes('/../') || artifact.mode !== '0755' ||
        !/^[a-f0-9]{64}$/.test(artifact.sha256) ||
        !Number.isSafeInteger(artifact.size) || artifact.size <= 0 ||
        !Array.isArray(artifact.versionArgs) || artifact.versionArgs.length !== 1 ||
        artifact.versionArgs[0] !== '--version' ||
        !/^(?:2\.1\.246 \(Claude Code\)|codex-cli 0\.149\.1)$/.test(artifact.versionStdout)) {
      fail('the CLI manifest artifact schema is invalid');
    }
    ids.add(artifact.id);
  }
  if (ids.size !== 3 || !ids.has('claude') || !ids.has('codex-wrapper') ||
      !ids.has('codex-vendor')) fail('the CLI manifest artifact set is incomplete');
  return manifest;
}

function assertNoPrivateStages(targetRoot = TARGET_ROOT, {
  readDirectory = fs.readdirSync,
} = {}) {
  const entries = readDirectory(targetRoot);
  if (entries.some((entry) => entry.startsWith(PRIVATE_STAGE_PREFIX))) {
    fail('an interrupted provider CLI stage requires operator review');
  }
}

async function checkArtifact(artifact, { expectedUid = 0, expectedGid = 0 } = {}) {
  const metadata = fs.lstatSync(artifact.path);
  if (!metadata.isFile() || metadata.isSymbolicLink() || metadata.uid !== expectedUid ||
      metadata.gid !== expectedGid || (metadata.mode & 0o777) !== 0o755 || metadata.nlink !== 1 ||
      metadata.size !== artifact.size || fs.realpathSync(artifact.path) !== artifact.path) {
    fail('a pinned provider CLI artifact has unsafe metadata');
  }
  if (await digestFile(artifact.path) !== artifact.sha256) {
    fail('a pinned provider CLI artifact digest drifted');
  }
}

async function main() {
  if (process.geteuid() !== 0 || process.execArgv.length !== 0 ||
      fs.realpathSync(process.argv[1] || '') !== '/usr/local/libexec/teleagent-provider-cli-check' ||
      process.argv.length !== 4 || process.argv[2] !== '--provider' ||
      !PROVIDERS.has(process.argv[3])) fail('use the fixed root CLI checker entrypoint');
  const provider = process.argv[3];
  const manifest = readManifest();
  assertNoPrivateStages();
  for (const artifact of manifest.artifacts.filter((entry) => entry.provider === provider)) {
    await checkArtifact(artifact);
  }
  assertNoPrivateStages();
  process.stdout.write(`PROVIDER_CLI_OK ${provider}\n`);
}

if (require.main === module) {
  main().catch((error) => {
    const message = error instanceof ProviderCliCheckRefusal
      ? error.message
      : 'the pinned provider CLI could not be verified';
    process.stderr.write(`Provider CLI check refused: ${message}\n`);
    process.exitCode = 77;
  });
}

module.exports = {
  assertNoPrivateStages,
  checkArtifact,
  digestFile,
};
