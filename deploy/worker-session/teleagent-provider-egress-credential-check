#!/usr/local/libexec/teleagent-node
'use strict';

const fs = require('node:fs');
const path = require('node:path');
const {
  providerCredentialsEqual,
  validateProviderCredential,
} = require('/opt/teleagent/current/lib/provider-secret');

const PROVIDERS = new Set(['claude', 'codex']);

function fail(message) {
  process.stderr.write(`Provider credential check refused: ${message}\n`);
  process.exit(77);
}

if (process.getuid() !== 0 || process.argv.length !== 3 || !PROVIDERS.has(process.argv[2])) {
  fail('root and one exact provider are required');
}
const provider = process.argv[2];
const directory = '/etc/teleagent/provider-egress-secrets';
const directoryMetadata = fs.lstatSync(directory);
if (!directoryMetadata.isDirectory() || directoryMetadata.isSymbolicLink() ||
    directoryMetadata.uid !== 0 || (directoryMetadata.mode & 0o077) !== 0 ||
    fs.realpathSync(directory) !== directory) {
  fail('credential directory ownership, mode, or path is unsafe');
}

const credentials = {};
try {
  for (const name of PROVIDERS) {
    const filename = path.join(directory, `${name}.api-key`);
    const metadata = fs.lstatSync(filename);
    if (!metadata.isFile() || metadata.isSymbolicLink() || metadata.uid !== 0 ||
        (metadata.mode & 0o177) !== 0 || metadata.size < 32 || metadata.size > 4096 ||
        fs.realpathSync(filename) !== filename) {
      fail('credential ownership, mode, size, or path is unsafe');
    }
    credentials[name] = validateProviderCredential(fs.readFileSync(filename));
  }
  if (providerCredentialsEqual(credentials.claude, credentials.codex)) {
    fail('provider credentials must be distinct');
  }
} catch {
  fail('provider credential content is invalid');
}

// Values are held only for this root-only preflight and are never printed.
// systemd LoadCredential separately copies the selected value into a
// service-private, read-only tmpfs for the matching provider egress identity.
