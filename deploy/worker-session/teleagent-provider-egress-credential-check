#!/usr/local/libexec/teleagent-node
'use strict';

const fs = require('node:fs');
const crypto = require('node:crypto');
const path = require('node:path');

const PROVIDERS = new Set(['claude', 'codex']);
const MIN_PROVIDER_CREDENTIAL_BYTES = 32;
const MAX_PROVIDER_CREDENTIAL_BYTES = 4096;
const PLACEHOLDER = /(?:placeholder|example|change[-_ ]?me|replace[-_ ]?with|insert[-_ ]?(?:key|token)|your[-_ ]?(?:api[-_ ]?)?(?:key|token))/i;
const IMMUTABLE_RELEASE_ROOT = /^\/opt\/teleagent\/releases\/sha256-[a-f0-9]{64}$/;
const IMMUTABLE_PREFLIGHT_RELATIVE =
  'deploy/worker-session/teleagent-provider-egress-credential-check';
const HANDOFF_LOCK = '/run/teleagent-staging-handoff.lock';
const LIFECYCLE_LOCK_ENV = 'TELEAGENT_HANDOFF_LIFECYCLE_LOCK_FD';
const PROJECTED_CREDENTIAL_FD_ENV = 'TELEAGENT_PREFLIGHT_PROVIDER_CREDENTIAL_FD';

// This root preflight runs only through the fixed host verifier, using the
// approved release's bundled Node and immutable helper while retaining the
// shared handoff lock for the helper's complete lifetime.
function isRepeatedPattern(value) {
  const limit = Math.min(16, Math.floor(value.length / 2));
  for (let width = 1; width <= limit; width += 1) {
    if (value.length % width !== 0) continue;
    const pattern = value.slice(0, width);
    if (pattern.repeat(value.length / width) === value) return true;
  }
  return false;
}

function validateProviderCredential(input) {
  const value = Buffer.isBuffer(input) ? input.toString('utf8') : String(input ?? '');
  const bytes = Buffer.byteLength(value, 'utf8');
  if (bytes < MIN_PROVIDER_CREDENTIAL_BYTES || bytes > MAX_PROVIDER_CREDENTIAL_BYTES ||
      value.length !== bytes || !/^[\x21-\x7e]+$/.test(value) || PLACEHOLDER.test(value) ||
      new Set(value).size < 8 || isRepeatedPattern(value)) {
    throw new Error('Provider credential is invalid.');
  }
  return value;
}

function providerCredentialsEqual(left, right) {
  const leftDigest = crypto.createHash('sha256')
    .update(validateProviderCredential(left), 'utf8').digest();
  const rightDigest = crypto.createHash('sha256')
    .update(validateProviderCredential(right), 'utf8').digest();
  return crypto.timingSafeEqual(leftDigest, rightDigest);
}

function refuse(message) {
  const error = new Error(message);
  error.exitCode = 77;
  throw error;
}

function hasProjectedCredentialMode(metadata) {
  const mode = metadata.mode & 0o7777;
  // The infrastructure verifier checks the exact one-service read ACL before
  // passing this descriptor. systemd's ACL mask appears as group-read here.
  return mode === 0o400 || (mode === 0o440 && metadata.uid === 0 && metadata.gid === 0);
}

function requireImmutablePreflight({
  environment = process.env,
  filesystem = fs,
  executable = process.execPath,
  invokedScript = process.argv[1],
  execArguments = process.execArgv,
  uid = process.geteuid(),
} = {}) {
  const releaseRoot = environment.TELEAGENT_RELEASE_ROOT;
  const descriptorValue = environment[LIFECYCLE_LOCK_ENV];
  const credentialDescriptorValue = environment[PROJECTED_CREDENTIAL_FD_ENV];
  if (uid !== 0 || !IMMUTABLE_RELEASE_ROOT.test(releaseRoot || '') ||
      !/^(?:[3-9]|[1-9][0-9]+)$/.test(descriptorValue || '') ||
      !/^(?:[3-9]|[1-9][0-9]+)$/.test(credentialDescriptorValue || '') ||
      !Array.isArray(execArguments) || execArguments.length !== 0) {
    refuse('the provider credential preflight requires one gated immutable release and retained lock');
  }
  const descriptor = Number.parseInt(descriptorValue, 10);
  const credentialDescriptor = Number.parseInt(credentialDescriptorValue, 10);
  if (!Number.isSafeInteger(descriptor) || descriptor > 1_000_000 ||
      !Number.isSafeInteger(credentialDescriptor) || credentialDescriptor > 1_000_000 ||
      credentialDescriptor === descriptor) {
    refuse('the provider credential preflight lock descriptor is invalid');
  }
  const expectedNode = `${releaseRoot}/runtime/node/bin/node`;
  const expectedScript = `${releaseRoot}/${IMMUTABLE_PREFLIGHT_RELATIVE}`;
  let descriptorMetadata;
  let credentialMetadata;
  let pathMetadata;
  try {
    if (filesystem.realpathSync(executable) !== expectedNode ||
        filesystem.realpathSync(invokedScript || '') !== expectedScript) {
      refuse('the provider credential preflight escaped the immutable release');
    }
    descriptorMetadata = filesystem.fstatSync(descriptor);
    credentialMetadata = filesystem.fstatSync(credentialDescriptor);
    pathMetadata = filesystem.lstatSync(HANDOFF_LOCK);
  } catch (error) {
    if (error?.exitCode === 77) throw error;
    refuse('the provider credential preflight executable or retained lock is unavailable');
  }
  if (!descriptorMetadata.isDirectory() || !pathMetadata.isDirectory() ||
      descriptorMetadata.dev !== pathMetadata.dev || descriptorMetadata.ino !== pathMetadata.ino ||
      pathMetadata.uid !== 0 || pathMetadata.gid !== 0 ||
      (pathMetadata.mode & 0o7777) !== 0o700) {
    refuse('the provider credential preflight lock identity is unsafe');
  }
  if (!credentialMetadata.isFile() || credentialMetadata.isSymbolicLink?.() ||
      credentialMetadata.nlink !== 1 ||
      !hasProjectedCredentialMode(credentialMetadata) ||
      credentialMetadata.size < MIN_PROVIDER_CREDENTIAL_BYTES ||
      credentialMetadata.size > MAX_PROVIDER_CREDENTIAL_BYTES) {
    refuse('the projected provider credential descriptor is unsafe');
  }
  delete environment[LIFECYCLE_LOCK_ENV];
  delete environment[PROJECTED_CREDENTIAL_FD_ENV];
  return Object.freeze({
    lockDescriptor: descriptor,
    credentialDescriptor,
  });
}

function readStableProjectedCredential(descriptor, filesystem = fs) {
  const before = filesystem.fstatSync(descriptor);
  const value = filesystem.readFileSync(descriptor);
  const after = filesystem.fstatSync(descriptor);
  const fields = [
    'dev', 'ino', 'mode', 'uid', 'gid', 'nlink', 'size',
    'mtimeMs', 'ctimeMs',
  ];
  if (!before.isFile() || before.isSymbolicLink?.() || before.nlink !== 1 ||
      !hasProjectedCredentialMode(before) ||
      before.size < MIN_PROVIDER_CREDENTIAL_BYTES ||
      before.size > MAX_PROVIDER_CREDENTIAL_BYTES ||
      fields.some((field) => before[field] !== after[field])) {
    refuse('the projected provider credential changed or has unsafe metadata');
  }
  return validateProviderCredential(value);
}

function readStableLiveCredential(filename, filesystem = fs) {
  let descriptor;
  try {
    const noFollow = filesystem.constants?.O_NOFOLLOW ?? fs.constants.O_NOFOLLOW;
    if (!Number.isInteger(noFollow)) {
      refuse('provider credential no-follow access is unavailable');
    }
    descriptor = filesystem.openSync(
      filename,
      fs.constants.O_RDONLY | noFollow,
    );
    const before = filesystem.fstatSync(descriptor);
    const value = filesystem.readFileSync(descriptor);
    const after = filesystem.fstatSync(descriptor);
    const fields = [
      'dev', 'ino', 'mode', 'uid', 'gid', 'nlink', 'size',
      'mtimeMs', 'ctimeMs',
    ];
    if (!before.isFile() || before.isSymbolicLink?.() ||
        before.uid !== 0 || before.gid !== 0 || before.nlink !== 1 ||
        (before.mode & 0o177) !== 0 ||
        before.size < MIN_PROVIDER_CREDENTIAL_BYTES ||
        before.size > MAX_PROVIDER_CREDENTIAL_BYTES ||
        fields.some((field) => before[field] !== after[field])) {
      refuse('provider credential ownership, mode, size, or identity is unsafe');
    }
    return validateProviderCredential(value);
  } catch (error) {
    if (error?.exitCode === 77) throw error;
    refuse('provider credential is absent, unreadable, or invalid');
  } finally {
    if (descriptor !== undefined) filesystem.closeSync(descriptor);
  }
}

function validateCredentialSnapshot(provider, projected, liveCredentials) {
  if (!PROVIDERS.has(provider)) refuse('the projected provider identity is invalid');
  const selected = validateProviderCredential(projected);
  const claude = validateProviderCredential(liveCredentials?.claude);
  const codex = validateProviderCredential(liveCredentials?.codex);
  if (providerCredentialsEqual(claude, codex)) {
    refuse('provider credentials must be distinct');
  }
  if (!providerCredentialsEqual(selected, liveCredentials[provider])) {
    refuse('the projected provider credential differs from the live selected credential');
  }
}

function main({
  filesystem = fs,
  environment = process.env,
  uid = process.getuid(),
  argv = process.argv,
  requirePreflight = requireImmutablePreflight,
} = {}) {
  const { credentialDescriptor } = requirePreflight({
    environment,
    filesystem,
  });
  if (uid !== 0 || argv.length !== 3 || !PROVIDERS.has(argv[2])) {
    refuse('root and one exact provider are required');
  }
  const provider = argv[2];
  const directory = '/etc/teleagent/provider-egress-secrets';
  const directoryMetadata = filesystem.lstatSync(directory);
  if (!directoryMetadata.isDirectory() || directoryMetadata.isSymbolicLink() ||
      directoryMetadata.uid !== 0 || directoryMetadata.gid !== 0 ||
      (directoryMetadata.mode & 0o077) !== 0 ||
      filesystem.realpathSync(directory) !== directory) {
    refuse('credential directory ownership, mode, or path is unsafe');
  }

  const credentials = {};
  try {
    const projectedCredential = readStableProjectedCredential(
      credentialDescriptor,
      filesystem,
    );
    for (const name of PROVIDERS) {
      const filename = path.join(directory, `${name}.api-key`);
      credentials[name] = readStableLiveCredential(filename, filesystem);
    }
    validateCredentialSnapshot(provider, projectedCredential, credentials);
  } catch (error) {
    if (error?.exitCode === 77) throw error;
    refuse('provider credential content is invalid');
  }
}

if (require.main === module) {
  try {
    main();
  } catch (error) {
    process.stderr.write(`Provider credential check refused: ${error.message}\n`);
    process.exitCode = error.exitCode || 77;
  }
}

// Values are held only for this root-only preflight and are never printed.
// systemd LoadCredential separately copies the selected value into a
// service-private, read-only tmpfs for the matching provider egress identity.

module.exports = {
  main,
  providerCredentialsEqual,
  readStableLiveCredential,
  readStableProjectedCredential,
  requireImmutablePreflight,
  validateCredentialSnapshot,
  validateProviderCredential,
};
