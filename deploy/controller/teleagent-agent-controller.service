[Unit]
Description=Teleagent private durable agent controller
Documentation=file:/opt/teleagent/current/docs/CONTROLLER-DEPLOYMENT.md
Requires=teleagent-worker-session.service teleagent-provider-model-apparmor.service teleagent-provider-supervisor@claude.socket teleagent-provider-supervisor@codex.socket
After=local-fs.target network-online.target teleagent-worker-session.service teleagent-provider-model-apparmor.service teleagent-provider-supervisor@claude.socket teleagent-provider-supervisor@codex.socket
Wants=network-online.target
ConditionPathExists=/etc/teleagent/controller/ENABLE
ConditionPathExists=/etc/teleagent/worker-session/ENABLE
ConditionPathIsMountPoint=/var/lib/teleagent-control

[Service]
Type=simple
User=teleagent-control
Group=teleagent-control
UMask=0077
WorkingDirectory=/opt/teleagent/current
EnvironmentFile=/etc/teleagent/controller/runtime.env
Environment=HOME=/var/lib/teleagent-control
Environment=PATH=/opt/teleagent/agent-tools:/usr/bin:/bin
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=PORT=3333
Environment=AGENT_API_BIND_HOST=127.0.0.1
Environment=AGENT_API_NON_LOOPBACK_ENABLED=false
Environment=TELEAGENT_CONTROLLER_STATE_BOUNDARY=required
Environment=EXECUTOR_TASK_DB_PATH=/var/lib/teleagent-control/executor-tasks.sqlite
Environment=VOICE_EXECUTION_LOCK_FILE=/var/lib/teleagent-control/voice-execution.lock.json
UnsetEnvironment=LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT GCONV_PATH NODE_OPTIONS NODE_PATH NODE_EXTRA_CA_CERTS NODE_TLS_REJECT_UNAUTHORIZED NODE_USE_ENV_PROXY SSLKEYLOGFILE SSL_CERT_FILE SSL_CERT_DIR HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY http_proxy https_proxy all_proxy no_proxy OPENAI_API_KEY ANTHROPIC_API_KEY CLAUDE_API_KEY CLAUDE_API_TOKEN CODEX_API_KEY API_KEY API_TOKEN AUTH_TOKEN ACCESS_TOKEN PROVIDER_TOKEN PROVIDER_SECRET
ExecStart=/opt/teleagent/node/bin/node /opt/teleagent/current/claude-api-server/server.js
Restart=on-failure
RestartSec=2s
KillMode=control-group
TimeoutStopSec=30s
OOMPolicy=kill

CPUAccounting=yes
CPUQuota=200%
CPUWeight=50
MemoryAccounting=yes
MemoryHigh=2G
MemoryMax=3G
MemorySwapMax=0
TasksAccounting=yes
TasksMax=512
IOAccounting=yes
IOWeight=50
LimitNOFILE=4096
LimitFSIZE=8589934592
LimitCORE=0

NoNewPrivileges=yes
AmbientCapabilities=
CapabilityBoundingSet=
PrivateDevices=yes
PrivateIPC=yes
PrivateTmp=yes
KeyringMode=private
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
SystemCallArchitectures=native
ReadOnlyPaths=/opt/teleagent/current /opt/teleagent/node /opt/teleagent/agent-tools /usr/local/libexec /etc/teleagent/controller
ReadWritePaths=/var/lib/teleagent-control
InaccessiblePaths=/opt/teleagent/current/.env /opt/teleagent/current/voice-app/.env /var/lib/teleagent-worker-state /var/lib/teleagent-privileged-action /var/lib/teleagent-voice /var/lib/teleagent-voice-stack /srv/teleagent-agent-workspaces /etc/teleagent-voice /etc/teleagent/privileged-action /etc/teleagent/provider-egress-secrets /run/teleagent-provider-egress /run/teleagent-provider-egress-control /run/teleagent-voice-stack

# Deliberately dormant: no [Install] section. A root operator must provision the
# dedicated state filesystem, exact runtime environment, both ENABLE sentinels,
# and worker/provider boundaries before starting this unit explicitly.
