  fi
  [ "$(/usr/bin/stat -c '%s' "$database")" -eq 0 ] ||
    fail 'a fresh privileged database was modified during initialization'
  create_exact_initial_file \
    "$marker" "$expected_uid" "$expected_gid" 0400 "$privileged_initial_marker"
  assert_privileged_state_marker
  assert_exact_database "$database" "$expected_uid" "$expected_gid"
