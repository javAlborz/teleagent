      "${expected_uid}:${expected_gid}:700" ] ||
    fail 'the privileged state mount metadata is unsafe'
  filesystem=$(/usr/bin/stat -f -c '%t' "$root")
  if [ "$test_state_mount" != 1 ]; then
    case "$filesystem" in ef53|58465342|9123683e|f2f52010|2fc12fc1) ;;
      *) fail 'the privileged state filesystem type is unreviewed' ;;
    esac
  fi
  if [ -n "$test_state_capacity" ]; then
    capacity=$test_state_capacity
    free=$test_state_free
  else
    local accounting block_size blocks available
    accounting=$(/usr/bin/stat -f -c '%S:%b:%a' "$root")
    block_size=${accounting%%:*}
    accounting=${accounting#*:}
    blocks=${accounting%%:*}
    available=${accounting##*:}
    case "$block_size:$blocks:$available" in
