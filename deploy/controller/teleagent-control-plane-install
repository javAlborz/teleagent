install_disabled() {
  require_install_authority
  source_check
  assert_dormant pre
  prepare_target_directories

  install_staging=$(/usr/bin/mktemp -d \
    "$(host_path /run)/teleagent-control-plane-install.XXXXXX")
  /usr/bin/chmod 0700 "$install_staging"
  install_committed=0
  install_complete=0
  local index target temporary

  rollback() {
    local status=$?
    local rollback_index rollback_target
    trap - EXIT INT TERM
    set +e
    for ((rollback_index = 0; rollback_index < ${#targets[@]}; rollback_index += 1)); do
      rollback_target=$(host_path "${targets[$rollback_index]}")
      /usr/bin/rm -f -- \
        "${rollback_target}.new-$$" "${rollback_target}.rollback-$$"
    done
    if [ "$install_complete" -ne 1 ] && [ "$install_committed" -eq 1 ]; then
      for ((rollback_index = ${#targets[@]} - 1; rollback_index >= 0; rollback_index -= 1)); do
        rollback_target=$(host_path "${targets[$rollback_index]}")
        if [ -f "$install_staging/backup-$rollback_index" ]; then
          /usr/bin/install -o "$expected_uid" -g "$expected_gid" \
            -m "${modes[$rollback_index]}" -- \
            "$install_staging/backup-$rollback_index" "${rollback_target}.rollback-$$"
          /usr/bin/mv -f -- "${rollback_target}.rollback-$$" "$rollback_target"
        else
          /usr/bin/rm -f -- "$rollback_target"
        fi
        /usr/bin/sync -- "$(/usr/bin/dirname -- "$rollback_target")"
      done
      run_systemctl daemon-reload >/dev/null 2>&1
    fi
    /usr/bin/rm -rf -- "$install_staging"
    exit "$status"
  }
  trap rollback EXIT INT TERM

  for ((index = 0; index < ${#sources[@]}; index += 1)); do
    target=$(host_path "${targets[$index]}")
    temporary="${target}.new-$$"
    [ ! -e "$temporary" ] && [ ! -L "$temporary" ] ||
      fail 'an installation staging path already exists'
    if [ -e "$target" ] || [ -L "$target" ]; then
      assert_target_file "$target" "${modes[$index]}"
      /usr/bin/cp --preserve=mode,ownership,timestamps -- \
        "$target" "$install_staging/backup-$index"
    fi
    /usr/bin/install -o "$expected_uid" -g "$expected_gid" \
      -m "${modes[$index]}" -- "$app_root/${sources[$index]}" "$temporary"
    /usr/bin/sync -- "$temporary"
  done

  install_committed=1
  for ((index = 0; index < ${#targets[@]}; index += 1)); do
    target=$(host_path "${targets[$index]}")
    /usr/bin/mv -f -- "${target}.new-$$" "$target"
    /usr/bin/sync -- "$(/usr/bin/dirname -- "$target")"
  done

  "$sysusers_bin" "$(host_path /etc/sysusers.d/teleagent-privileged-action.conf)"
  verify_controller_identity
  "$tmpfiles_bin" --create "$(host_path /etc/tmpfiles.d/teleagent-agent-controller.conf)"
  "$tmpfiles_bin" --create "$(host_path /etc/tmpfiles.d/teleagent-privileged-action.conf)"
  assert_distinct_state_mount_devices
  ensure_controller_state_initialized 1
  ensure_privileged_state_initialized 1
  run_systemctl daemon-reload
  assert_dormant installed
  check_installed_assets
  install_complete=1
  /usr/bin/rm -rf -- "$install_staging"
  trap - EXIT INT TERM
}

check_installed() {
  require_install_authority
  source_check
  assert_dormant installed
  check_installed_assets
  verify_controller_identity
  assert_distinct_state_mount_devices
  ensure_controller_state_initialized 0
  ensure_privileged_state_initialized 0
}

case "$requested_action" in
  --source-check)
    [ "$#" -eq 1 ] || fail 'unexpected arguments'
    source_check
    printf 'TELEAGENT_CONTROL_PLANE_SOURCE_OK\n'
    ;;
  --install-disabled)
    [ "$#" -eq 1 ] || fail 'unexpected arguments'
    require_immutable_mutation_entrypoint
    install_disabled
    printf 'TELEAGENT_CONTROL_PLANE_INSTALLED_DISABLED\n'
    ;;
  --check)
    [ "$#" -eq 1 ] || fail 'unexpected arguments'
    check_installed
    printf 'TELEAGENT_CONTROL_PLANE_INSTALLED_DISABLED_OK\n'
    ;;
  *)
    fail 'usage: teleagent-control-plane-install --source-check|--install-disabled|--check'
    ;;
esac
