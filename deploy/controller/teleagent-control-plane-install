assert_exact_database() {
  local filename=$1
  local uid=$2
  local gid=$3
  [ -f "$filename" ] && [ ! -L "$filename" ] ||
    fail 'an initialized durable database is absent or unsafe'
  [ "$(/usr/bin/readlink -f -- "$filename")" = "$filename" ] ||
    fail 'an initialized durable database resolves through a link'
  [ "$(/usr/bin/stat -c '%u:%g:%a:%h' "$filename")" = \
    "${uid}:${gid}:600:1" ] ||
    fail 'an initialized durable database has unsafe metadata'
}

create_exact_initial_file() {
  local filename=$1
  local uid=$2
  local gid=$3
  local mode=$4
  local content=$5
  local temporary="${filename}.new-$$"
  [ ! -e "$filename" ] && [ ! -L "$filename" ] &&
    [ ! -e "$temporary" ] && [ ! -L "$temporary" ] ||
    fail 'a controller initialization target already exists'
  ( set -o noclobber; umask 077; /usr/bin/printf '%s\n' "$content" > "$temporary" ) ||
    fail 'a controller initialization file could not be staged'
  /usr/bin/chown "$expected_uid:$expected_gid" "$temporary"
  /usr/bin/chmod "$mode" "$temporary"
  /usr/bin/sync -- "$temporary"
  /usr/bin/ln -- "$temporary" "$filename" ||
    fail 'a controller initialization file raced with another publisher'
  /usr/bin/rm -f -- "$temporary"
  /usr/bin/chown "$uid:$gid" "$filename"
  /usr/bin/chmod "$mode" "$filename"
  /usr/bin/sync -- "$filename"
  /usr/bin/sync -- "$(/usr/bin/dirname -- "$filename")"
}

create_exact_empty_file() {
  local filename=$1
  local uid=$2
  local gid=$3
  local temporary="${filename}.new-$$"
  [ ! -e "$filename" ] && [ ! -L "$filename" ] &&
    [ ! -e "$temporary" ] && [ ! -L "$temporary" ] ||
    fail 'a durable database initialization target already exists'
  ( set -o noclobber; umask 077; : > "$temporary" ) ||
    fail 'a durable database initialization file could not be staged'
  /usr/bin/chown "$expected_uid:$expected_gid" "$temporary"
  /usr/bin/chmod 0600 "$temporary"
  /usr/bin/sync -- "$temporary"
  /usr/bin/ln -- "$temporary" "$filename" ||
    fail 'a durable database initialization raced with another publisher'
  /usr/bin/rm -f -- "$temporary"
  /usr/bin/chown "$uid:$gid" "$filename"
  /usr/bin/chmod 0600 "$filename"
  /usr/bin/sync -- "$filename"
  /usr/bin/sync -- "$(/usr/bin/dirname -- "$filename")"
}

ensure_controller_state_initialized() {
  local allow_initialize=${1:-0}
  local parent root marker parent_dev root_dev metadata filesystem capacity free reserve
  parent=$(host_path /var/lib)
  root=$(host_path "$controller_state_root")
  marker=$(host_path "$controller_state_marker")
  [ "$(/usr/bin/readlink -f -- "$parent")" = "$parent" ] &&
    [ "$(/usr/bin/stat -c '%u:%g:%a' "$parent")" = \
      "${expected_uid}:${expected_gid}:755" ] ||
    fail 'the controller state parent is unsafe'
  parent_dev=$(/usr/bin/stat -c '%d' "$parent")
  root_dev=$(/usr/bin/stat -c '%d' "$root")
  if [ "$root_dev" = "$parent_dev" ] && [ "$test_state_mount" != 1 ]; then
    fail 'the exact dedicated controller state mount is absent'
  fi
  [ "$(/usr/bin/readlink -f -- "$root")" = "$root" ] ||
    fail 'the controller state mount resolves through a link'
  metadata=$(/usr/bin/stat -c '%u:%g:%a' "$root")
  [ "$metadata" = "${controller_uid}:${controller_gid}:700" ] ||
    fail 'the controller state mount metadata is unsafe'
  filesystem=$(/usr/bin/stat -f -c '%t' "$root")
  if [ "$test_state_mount" != 1 ]; then
    case "$filesystem" in ef53|58465342|9123683e|f2f52010|2fc12fc1) ;;
      *) fail 'the controller state filesystem type is unreviewed' ;;
    esac
  fi
  if [ -n "$test_state_capacity" ]; then
    capacity=$test_state_capacity
    free=$test_state_free
  else
    local accounting block_size blocks available
    accounting=$(/usr/bin/stat -f -c '%S:%b:%a' "$root")
    block_size=${accounting%%:*}
    accounting=${accounting#*:}
    blocks=${accounting%%:*}
    available=${accounting##*:}
    case "$block_size:$blocks:$available" in
      ''|*[!0-9:]*|::*|*::) fail 'controller state accounting is invalid' ;;
    esac
    capacity=$((block_size * blocks))
    free=$((block_size * available))
  fi
  [ "$capacity" -ge $((2 * 1024 * 1024 * 1024)) ] &&
    [ "$capacity" -le $((8 * 1024 * 1024 * 1024)) ] ||
    fail 'controller state capacity is outside the reviewed 2-8 GiB boundary'
  reserve=$(((capacity + 4) / 5))
  [ "$reserve" -ge $((512 * 1024 * 1024)) ] || reserve=$((512 * 1024 * 1024))
  [ "$free" -ge "$reserve" ] || fail 'controller state free-space reserve is exhausted'

  if [ -e "$marker" ] || [ -L "$marker" ]; then
    assert_controller_state_marker
    assert_exact_controller_state_file
    assert_exact_database \
      "$(host_path "$controller_database")" "$controller_uid" "$controller_gid"
    return
  fi

  [ "$allow_initialize" = 1 ] ||
    fail 'a provisioned controller state mount has not been initialized by the installer'

  local state_file database initial_body other
  state_file=$(host_path "$controller_state_file")
  database=$(host_path "$controller_database")
  if [ -e "$state_file" ] || [ -L "$state_file" ]; then
    assert_exact_controller_state_file
    initial_body=$(/usr/bin/sed -n '1p' "$state_file")
    [ "$initial_body" = "$controller_initial_state" ] ||
      fail 'unmarked controller state is not the exact fresh initializer record'
    other=$(/usr/bin/find "$root" -mindepth 1 -maxdepth 1 \
      ! -path "$state_file" ! -path "$database" -print -quit)
    [ -z "$other" ] || fail 'unmarked controller state contains prior durable evidence'
    if [ -e "$database" ] || [ -L "$database" ]; then
      assert_exact_database "$database" "$controller_uid" "$controller_gid"
      [ "$(/usr/bin/stat -c '%s' "$database")" -eq 0 ] ||
        fail 'an unmarked controller database contains prior durable evidence'
    else
      create_exact_empty_file "$database" "$controller_uid" "$controller_gid"
    fi
  else
    other=$(/usr/bin/find "$root" -mindepth 1 -maxdepth 1 -print -quit)
    [ -z "$other" ] ||
      fail 'missing controller lock state is allowed only on an objectively empty fresh mount'
    create_exact_initial_file \
      "$state_file" "$controller_uid" "$controller_gid" 0600 "$controller_initial_state"
    create_exact_empty_file "$database" "$controller_uid" "$controller_gid"
    [ "$(/usr/bin/stat -c '%s' "$database")" -eq 0 ] ||
      fail 'a fresh controller database was modified during initialization'
    assert_exact_controller_state_file
  fi
  [ "$(/usr/bin/stat -c '%s' "$database")" -eq 0 ] ||
    fail 'a fresh controller database was modified during initialization'
  create_exact_initial_file \
    "$marker" "$expected_uid" "$expected_gid" 0400 "$controller_initial_marker"
  assert_controller_state_marker
  assert_exact_controller_state_file
  assert_exact_database "$database" "$controller_uid" "$controller_gid"
}

ensure_privileged_state_initialized() {
  local allow_initialize=${1:-0}
  local parent root marker parent_dev root_dev metadata filesystem capacity free reserve
  parent=$(host_path /var/lib)
