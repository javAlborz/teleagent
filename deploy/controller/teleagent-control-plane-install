verify_controller_identity() {
  local group_gid
  controller_uid=$("$id_bin" -u teleagent-control) ||
    fail 'the controller identity is absent'
  controller_gid=$("$id_bin" -g teleagent-control) ||
    fail 'the controller primary group is absent'
  case "$controller_uid:$controller_gid" in
    *[!0-9:]*|0:*|*:0|'') fail 'the controller numeric identity is unsafe' ;;
  esac
  group_gid=$("$getent_bin" group teleagent-control | /usr/bin/awk -F: \
    'NF == 4 && $1 == "teleagent-control" { print $3 }')
  [ "$group_gid" = "$controller_gid" ] ||
    fail 'the controller user and group identities diverged'
}

assert_distinct_state_mount_devices() {
  local root parent controller_root privileged_root parent_dev controller_dev privileged_dev
  parent=$(host_path /var/lib)
  controller_root=$(host_path "$controller_state_root")
  privileged_root=$(host_path "$privileged_state_root")
  for root in "$controller_root" "$privileged_root"; do
    [ -d "$root" ] && [ ! -L "$root" ] &&
      [ "$(/usr/bin/readlink -f -- "$root")" = "$root" ] ||
      fail 'a durable state mountpoint is absent, linked, or noncanonical'
  done
  if [ "$test_state_mount" = 1 ]; then
    controller_dev=$test_controller_state_device
    privileged_dev=$test_privileged_state_device
  else
    parent_dev=$(/usr/bin/stat -c '%d' "$parent")
    controller_dev=$(/usr/bin/stat -c '%d' "$controller_root")
    privileged_dev=$(/usr/bin/stat -c '%d' "$privileged_root")
    [ "$controller_dev" != "$parent_dev" ] ||
      fail 'the exact dedicated controller state mount is absent'
    [ "$privileged_dev" != "$parent_dev" ] ||
      fail 'the exact dedicated privileged state mount is absent'
  fi
  case "$controller_dev:$privileged_dev" in
    ''|*[!0-9:]*) fail 'durable state mount device identities are invalid' ;;
  esac
  [ "$controller_dev" != "$privileged_dev" ] ||
    fail 'controller and privileged state must use distinct dedicated filesystems'
}

assert_exact_controller_state_file() {
  local filename
  filename=$(host_path "$controller_state_file")
  [ -f "$filename" ] && [ ! -L "$filename" ] ||
    fail 'the explicit controller lock state is absent or unsafe'
  [ "$(/usr/bin/readlink -f -- "$filename")" = "$filename" ] ||
    fail 'the explicit controller lock state resolves through a link'
  [ "$(/usr/bin/stat -c '%u:%g:%a:%h' "$filename")" = \
    "${controller_uid}:${controller_gid}:600:1" ] ||
    fail 'the explicit controller lock state metadata is unsafe'
  [ "$(/usr/bin/stat -c '%s' "$filename")" -le 4096 ] &&
    [ "$(/usr/bin/wc -l < "$filename")" -eq 1 ] ||
    fail 'the explicit controller lock state size is unsafe'
  /usr/bin/grep -Eq \
    '^\{"version":1,"locked":false,"revision":[0-9]+,"updatedAt":"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]{3}Z","lockedAt":null,"unlockedAt":"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]{3}Z","reason":null,"source":"[A-Za-z0-9_.:-]+","remotePanicPending":false,"remotePanicConfirmedAt":null\}$' \
    "$filename" || /usr/bin/grep -Eq \
    '^\{"version":1,"locked":true,"revision":[0-9]+,"updatedAt":"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]{3}Z","lockedAt":"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]{3}Z","unlockedAt":null,"reason":"[A-Za-z0-9_.:-]+","source":"[A-Za-z0-9_.:-]+","remotePanicPending":(true,"remotePanicConfirmedAt":null|false,"remotePanicConfirmedAt":(null|"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]{3}Z"))\}$' \
    "$filename" || fail 'the explicit controller lock state schema is not exact canonical JSON'
  local transition="${filename}.transition"
  [ ! -e "$transition" ] && [ ! -L "$transition" ] ||
    fail 'a controller lock-state transition remains unresolved'
}

