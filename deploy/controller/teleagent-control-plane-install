  local database other
  database=$(host_path "$privileged_database")
  if [ -e "$marker" ] || [ -L "$marker" ]; then
    assert_privileged_state_marker
    assert_exact_database "$database" "$expected_uid" "$expected_gid"
    return
  fi
  [ "$allow_initialize" = 1 ] ||
    fail 'a provisioned privileged state mount has not been initialized by the installer'
  other=$(/usr/bin/find "$root" -mindepth 1 -maxdepth 1 ! -path "$database" -print -quit)
  [ -z "$other" ] || fail 'unmarked privileged state contains prior durable evidence'
  if [ -e "$database" ] || [ -L "$database" ]; then
