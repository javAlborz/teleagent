{
  "name": "claude-phone",
  "version": "1.0.0",
  "description": "Voice interface for Claude Code and OpenAI Codex over SIP",
  "private": true,
  "scripts": {
    "test": "npm run test:cli && npm run test:api-server && npm run test:voice-app && npm run test:privileged-action-broker && npm run test:realtime-sip-gateway && npm run test:evaluation",
    "test:cli": "cd cli && npm test",
    "test:api-server": "cd claude-api-server && node --test --test-concurrency=1 test/**/*.test.js",
    "test:voice-app": "cd voice-app && node --test --test-concurrency=1 test/**/*.test.js",
    "test:privileged-action-broker": "cd privileged-action-broker && node --test test/**/*.test.js",
    "test:realtime-sip-gateway": "cd realtime-sip-gateway && npm test",
    "test:evaluation": "node --test --test-concurrency=1 evaluation/hermes-preview/test/*.test.js",
    "voice-control": "node scripts/voice-execution-control.js",
    "outbound-recovery": "node scripts/resolve-outbound-recovery.js",
    "voice-history": "node scripts/voice-history.js",
    "lint": "eslint . && npm run lint:realtime-sip-gateway",
    "lint:fix": "eslint . --fix && npm run lint:realtime-sip-gateway -- --fix",
    "lint:voice-app": "eslint voice-app/",
    "lint:api-server": "eslint claude-api-server/",
    "lint:realtime-sip-gateway": "cd realtime-sip-gateway && npm run lint",
    "precommit": "npm run lint",
    "prepare": "husky"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "husky": "^9.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "author": "NetworkChuck",
  "license": "MIT"
}
